diff --git a/samples/application_development/fs_interrupt_test/include/interrupt_structures.h b/samples/application_development/fs_interrupt_test/include/interrupt_structures.h
new file mode 100644
index 0000000..7cb2d8b
--- /dev/null
+++ b/samples/application_development/fs_interrupt_test/include/interrupt_structures.h
@@ -0,0 +1,89 @@
+#define MAX_SIZE_NAME 20
+
+typedef enum {
+	INTR_MSG_REI_DERR,
+	INTR_MSG_REI_SERR,
+	INTR_MSG_SEI,
+	INTR_MSG_SPI_ECO,
+	INTR_MSG_DPI,
+	INTR_MSG_TS,
+	INTR_MSG_RESERVED,
+	INTR_MSG_MAX
+} intr_msg_type_t;
+
+typedef struct {
+	uint32_t address;
+	uint32_t value;
+} reg_info_t;
+
+typedef struct {
+	reg_info_t m2w;  /* Message to Wire register info */
+	reg_info_t w2m;  /* Wire to Message register info */
+	reg_info_t ip;   /* Interrupt Pending register info */
+} reg_clr_info_t; //intr_sts_info_t
+
+typedef struct {
+	reg_info_t inj;        /* Injection register data */
+	uint32_t timestamp;    /* Time of injection. After a certain timeout, debug registers will be read
+						   and the test will be marked as failed */
+} intr_inj_t;
+
+typedef struct {
+	uint32_t isr_hit_cnt;  /* Number of times an ISR is hit. This is to know if there was flooding */
+} intr_det_t;
+
+typedef struct {
+	uint32_t arc_index;    /* Architecture index */
+	uint32_t aggr_index;   /* Aggregator index */
+	intr_inj_t injection;  /* Injection information */
+	intr_det_t detection;  /* Detection information */
+	reg_clr_info_t debug_info; /* Debug information */
+} intr_info_t;
+
+typedef struct {
+	intr_info_t *intr_list;  /* List of interrupt information */
+	uint32_t intr_count;     /* Number of interrupts */
+	bool result;             /* Result of the interrupt message */
+} intr_msg_t;
+
+typedef enum {
+	COMPONENT_CPU = 0,
+	COMPONENT_D2D_MAC,
+	COMPONENT_D2D_PHY,
+	COMPONENT_DEC,
+	COMPONENT_DTSTDVM,
+	COMPONENT_ENC,
+	COMPONENT_MUC,
+	COMPONENT_NIC,
+	COMPONENT_NMS,
+	COMPONENT_NOC,
+	COMPONENT_PCIE,
+	COMPONENT_PLL,
+	COMPONENT_PMMU,
+	COMPONENT_PSOC,
+	COMPONENT_RESERVED,
+	COMPONENT_XHA,
+	COMPONENT_MAX,
+} component_id_t;
+
+typedef struct {
+	char component_name[MAX_SIZE_NAME];  /* Name of the component */
+	component_id_t component_id;         /* ID of the component */
+	intr_msg_t intr_msgs[INTR_MSG_MAX];  /* Interrupt messages for the component */
+	bool result;                         /* Result of the component */
+} component_t;
+
+typedef struct {
+	component_t components[COMPONENT_MAX];  /* List of components */
+	bool result;                            /* Result of the component list */
+} component_list_t;
+
+typedef enum {
+	SINGLE,    /* Single firing mode */
+	FULL_AUTO, /* Full automatic firing mode */
+} intr_firing_mode;
+
+typedef struct {
+	component_list_t component_list;  /* List of components with interrupt information */
+	intr_firing_mode firing_mode;     /* Firing mode of the interrupts */
+} sys_intr_info_t;
diff --git a/samples/application_development/fs_interrupt_test/src/main.c b/samples/application_development/fs_interrupt_test/src/main.c
new file mode 100644
index 0000000..f385993
--- /dev/null
+++ b/samples/application_development/fs_interrupt_test/src/main.c
@@ -0,0 +1,225 @@
+#include <zephyr.h>
+#include "cpu_intr_info.h"
+#include "interrupt_structure.h"
+
