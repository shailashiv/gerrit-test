From f1bfcffeff94d4a9ef1012becf6400811ded6a8e Mon Sep 17 00:00:00 2001
From: relhararx <relhararx@habana.ai>
Date: Fri, 29 Nov 2024 13:32:55 +0200
Subject: [PATCH] gathers all 4 HCON "Quarters" SPI DPI and VIRAL. Used only in "Central Quarter"

Change-Id: Ie280cb7c78904a82cd0b7cb30dba8b50c4425622
---

diff --git a/prototypes/hcon_central.xml b/prototypes/hcon_central.xml
new file mode 100644
index 0000000..40ca53f
--- /dev/null
+++ b/prototypes/hcon_central.xml
@@ -0,0 +1,85 @@
+<?xml version="1.0" encoding="ISO-8859-1"?>
+<BLOCK_DB>
+  <CONFIG ADD_QMAN_EXT_IF="" GEN_ZERO_REGS="" MEM_NUM="" OWNER="relhararx" PROTOTYPE_SIZE="4" PT_TYPE="UNIT" />
+  <DESCRIPTION>Gathers all 4 HCON &quot;quarters&quot; SPI, DPI &amp; VIRAL interrupts.
+Used only in the &quot;central quarter&quot; (EDGE_2 &amp; MID_0 in  HALF_TOP0).
+Also may use for future HCON registers</DESCRIPTION>
+  <INTERRUPT ADDR="100" INT_TYPE="SPI" NAME="SPI">
+    <CAUSE HW_VALID="Yes" INDEX="0" LKD="" NAME="HCON_QTR0" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=0 is MID_1 in HCON_MID_HALF_TOP_1.
+EDGE_ID=0 is EDGE_0.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="1" LKD="" NAME="HCON_QTR1" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=1 is MID_0 in HCON_MID_HALF_TOP_1.
+EDGE_ID=1 is EDGE_1.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="2" LKD="" NAME="HCON_QTR2" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=2 is MID_0 in HCON_MID_HALF_TOP_0 (&quot;Central&quot;).
+EDGE_ID=2 is EDGE_2 (&quot;Central&quot;).</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="3" LKD="" NAME="HCON_QTR3" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=3 is MID_1 in HCON_MID_HALF_TOP_0.
+EDGE_ID=3 is EDGE_3.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+  </INTERRUPT>
+  <INTERRUPT ADDR="200" INT_TYPE="DP" NAME="DPI">
+    <CAUSE HW_VALID="Yes" INDEX="0" LKD="" NAME="HCON_QTR0" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=0 is MID_1 in HCON_MID_HALF_TOP_1.
+EDGE_ID=0 is EDGE_0.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="1" LKD="" NAME="HCON_QTR1" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=1 is MID_0 in HCON_MID_HALF_TOP_1.
+EDGE_ID=1 is EDGE_1.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="2" LKD="" NAME="HCON_QTR2" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=2 is MID_0 in HCON_MID_HALF_TOP_0 (&quot;Central&quot;).
+EDGE_ID=2 is EDGE_2 (&quot;Central&quot;).</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="3" LKD="" NAME="HCON_QTR3" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=3 is MID_1 in HCON_MID_HALF_TOP_0.
+EDGE_ID=3 is EDGE_3.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+  </INTERRUPT>
+  <INTERRUPT ADDR="300" INT_TYPE="VIRAL" NAME="VIRAL">
+    <CAUSE HW_VALID="Yes" INDEX="0" LKD="" NAME="HCON_QTR0" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=0 is MID_1 in HCON_MID_HALF_TOP_1.
+EDGE_ID=0 is EDGE_0.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="1" LKD="" NAME="HCON_QTR1" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=1 is MID_0 in HCON_MID_HALF_TOP_1.
+EDGE_ID=1 is EDGE_1.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="2" LKD="" NAME="HCON_QTR2" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=2 is MID_0 in HCON_MID_HALF_TOP_0 (&quot;Central&quot;).
+EDGE_ID=2 is EDGE_2 (&quot;Central&quot;).</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+    <CAUSE HW_VALID="Yes" INDEX="3" LKD="" NAME="HCON_QTR3" RESET="No" SEVERITY="Error" SRC="" SW_VALID="Yes">
+      <DESCRIPTION>MID_ID=3 is MID_1 in HCON_MID_HALF_TOP_0.
+EDGE_ID=3 is EDGE_3.</DESCRIPTION>
+      <HANDLING></HANDLING>
+      <SOURCES></SOURCES>
+    </CAUSE>
+  </INTERRUPT>
+</BLOCK_DB>
