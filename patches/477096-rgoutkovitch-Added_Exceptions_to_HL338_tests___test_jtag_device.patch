                    hw_component=kwargs["HW_Component"], read_value=kwargs["read_value"], caller_order=5)
+
+
+def raise_soft_cpld_reset(**kwargs):
+    raise SoftCPLDReset(test_code=kwargs["test_code"], operation=kwargs["operation"],
+                        hw_component=kwargs["HW_Component"], caller_order=5)
