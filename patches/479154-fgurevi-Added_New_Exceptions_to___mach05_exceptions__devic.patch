+class GetNumDevices(Exception):
+    """Get Number Of Connected Devices"""
+
+    def __init__(self, test_code="", operation="", hw_component="", caller_order=2):
+        super(GetNumDevices, self).__init__()
+        self._caller_order = caller_order
+        self._test_code = test_code
+        self._operation = operation
+        self._hw_component = hw_component
+        self._file_name, self._caller_line, self._func_name = debuginfo(caller_order=self._caller_order)
+
+    def __str__(self):
+        error_options = get_cfg_option("errors_options")
+        details_msg = "Test Code: " + self._test_code
+        error_msg = (error_options.connections.connection_manager.get_num_devices + "\n" +
+                     self._operation)
+        msg = ("\nPath: " + self._file_name + ":" + self._func_name + ":" + str(self._caller_line)
+               + "\n" + details_msg
+               + "\n" + error_msg)
+        return msg
+
+
+def raise_get_num_devices(**kwargs):
+    raise GetNumDevices(test_code=kwargs["test_code"], operation=kwargs["operation"],
+                        hw_component=kwargs["HW_Component"], caller_order=5)
