+class CompareConnectedExpectedDevices(Exception):
+
+    def __init__(self, test_code="", operation="", hw_component="", read_value=None,
+                 expected_value=None, caller_order=2):
+        super(CompareConnectedExpectedDevices, self).__init__()
+        self._read_value = read_value
+        self._caller_order = caller_order
+        self._expected_value = expected_value
+        self._test_code = test_code
+        self._operation = operation
+        self._hw_component = hw_component
+        self._file_name, self._caller_line, self._func_name = debuginfo(caller_order=self._caller_order)
+
+    def __str__(self):
+        error_options = get_cfg_option("errors_options")
+        details_msg = ("Test Code: " + self._test_code
+                       + " Operation: " + self._operation)
+        if self._hw_component != "":
+            details_msg = details_msg + " HW Component: " + self._hw_component
+        error_msg = error_options.hw_manager.controls.device_cli.compare_connected_expected_devices
+        if self._read_value is not None:
+            error_msg = error_msg + "\nActual Value: " + str(self._read_value)
+        if self._expected_value is not None:
+            error_msg = error_msg + "\nExpected Value: " + str(self._expected_value)
+
+        msg = ("\nPath: " + self._file_name + ":" + self._func_name + ":" + str(self._caller_line)
+               + "\n" + details_msg
+               + "\n" + error_msg)
