+PROCEDURE FULL_FLASHB_PROGRAM USES VARIABLE_INIT_0, STATIC_VARIABLE;
+
+
+PRINT "Programming Flash CFG1";
+'Select CFG1
+'Shift in LSC_INIT_ADDRESS(0x46) instruction
+IRSCAN 8, $46;
+DRSCAN 16, $0002;
