+FUSEARRAY_TDO_CFG1_INDEX_0 = FUSEARRAY_TDO_CFG1_LENGTH_0 - FUSEARRAY_TDO_CFG1_PAD_0;
+FUSEARRAY_TDO_CFG1_0[(FUSEARRAY_TDO_CFG1_LENGTH_0 - 1)..0] = FUSEARRAY_TDI_CFG1_0[(FUSEARRAY_TDI_CFG1_LENGTH_0 - 1)..0];
+
+FOR REPEAT_INDEX_0 = 1 TO 12542;
+'Shift in LSC_PROG_INCR_NV(0x70) instruction
+IRSCAN 8, $70;
+'Shift in Data Row = 1
+FUSEARRAY_TDI_CFG1_INDEX_0 = FUSEARRAY_TDI_CFG1_LENGTH_0 - FUSEARRAY_TDI_CFG1_PAD_0 - ((FUSEARRAY_TDI_CFG1_PAD_0 + 128) * (RowCount_0_0 - 1) ) ;
+DRSCAN 128, FUSEARRAY_TDI_CFG1_0[(FUSEARRAY_TDI_CFG1_INDEX_0 - 1)..(FUSEARRAY_TDI_CFG1_INDEX_0 - 128)];
