+'Shift in LSC_CHECK_BUSY(0xF0) instruction
+IRSCAN 8, $F0;
+
+LATTICE_LOOP = 1;
+LOOP_MAX_0 = 10;
+FOR LOOP_INDEX_0 = 1 TO LOOP_MAX_0;
+LOOP_COUNT_0 = LOOP_INDEX_0;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+DRSCAN 1, $0, COMPARE $0, $1, LOOP_RESULT_0;
+IF (LOOP_RESULT_0) THEN LOOP_INDEX_0 = LOOP_MAX_0;
+NEXT LOOP_INDEX_0;
+IF (!LOOP_RESULT_0) THEN GOTO LOOP_FAILURE_0;
+IF (LOOP_COUNT_0 > 1) THEN PRINT "	 Number of Loops = ", LOOP_COUNT_0, "/",LOOP_MAX_0;
+LATTICE_LOOP = 0;
