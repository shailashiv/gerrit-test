+PROCEDURE DO_PROGRAM_0 USES VARIABLE_INIT_0, STATIC_VARIABLE;
+
+
+'PRINT "	 Initialize";
+
+'Row_Width	  :2376
+'Address_Length :888
+PREDR	1;
+PREIR	8;
+POSTDR	0;
+POSTIR	0;
+DRSTOP	DRPAUSE;
+IRSTOP	IRPAUSE;
+' FREQUENCY	1000000;
+STATE	IDLE;
+
+
+'PRINT "	 Check the IDCODE";
+
+'Shift in IDCODE_PUB(0xE0) instruction
+IRSCAN 8, $E0;
+DRSCAN 32, $00000000, COMPARE $212E3043, $FFFFFFFF, RESULT_0;
+IF (!RESULT_0) THEN GOTO FAIL_VERIFY_0;
+
+
+'PRINT "	 Enable the Flash Transparent mode";
+
+'Shift in LSC_ENABLE_X(0x74) instruction
+IRSCAN 8, $74;
+DRSCAN 8, $08;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+
+
+'PRINT "	 Check PASSWORD";
+
+'Start TRY statement
+'Shift in LSC_READ_STATUS0(0x3C) instruction
+IRSCAN 8, $3C;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+DRSCAN 32, $00000000, COMPARE $00000000, $00008000, TRY_RESULT_0;
+IF (!TRY_RESULT_0) THEN GOTO LABEL_JUMP_0_1;
+GOTO LABEL_JUMP_0_2;
+'End TRY statement
+
+'ELSE 
+LABEL_JUMP_0_1:
+'Shift in ISC DISABLE(0x26) instruction
+IRSCAN 8, $26;
+WAIT	IDLE,	2 CYCLES,	1000000  USEC;
+'Shift in BYPASS(0xFF) instruction
+IRSCAN 8, $FF;
+WAIT	IDLE,	2 CYCLES,	100000  USEC;
+PRINT "A Password Key is required. Please provide the Password Key.";
+GOTO FAIL_VERIFY_0;
+GOTO LABEL_JUMP_0_2;
+
+LABEL_JUMP_0_2:
+
+
+
+
+
+
+
+PRINT "Programming Flash CFG1";
+'Select CFG1
+'Shift in LSC_INIT_ADDRESS(0x46) instruction
+IRSCAN 8, $46;
+DRSCAN 16, $0002;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+'Check Erase LOCK information
+'Start TRY statement
+'Shift in LSC_READ_STATUS1(0x3D) instruction
+IRSCAN 8, $3D;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+DRSCAN 32, $00000000, COMPARE $00000000, $00000010, TRY_RESULT_0;
+IF (!TRY_RESULT_0) THEN GOTO LABEL_JUMP_0_3;
+GOTO LABEL_JUMP_0_4;
+'End TRY statement
+
+'ELSE 
+LABEL_JUMP_0_3:
+'Shift in ISC DISABLE(0x26) instruction
+IRSCAN 8, $26;
+WAIT	IDLE,	2 CYCLES,	10000  USEC;
+'Shift in BYPASS(0xFF) instruction
+IRSCAN 8, $FF;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+PRINT "Current Sector Erase Lock is set. Cannot continue.";
+GOTO FAIL_VERIFY_0;
+GOTO LABEL_JUMP_0_4;
+
+LABEL_JUMP_0_4:
+
+'Check Program LOCK information
+'Start TRY statement
+'Shift in LSC_READ_STATUS1(0x3D) instruction
+IRSCAN 8, $3D;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+DRSCAN 32, $00000000, COMPARE $00000000, $00000020, TRY_RESULT_0;
+IF (!TRY_RESULT_0) THEN GOTO LABEL_JUMP_0_5;
+GOTO LABEL_JUMP_0_6;
+'End TRY statement
+
+'ELSE 
+LABEL_JUMP_0_5:
+'Shift in ISC DISABLE(0x26) instruction
+IRSCAN 8, $26;
+WAIT	IDLE,	2 CYCLES,	10000  USEC;
+'Shift in BYPASS(0xFF) instruction
+IRSCAN 8, $FF;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+PRINT "Current Sector Program Lock is set. Cannot continue. Please do erase first.";
+GOTO FAIL_VERIFY_0;
+GOTO LABEL_JUMP_0_6;
+
+LABEL_JUMP_0_6:
+
+'Erase the CFG1
+'Shift in ISC ERASE(0x0E) instruction
+IRSCAN 8, $0E;
+DRSCAN 16, $0002;
+WAIT	IDLE,	2 CYCLES;
+'Shift in LSC_CHECK_BUSY(0xF0) instruction
+IRSCAN 8, $F0;
+
+LATTICE_LOOP = 1;
+LOOP_MAX_0 = 4500;
+FOR LOOP_INDEX_0 = 1 TO LOOP_MAX_0;
+LOOP_COUNT_0 = LOOP_INDEX_0;
+WAIT	IDLE,	2 CYCLES,	10000  USEC;
+DRSCAN 1, $0, COMPARE $0, $1, LOOP_RESULT_0;
+IF (LOOP_RESULT_0) THEN LOOP_INDEX_0 = LOOP_MAX_0;
+NEXT LOOP_INDEX_0;
+IF (!LOOP_RESULT_0) THEN GOTO LOOP_FAILURE_0;
+IF (LOOP_COUNT_0 > 1) THEN PRINT "	 Number of Loops = ", LOOP_COUNT_0, "/",LOOP_MAX_0;
+LATTICE_LOOP = 0;
+
+'Program CFG1
+INTEGER RowCount_0_0 = 1;
