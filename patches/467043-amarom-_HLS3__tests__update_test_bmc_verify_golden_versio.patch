+'Shift in LSC_READ_STATUS1(0x3D) instruction
+IRSCAN 8, $3D;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+DRSCAN 32, $00000000, COMPARE $00000000, $00000010, TRY_RESULT_0;
