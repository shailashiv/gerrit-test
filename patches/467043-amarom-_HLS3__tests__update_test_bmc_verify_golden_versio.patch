+'Shift in ISC DISABLE(0x26) instruction
+IRSCAN 8, $26;
+WAIT	IDLE,	2 CYCLES,	10000  USEC;
+'Shift in BYPASS(0xFF) instruction
+IRSCAN 8, $FF;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+PRINT "Current Sector Erase Lock is set. Cannot continue.";
+GOTO FAIL_VERIFY_0_6;
+GOTO LABEL_JUMP_0_4;
+
+LABEL_JUMP_0_4:
+
+'Check Program LOCK information
+'Start TRY statement
+'Shift in LSC_READ_STATUS1(0x3D) instruction
+IRSCAN 8, $3D;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+DRSCAN 32, $00000000, COMPARE $00000000, $00000020, TRY_RESULT_0;
+IF (!TRY_RESULT_0) THEN GOTO LABEL_JUMP_0_5;
+GOTO LABEL_JUMP_0_6;
+'End TRY statement
+
+'ELSE 
+LABEL_JUMP_0_5:
+'Shift in ISC DISABLE(0x26) instruction
+IRSCAN 8, $26;
+WAIT	IDLE,	2 CYCLES,	10000  USEC;
+'Shift in BYPASS(0xFF) instruction
+IRSCAN 8, $FF;
+WAIT	IDLE,	2 CYCLES,	1000  USEC;
+PRINT "Current Sector Program Lock is set. Cannot continue. Please do erase first.";
+GOTO FAIL_VERIFY_0_6;
+GOTO LABEL_JUMP_0_6;
+
+LABEL_JUMP_0_6:
+
+'Erase the CFG1
+'Shift in ISC ERASE(0x0E) instruction
+IRSCAN 8, $0E;
+DRSCAN 16, $0002;
+WAIT	IDLE,	2 CYCLES;
+'Shift in LSC_CHECK_BUSY(0xF0) instruction
+IRSCAN 8, $F0;
