From 77149598ed8613e8a303f4122cae338c6b1bb247 Mon Sep 17 00:00:00 2001
From: Varsha Maira <vmaira@habana.ai>
Date: Wed, 28 May 2025 11:04:23 +0300
Subject: [PATCH] [SW-230471] g3: mgmt: add secure prot bit config

Add header file for secure protection bits to enhance register access
control. Previously, privilege settings were configured to restrict
access from all non-privileged entities, including both secure and
user-level initiators.

This patch introduces secure protection settings that specifically
restrict access from user-level entities while continuing to allow
access from both privileged and secure initiators. This enables more
flexible configuration where registers can be protected from user
access but remain accessible to secure and privileged entities.

This patch also renames existing privilege protection bits header
file.

Change-Id: Ie369a5b50c6620ef6a85c75509af05b9a5a28bdd
Signed-off-by: Varsha Maira <vmaira@habana.ai>
---

diff --git a/drivers/misc/hl_security/common/security.c b/drivers/misc/hl_security/common/security.c
index 0a612d6..ee71eab 100644
--- a/drivers/misc/hl_security/common/security.c
+++ b/drivers/misc/hl_security/common/security.c
@@ -65,7 +65,7 @@
 static int hl_dev_init_prot_bits_block(const struct device *dev,
 				const struct hl_prot_bits_cfg *prot_bits_cfg, uint32_t index,
 				uint8_t major, uint8_t minor, uint8_t sub_minor,
-				enum hl_block_types block_type)
+				enum hl_block_types block_type, enum prot_bit_priv_level priv_level)
 {
 	const struct hl_prot_bits_cfg *cfg = &prot_bits_cfg[index];
 	uint8_t b_idx = 0, d_idx = 0;
@@ -75,7 +75,7 @@
 	bool skip;
 	struct hl_security_drv_data *data = DEV_DATA(dev);
 
-	addr = hl_secure_get_pb_base_addr(block_type, major, minor, sub_minor, cfg);
+	addr = hl_secure_get_pb_base_addr(block_type, major, minor, sub_minor, cfg, priv_level);
 	die_id = hl_get_die_id(addr);
 	/* Skip D1 configuration for single die SKU */
 	if (hl_dev_can_skip_die_id(die_id, data->sku))
@@ -132,7 +132,8 @@
 }
 
 int hl_dev_prot_bits_init(const struct device *dev, const struct hl_prot_bits_cfg *prot_bits_cfg,
-				enum hl_reset_src rst_reason, uint32_t conf_sz)
+				enum hl_reset_src rst_reason, uint32_t conf_sz,
+				enum prot_bit_priv_level priv_level)
 {
 	struct hl_security_drv_data *data = DEV_DATA(dev);
 	uint8_t major_idx, minor_idx, sub_minor_idx;
@@ -140,6 +141,16 @@
 	struct hl_prot_bits_addr block_addr;
 	int err;
 	static bool sec_dbg_initialized;
+
+#if !defined(CONFIG_SOC_HL_GAUDI3_MGMT)
+	/*
+	 * Secure protection bits are applicable only for gaudi3, and within gaudi3, only
+	 * in the arcmgmt app—since LKD, the secured initiator, is loaded at this stage.
+	 */
+	if (priv_level == PROT_BITS_SECURED) {
+		return 0;
+	}
+#endif
 
 	if (!sec_dbg_initialized) {
 		data->sec_dbg = hl_dev_security_debug_disabled(dev);
@@ -166,7 +177,8 @@
 				do {
 					err = hl_dev_init_prot_bits_block(dev, prot_bits_cfg,
 								    cfg_idx, major_idx, minor_idx,
-								    sub_minor_idx, block_addr.type);
+								    sub_minor_idx, block_addr.type,
+									priv_level);
 					if (err) {
 						LOG_ERR("Err in prot config %d", cfg_idx);
 					}
