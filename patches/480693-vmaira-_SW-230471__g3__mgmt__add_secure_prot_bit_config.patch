+					uint8_t sub_minor, const struct hl_prot_bits_cfg *cfg,
+					__unused enum prot_bit_priv_level priv_level)
 {
 	mem_addr_t addr;
 
@@ -1203,11 +1204,13 @@
 {
 	if (state == HL_SECURITY_CONFIG_STATE_PREBOOT) {
 		hl_dev_prot_bits_init(dev, gaudi2_preboot_prot_bits_cfg, 0,
-						ARRAY_SIZE(gaudi2_preboot_prot_bits_cfg));
+						ARRAY_SIZE(gaudi2_preboot_prot_bits_cfg),
+						PROT_BITS_PRIVILEGE);
 
 	} else if (state == HL_SECURITY_CONFIG_STATE_PREBOOT_RESET) {
 		hl_dev_prot_bits_init(dev, gaudi2_preboot_prot_bits_reset, 0,
-					ARRAY_SIZE(gaudi2_preboot_prot_bits_reset));
+					ARRAY_SIZE(gaudi2_preboot_prot_bits_reset),
+					PROT_BITS_PRIVILEGE);
 	} else {
 		LOG_ERR("Invalid security config state %d", state);
 		return -EINVAL;
@@ -1687,7 +1690,7 @@
 	is_sec_enabled = hl_dev_security_get_status(dev);
 	if (is_sec_enabled) {
 		hl_dev_prot_bits_init(dev, gaudi2_soft_reset_prot_bits, HL_RESET_SRC_SOFT_RST,
-				ARRAY_SIZE(gaudi2_soft_reset_prot_bits));
+				ARRAY_SIZE(gaudi2_soft_reset_prot_bits), PROT_BITS_PRIVILEGE);
 		gaudi2_soft_reset_lbw_sec_config(dev, false);
 		gaudi2_psoc_efuse_protection(false);
 	}
@@ -1710,7 +1713,8 @@
 	if (is_sec_enabled) {
 		gaudi2_psoc_efuse_protection(true);
 		hl_dev_prot_bits_init(dev, gaudi2_os_prot_bits_cfg, HL_RESET_SRC_SOFT_RST,
-						ARRAY_SIZE(gaudi2_os_prot_bits_cfg));
+						ARRAY_SIZE(gaudi2_os_prot_bits_cfg),
+						PROT_BITS_PRIVILEGE);
 		LOG_INF("Protection bits re-init done");
 		gaudi2_soft_reset_lbw_sec_config(dev, true);
 	}
@@ -1792,7 +1796,8 @@
 	hl_dev_config_termination_regs(dev);
 
 	ret = hl_dev_prot_bits_init(dev, gaudi2_os_prot_bits_cfg, 0,
-						ARRAY_SIZE(gaudi2_os_prot_bits_cfg));
+						ARRAY_SIZE(gaudi2_os_prot_bits_cfg),
+						PROT_BITS_PRIVILEGE);
 	if (ret) {
 		LOG_ERR("protection bits init failed");
 	} else {
@@ -1960,14 +1965,14 @@
 	prot_bits_reset_cfg.addr.major = 1;
 	for (i = 0; i < ARRAY_SIZE(gaudi2_pcie_base_addr); i++) {
 		prot_bits_reset_cfg.addr.base_addr = gaudi2_pcie_base_addr[i];
-		hl_dev_prot_bits_init(dev, &prot_bits_reset_cfg, 0, 1);
+		hl_dev_prot_bits_init(dev, &prot_bits_reset_cfg, 0, 1, PROT_BITS_PRIVILEGE);
 	}
 
 	/* reset PLL protection bits */
 	prot_bits_reset_cfg.addr.type = HL_BLOCK_TYPE_PLL;
 	prot_bits_reset_cfg.addr.base_addr = mmPSOC_MME_PLL_CTRL_BASE;
 	prot_bits_reset_cfg.addr.major = GAUDI2_NUM_OF_PLLS;
-	hl_dev_prot_bits_init(dev, &prot_bits_reset_cfg, 0, 1);
+	hl_dev_prot_bits_init(dev, &prot_bits_reset_cfg, 0, 1, PROT_BITS_PRIVILEGE);
 
 }
 
