+#define _EMB_CMN_MOD_FIT_SERVICES_H_
+
+#include <stdint.h>
+#include "libfdt.h"
+#include "fdt.h"
+
+enum fit_sec_failure {
+	FIT_SEC_NONE = 0,
+	FIT_SEC_SVN_INVALID,
+	FIT_SEC_KEY_REVOKED,
+	FIT_SEC_HASH_FAILED,
+	FIT_SEC_SIGN_FAILED,
+};
+
+typedef int (*fit_property_match_cb)(const void *fit,
+		const struct fdt_property *prop, void *data);
+
+int fit_foreach_property(const void *fit, const char *node_path,
+			fit_property_match_cb match_cb, void *data);
