+#ifdef CONFIG_HL_DUP_ENG_DRIVER
+	#define DUP_ENGINE_DEV(inst) DEVICE_DT_GET(DT_INST_PHANDLE(inst, dup_eng_inst))
+#else
+	#define DUP_ENGINE_DEV(inst) NULL
+#endif
+
+#if defined(CONFIG_SOC_SERIES_FS1)
+#define DEV_INIT_LEVEL PRE_KERNEL_2
+#else
+#define DEV_INIT_LEVEL PRE_KERNEL_1
+#endif
+
+#define DUP_GRP_ID_BY_IDX(node_id, prop, idx) DT_PROP_BY_IDX(node_id, prop, idx),
+
+#define CREATE_HL_RL_DEVICE(inst)					\
+	const uint32_t regs_##inst##_base[] = { DT_FOREACH_PROP_ELEM(		\
+			DT_INST(inst, DT_DRV_COMPAT), reg_names,	\
+			REG_ADDR_BY_IDX) };				\
+	const uint32_t hl_rl_##inst##_dup_grp_id[] = {DT_FOREACH_PROP_ELEM(	\
+			DT_INST(inst, DT_DRV_COMPAT), dup_grp_id,		\
+			DUP_GRP_ID_BY_IDX)};				\
+									\
+	static const struct hl_rl_drv_cfg_info hl_rl_##inst##_config = {	\
+		.base = regs_##inst##_base,				\
+		.name = DT_INST_LABEL(inst),				\
+		.max_sat = DT_INST_PROP(inst, max_sat),			\
+		.max_timeout = DT_INST_PROP(inst, max_timeout),		\
+		.max_rate = DT_INST_PROP(inst, max_rate),		\
+		.init_reset = DT_INST_PROP(inst, init_reset),		\
+		.id = inst,						\
+		.regs_num = DT_NUM_REGS(DT_DRV_INST(inst)),		\
+		.block_type = DT_INST_PROP(inst, block_type),		\
+		.dup_grp_id_list =  hl_rl_##inst##_dup_grp_id,		\
+		.dup_grp_num = DT_PROP_LEN(DT_DRV_INST(inst), dup_grp_id),		\
+		.dup_master_grp_id = DT_INST_PROP(inst, dup_master_grp_id),		\
+		.valid_units = HL_RL_DEFAULT_VALID_UNITS,		\
+		.dup_eng_dev = DUP_ENGINE_DEV(inst),			\
+	};								\
+	static struct hl_rl_drv_data hl_rl_drv_##inst##_data;		\
+									\
+	DEVICE_DT_INST_DEFINE(inst, &hl_rl_init,				\
+			NULL,						\
+			&hl_rl_drv_##inst##_data,			\
+			&hl_rl_##inst##_config,				\
+			DEV_INIT_LEVEL,					\
+			CONFIG_KERNEL_INIT_PRIORITY_DEVICE,		\
+			&hl_rl_api);
+DT_INST_FOREACH_STATUS_OKAY(CREATE_HL_RL_DEVICE)
