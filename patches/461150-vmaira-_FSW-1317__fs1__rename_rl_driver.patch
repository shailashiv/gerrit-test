+++ b/drivers/clock_control/clock_control_rl.c
@@ -0,0 +1,812 @@
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdlib.h>
+#include <drivers/clock_control/hl_rl.h>
+
+#define LOG_LEVEL CONFIG_CLOCK_CONTROL_LOG_LEVEL
+#include <logging/log.h>
+#include <common_utils.h>
+#include <hl_fw_if.h>
+LOG_MODULE_REGISTER(clock_control_hl_rl);
+#ifdef CONFIG_HL_DUP_ENG_DRIVER
+#include <dup_api.h>
+#include <hl_utils.h>
+
+#define DUP_GRP_MAX_ADDR	32
+#endif
+#include <hl_devs.h>
+
+#if DT_HAS_COMPAT_STATUS_OKAY(hl_rl)
+#define DT_DRV_COMPAT hl_rl
+#elif DT_HAS_COMPAT_STATUS_OKAY(intel_fs_rl)
+#define DT_DRV_COMPAT intel_fs_rl
+#else
+#warning "RL engine driver enabled without any devices"
+#endif
+
+#define DEV_CFG(dev) \
+	((const struct hl_rl_drv_cfg_info * const)(dev)->config)
+
+#define DEV_DATA(dev) \
+	((struct hl_rl_drv_data * const)(dev)->data)
+
+#define DEV_ID(dev) \
+	(DEV_CFG(dev)->id)
+
+#define HL_RL_LOG_ERR(...) LOG_ERR(__VA_ARGS__)
+#define HL_RL_LOG_WRN(...) LOG_WRN(__VA_ARGS__)
+#define HL_RL_LOG_INF(...) LOG_INF(__VA_ARGS__)
+#define HL_RL_LOG_DBG(...) LOG_DBG(__VA_ARGS__)
+
+#define HL_RL_ERR(fmt, ...) HL_RL_LOG_ERR("%s:%d:" fmt, \
+				__func__, DEV_CFG(dev)->id, ##__VA_ARGS__)
+#define HL_RL_WRN(fmt, ...) HL_RL_LOG_WRN("%s:%d:" fmt, \
+				__func__, DEV_CFG(dev)->id, ##__VA_ARGS__)
+#define HL_RL_INF(fmt, ...) HL_RL_LOG_INF("%s:%d:" fmt, \
+				__func__, DEV_CFG(dev)->id, ##__VA_ARGS__)
+#define HL_RL_DBG(fmt, ...) HL_RL_LOG_DBG("%s:%d:" fmt, \
+				__func__, DEV_CFG(dev)->id, ##__VA_ARGS__)
+
+#define CTRL_LO_EU_RL_ENABLE_V_MASK 0x1
+#define CTRL_LO_EU_RL_CFG_RST_TOKEN_SHIFT 0
+#define CTRL_LO_EU_RL_CFG_RST_TOKEN_MASK 0xFF
+#define CTRL_LO_EU_RL_CFG_TIMEOUT_SHIFT 8
+#define CTRL_LO_EU_RL_CFG_TIMEOUT_MASK 0xFF00
+#define CTRL_LO_EU_RL_CFG_SATURATION_SHIFT 16
+#define CTRL_LO_EU_RL_CFG_SATURATION_MASK 0xFF0000
+#define CTRL_LO_EU_RL_CFG_DATA_SIZE_SHIFT 24
+#define CTRL_LO_EU_RL_CFG_DATA_SIZE_MASK 0xFF000000
+
+#define CFG_IQ_RL_EN_V_SHIFT 0
+#define CFG_IQ_RL_EN_V_MASK 0x1
+#define CFG_IQ_RL_SAT_V_SHIFT 0
+#define CFG_IQ_RL_SAT_V_MASK 0xFF
+#define CFG_IQ_RL_RST_TOKEN_V_SHIFT 0
+#define CFG_IQ_RL_RST_TOKEN_V_MASK 0xFF
+#define CFG_IQ_RL_TIMEOUT_V_SHIFT 0
+#define CFG_IQ_RL_TIMEOUT_V_MASK 0xFF
+
+#define MSTR_IF_CORE_HBW_RL_SATURATION_SHIFT 0
+#define MSTR_IF_CORE_HBW_RL_SATURATION_MASK 0xFF
+#define MSTR_IF_CORE_HBW_RL_RST_TOKEN_SHIFT 8
+#define MSTR_IF_CORE_HBW_RL_RST_TOKEN_MASK 0xFF00
+#define MSTR_IF_CORE_HBW_RL_TIMEOUT_SHIFT 16
+#define MSTR_IF_CORE_HBW_RL_TIMEOUT_MASK 0xFF0000
+#define MSTR_IF_CORE_HBW_RL_EN_SHIFT 24
+#define MSTR_IF_CORE_HBW_RL_EN_MASK 0x1000000
+
+/* Rate limiter settings differ in the different blocks */
+enum rl_gaudi2_block_conf {
+	CTRL_MSTR_IF,
+	CTRL_LO,
+	CFG,
+};
+
+struct hl_mstr_if_rl_regs {
+	uint32_t core_hbw_rl_wr;
+	uint32_t core_hbw_rl_rd;
+};
+
+struct hl_ctrl_lo_rl_regs {
+	uint32_t eu_rl_enable;
+	uint32_t eu_rl_token_sel;
+	uint32_t eu_rl_cfg;
+};
+
+struct hl_cfg_rl_regs {
+	uint32_t iq_rl_en;
+	uint32_t iq_rl_sat;
+	uint32_t iq_rl_rst_token;
+	uint32_t iq_rl_timeout;
+};
+
+static int hl_rl_off(const struct device *dev,
+			clock_control_subsys_t sub_system)
+{
+	/* no action needed related with rate limit for clock off */
+	return 0;
+}
+
+static int hl_rl_get_rate(const struct device *dev,
+		clock_control_subsys_t sub_system, uint32_t *rate)
+{
+	struct hl_rl_drv_data * const data = DEV_DATA(dev);
+
+	*rate =  data->rate;
+
+	return 0;
+}
+
+#ifdef CONFIG_HL_DUP_ENG_DRIVER
+static int hl_rl_prepare_dup_eng_group(const struct hl_rl_drv_cfg_info *const config,
+				uint8_t group, uint32_t *base_addr, uint32_t num_base)
+{
+	int ret = 0;
+
+	ret = dup_program_address(config->dup_eng_dev, DUP_MULTICAST, group, base_addr, num_base);
+	if (ret) {
+		LOG_ERR("%s: Failed to program addr in dup engine ret = %d", __func__, ret);
+		return ret;
+	}
+
+	ret = dup_program_mask(config->dup_eng_dev, group, GEN_BIT_MASK(num_base));
+	if (ret) {
+		LOG_ERR("%s: Failed to program mask in dup engine ret = %d", __func__, ret);
+		return ret;
+	}
+
+	return ret;
+}
+
+static int hl_rl_prepare_dup_eng_master_group(const struct hl_rl_drv_cfg_info *const config,
+				uint8_t master_group, uint32_t *dup_grp_id_list, uint32_t num_grps)
+{
+	int ret = 0;
+
+	ret = dup_master_program_address(config->dup_eng_dev, master_group, dup_grp_id_list,
+		num_grps);
+	if (ret) {
+		LOG_ERR("%s: Failed to program addr in master dup group ret = %d", __func__, ret);
+		return ret;
+	}
+
+	ret = dup_program_mask(config->dup_eng_dev, master_group, GEN_BIT_MASK(num_grps));
+	if (ret) {
+		LOG_ERR("%s: Failed to program mask in master dup group ret = %d", __func__, ret);
+		return ret;
+	}
+
+	return ret;
+}
+
+static int hl_rl_prepare_dup_eng(const struct hl_rl_drv_cfg_info *const config,
+				struct hl_rl_drv_data * const data)
+{
+	int ret = 0;
+	uint32_t num_base = 0, grp_list_idx, reg_idx, remaining_addr;
+	uint32_t base_addr[DUP_GRP_MAX_ADDR];
+	uint8_t num_required_grps;
+
+	num_required_grps = config->regs_num / DUP_GRP_MAX_ADDR +
+			((config->regs_num % DUP_GRP_MAX_ADDR) > 0) ? 1 : 0;
+
+	if (config->dup_grp_num < num_required_grps) {
+		LOG_ERR("%s: Insufficient group count for rl config", __func__);
+		return -1;
+	}
+
+	for (grp_list_idx = 0; grp_list_idx < num_required_grps; grp_list_idx++) {
+		num_base = 0;
+		memset(base_addr, 0, sizeof(base_addr));
+		remaining_addr = config->regs_num - grp_list_idx * DUP_GRP_MAX_ADDR;
+
+		for (reg_idx = 0; reg_idx <  MIN(DUP_GRP_MAX_ADDR, remaining_addr) ; reg_idx++) {
+			if (!(config->valid_units & BIT(reg_idx)))
+				continue;
+
+			base_addr[reg_idx] = (mem_addr_t)config->base[reg_idx +
+				grp_list_idx * DUP_GRP_MAX_ADDR];
+			num_base++;
+		}
+
+		ret = hl_rl_prepare_dup_eng_group(config, config->dup_grp_id_list[grp_list_idx],
+					(uint32_t *)base_addr, num_base);
+		if (ret)
+			return ret;
+	}
+
+	if (num_required_grps > 1) {
+		ret = hl_rl_prepare_dup_eng_master_group(config, config->dup_master_grp_id,
+					(uint32_t *)config->dup_grp_id_list, num_required_grps);
+		if (ret)
+			return ret;
+	}
+
+	data->dup_grp_id = (num_required_grps > 1) ?
+			config->dup_master_grp_id :
+			config->dup_grp_id_list[0];
+
+	return ret;
+}
