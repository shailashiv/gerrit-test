+/*
+ * RL DT entries are added for all Dies.
+ * Depending on SKU type need to skip un-available RLs
+ */
+static bool hl_rl_skip_rl(const struct device *dev)
+{
+	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
+	uint32_t num_dies = 1;
+	uint32_t die_id = hl_read_die_id();
+	bool spi_gw_dis = hl_get_spi_gw_disable();
+
+	if (hl_get_sku_type() == HL_DUAL_DIE_SKU)
+		num_dies = 2;
+
+	return !hl_is_cfg_addr_valid((uint32_t)config->base[0], die_id, num_dies, spi_gw_dis);
+}
+
+static int hl_rl_init(const struct device *dev)
+{
+	struct hl_rl_drv_data * const data = DEV_DATA(dev);
+	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
+
+	if (hl_rl_skip_rl(dev)) {
+		HL_RL_ERR("Skipping RL init for %s", DEV_CFG(dev)->name);
+		return -EINVAL;
+	}
+
+	if (hl_rl_get_type(dev)) {
+		HL_RL_ERR("invalid prop 'block_type' %s\n", config->block_type);
+		return -EINVAL;
+	}
+
+	data->max_sat = config->max_sat;
+	data->max_timeout = config->max_timeout;
+	data->max_rate = config->max_rate;
+	data->reset_val = config->init_reset;
+
+	if (config->init_reset && ((*hl_rl_is_first_init_ptr[data->block_conf])(dev))) {
+		(*init_rl_reg_once[data->block_conf])(dev);
+	}
+
+#ifdef CONFIG_HL_DUP_ENG_DRIVER
+	if (!strcmp("ctrl_lo", config->block_type)) {
+		/* Store mme ctrl_lo,eu_rl_cfg value, to be used later in fn: hl_ctrl_lo_rl_on() */
+		data->eu_rl_cfg_val =
+			((volatile struct hl_ctrl_lo_rl_regs *) (config->base[0]))->eu_rl_cfg;
+	}
+#endif
+
+	return 0;
+}
