+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_DRIVERS_CLOCK_CONTROL_HLL_RL_H_
+#define ZEPHYR_DRIVERS_CLOCK_CONTROL_HLL_RL_H_
+
+#define REG_ADDR_BY_IDX(node_id, prop, idx) DT_REG_ADDR_BY_IDX(node_id, idx),
+
+#include <device.h>
+#include <drivers/clock_control.h>
+
+#define HL_TPC_RST_MAX 23
+#define HL_TPC_TIMEOUT_MAX 49
+#define HL_MME_RST_MAX 20
+#define HL_MME_TIMEOUT_MAX 19
+#define HL_RL_MIN_RATE 1
+#define HL_RL_MIN_RESET_VAL 1
+/*
+ * The following max_timeout value is used only when rate limit is at the minimum in order to
+ * reduce the jobs intake without shuting it down completely (rl=0). On any other situation, the
+ * max_timeout value is taken for the device tree config.
+ */
+#define HL_RL_MAX_TIMEOUT_DURING_MIN_RATE 99
+
+#define HL_RL_DEFAULT_VALID_UNITS	0xFFFFFFFF
+
+struct hl_std_rl_cfg {
+	uint32_t rate;
+	uint32_t rst_token;
+};
+
+struct hl_rl_drv_data {
+	uint32_t rate;
+	uint32_t reset_val;
+	uint32_t max_rate;
+	uint32_t max_sat;
+	uint32_t max_rst;
+	uint32_t max_timeout;
+	uint32_t last_max_timeout;
+	const uint32_t *pu_config;
+	uint8_t block_conf;
+	uint8_t dup_grp_id;
+#ifdef CONFIG_HL_DUP_ENG_DRIVER
+	uint32_t eu_rl_cfg_val;
+	uint32_t mstr_if_hbw_rl_wr;
+	uint32_t mstr_if_hbw_rl_rd;
+#endif
+};
+
+struct hl_rl_drv_cfg_info {
+	uint8_t  *name;
+	uint8_t id;
+	uint8_t max_sat;
+	uint8_t max_timeout;
+	const uint32_t *base;
+	uint8_t regs_num;
+	uint8_t *block_type;
+	uint8_t max_rate;
+	uint8_t dup_master_grp_id;
+	uint8_t dup_grp_num;
+	const uint32_t *dup_grp_id_list;
+	uint32_t valid_units;
+	uint32_t init_reset;
+	const struct device *dup_eng_dev;
+};
+
+/*
+ * @valid_units: reg map, each bit represent a HW unit, the order goes
+ * according to the order in the <reg> DT property
+ * @rl_div: divider for RL rate (0-100) controlled by user (host side)
+ *  i.e. if rl_div is 50 (%), all values selected by application (pid) are divided by 2.
+ */
+struct hl_rl_clock_control_t {
+	uint32_t rate;
+	uint32_t valid_units;
+	uint8_t rl_div;
+};
+
+#endif /* ZEPHYR_DRIVERS_CLOCK_CONTROL_HLL_RL_H_ */
