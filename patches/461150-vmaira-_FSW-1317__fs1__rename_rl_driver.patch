-
-#ifdef CONFIG_HL_DUP_ENG_DRIVER
-static int hl_rl_prepare_dup_eng_group(const struct hl_rl_drv_cfg_info *const config,
-				uint8_t group, uint32_t *base_addr, uint32_t num_base)
-{
-	int ret = 0;
-
-	ret = dup_program_address(config->dup_eng_dev, DUP_MULTICAST, group, base_addr, num_base);
-	if (ret) {
-		LOG_ERR("%s: Failed to program addr in dup engine ret = %d", __func__, ret);
-		return ret;
-	}
-
-	ret = dup_program_mask(config->dup_eng_dev, group, GEN_BIT_MASK(num_base));
-	if (ret) {
-		LOG_ERR("%s: Failed to program mask in dup engine ret = %d", __func__, ret);
-		return ret;
-	}
-
-	return ret;
-}
-
-static int hl_rl_prepare_dup_eng_master_group(const struct hl_rl_drv_cfg_info *const config,
-				uint8_t master_group, uint32_t *dup_grp_id_list, uint32_t num_grps)
-{
-	int ret = 0;
-
-	ret = dup_master_program_address(config->dup_eng_dev, master_group, dup_grp_id_list,
-		num_grps);
-	if (ret) {
-		LOG_ERR("%s: Failed to program addr in master dup group ret = %d", __func__, ret);
-		return ret;
-	}
-
-	ret = dup_program_mask(config->dup_eng_dev, master_group, GEN_BIT_MASK(num_grps));
-	if (ret) {
-		LOG_ERR("%s: Failed to program mask in master dup group ret = %d", __func__, ret);
-		return ret;
-	}
-
-	return ret;
-}
-
-static int hl_rl_prepare_dup_eng(const struct hl_rl_drv_cfg_info *const config,
-				struct hl_rl_drv_data * const data)
-{
-	int ret = 0;
-	uint32_t num_base = 0, grp_list_idx, reg_idx, remaining_addr;
-	uint32_t base_addr[DUP_GRP_MAX_ADDR];
-	uint8_t num_required_grps;
-
-	num_required_grps = config->regs_num / DUP_GRP_MAX_ADDR +
-			((config->regs_num % DUP_GRP_MAX_ADDR) > 0) ? 1 : 0;
-
-	if (config->dup_grp_num < num_required_grps) {
-		LOG_ERR("%s: Insufficient group count for rl config", __func__);
-		return -1;
-	}
-
-	for (grp_list_idx = 0; grp_list_idx < num_required_grps; grp_list_idx++) {
-		num_base = 0;
-		memset(base_addr, 0, sizeof(base_addr));
-		remaining_addr = config->regs_num - grp_list_idx * DUP_GRP_MAX_ADDR;
-
-		for (reg_idx = 0; reg_idx <  MIN(DUP_GRP_MAX_ADDR, remaining_addr) ; reg_idx++) {
-			if (!(config->valid_units & BIT(reg_idx)))
-				continue;
-
-			base_addr[reg_idx] = (mem_addr_t)config->base[reg_idx +
-				grp_list_idx * DUP_GRP_MAX_ADDR];
-			num_base++;
-		}
-
-		ret = hl_rl_prepare_dup_eng_group(config, config->dup_grp_id_list[grp_list_idx],
-					(uint32_t *)base_addr, num_base);
-		if (ret)
-			return ret;
-	}
-
-	if (num_required_grps > 1) {
-		ret = hl_rl_prepare_dup_eng_master_group(config, config->dup_master_grp_id,
-					(uint32_t *)config->dup_grp_id_list, num_required_grps);
-		if (ret)
-			return ret;
-	}
-
-	data->dup_grp_id = (num_required_grps > 1) ?
-			config->dup_master_grp_id :
-			config->dup_grp_id_list[0];
-
-	return ret;
-}
-
-static int hl_rl_dup_program_data(const struct device *dup_eng_dev, uint8_t dup_grp_id,
-		uint16_t offset, uint32_t val)
-{
-	int ret;
-
-	ret = dup_program_data(dup_eng_dev, DUP_MULTICAST, dup_grp_id, offset, val);
-	if (ret) {
-		LOG_ERR("%s: Failed to program data in dup engine ret = %d", __func__, ret);
-		return ret;
-	}
-
-	return 0;
-}
-#endif
-
-
-#ifdef CONFIG_HL_DUP_ENG_DRIVER
-static int hl_mstr_if_rl_on(const struct device *dev)
-{
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	uint32_t cfg = 0;
-	int ret;
-	uint16_t offset;
-
-	offset = offsetof(struct hl_mstr_if_rl_regs, core_hbw_rl_rd);
-	cfg = data->mstr_if_hbw_rl_rd;
-	cfg &= ~(MSTR_IF_CORE_HBW_RL_RST_TOKEN_MASK | MSTR_IF_CORE_HBW_RL_TIMEOUT_MASK);
-	cfg |= (data->reset_val << MSTR_IF_CORE_HBW_RL_RST_TOKEN_SHIFT);
-	cfg |= (data->max_timeout << MSTR_IF_CORE_HBW_RL_TIMEOUT_SHIFT);
-	ret = hl_rl_dup_program_data(config->dup_eng_dev, data->dup_grp_id, offset, cfg);
-	if (ret < 0)
-		return ret;
-
-	offset = offsetof(struct hl_mstr_if_rl_regs, core_hbw_rl_wr);
-	cfg = data->mstr_if_hbw_rl_wr;
-	cfg &= ~(MSTR_IF_CORE_HBW_RL_RST_TOKEN_MASK | MSTR_IF_CORE_HBW_RL_TIMEOUT_MASK);
-	cfg |= (data->reset_val << MSTR_IF_CORE_HBW_RL_RST_TOKEN_SHIFT);
-	cfg |= (data->max_timeout << MSTR_IF_CORE_HBW_RL_TIMEOUT_SHIFT);
-	ret = hl_rl_dup_program_data(config->dup_eng_dev, data->dup_grp_id, offset, cfg);
-	return ret;
-}
-#else
-static int hl_mstr_if_rl_on(const struct device *dev)
-{
-	uint32_t reset_val, max_timeout, i;
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	uint32_t cfg = 0;
-
-	volatile struct hl_mstr_if_rl_regs *reg_base_pu;
-
-	reset_val = data->reset_val;
-	max_timeout = data->max_timeout;
-
-	for (i = 0; i < config->regs_num; i++) {
-		if (!(config->valid_units & BIT(i)))
-			continue;
-
-		reg_base_pu = (volatile struct hl_mstr_if_rl_regs *)
-			(config->base[i]);
-
-		cfg = sys_read32((mem_addr_t) &reg_base_pu->core_hbw_rl_wr);
-		cfg &= ~(MSTR_IF_CORE_HBW_RL_RST_TOKEN_MASK | MSTR_IF_CORE_HBW_RL_TIMEOUT_MASK);
-		cfg |= (reset_val << MSTR_IF_CORE_HBW_RL_RST_TOKEN_SHIFT);
-		cfg |= (max_timeout << MSTR_IF_CORE_HBW_RL_TIMEOUT_SHIFT);
-		sys_write32(cfg, (mem_addr_t) &reg_base_pu->core_hbw_rl_wr);
-
-		cfg = sys_read32((mem_addr_t) &reg_base_pu->core_hbw_rl_rd);
-		cfg &= ~(MSTR_IF_CORE_HBW_RL_RST_TOKEN_MASK | MSTR_IF_CORE_HBW_RL_TIMEOUT_MASK);
-		cfg |= (reset_val << MSTR_IF_CORE_HBW_RL_RST_TOKEN_SHIFT);
-		cfg |= (max_timeout << MSTR_IF_CORE_HBW_RL_TIMEOUT_SHIFT);
-		sys_write32(cfg, (mem_addr_t) &reg_base_pu->core_hbw_rl_rd);
-		cfg = 0;
-	}
-
-	return 0;
-}
-#endif
-
-#ifdef CONFIG_HL_DUP_ENG_DRIVER
-static int hl_ctrl_lo_rl_on(const struct device *dev)
-{
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	uint32_t cfg = 0;
-	uint16_t offset = offsetof(struct hl_ctrl_lo_rl_regs, eu_rl_cfg);
-
-	cfg = data->eu_rl_cfg_val;
-	cfg &= ~(CTRL_LO_EU_RL_CFG_RST_TOKEN_MASK | CTRL_LO_EU_RL_CFG_TIMEOUT_MASK);
-	cfg |= (data->reset_val << CTRL_LO_EU_RL_CFG_RST_TOKEN_SHIFT);
-	cfg |= (data->max_timeout << CTRL_LO_EU_RL_CFG_TIMEOUT_SHIFT);
-
-	return hl_rl_dup_program_data(config->dup_eng_dev, data->dup_grp_id, offset, cfg);
-}
-#else
-static int hl_ctrl_lo_rl_on(const struct device *dev)
-{
-	uint32_t reset_val, max_timeout, i;
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	volatile struct hl_ctrl_lo_rl_regs *reg_base_pu;
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	uint32_t cfg = 0;
-
-	reset_val = data->reset_val;
-	max_timeout = data->max_timeout;
-
-	for (i = 0; i < config->regs_num; i++) {
-		if (!(config->valid_units & BIT(i)))
-			continue;
-
-		reg_base_pu = (volatile struct hl_ctrl_lo_rl_regs *)
-			(config->base[i]);
-
-		cfg = sys_read32((mem_addr_t) &reg_base_pu->eu_rl_cfg);
-		cfg &= ~(CTRL_LO_EU_RL_CFG_RST_TOKEN_MASK | CTRL_LO_EU_RL_CFG_TIMEOUT_MASK);
-		cfg |= (reset_val << CTRL_LO_EU_RL_CFG_RST_TOKEN_SHIFT);
-		cfg |= (max_timeout << CTRL_LO_EU_RL_CFG_TIMEOUT_SHIFT);
-		sys_write32(cfg, (mem_addr_t) &reg_base_pu->eu_rl_cfg);
-		cfg = 0;
-	}
-
-	return 0;
-}
-#endif
-
-#ifdef CONFIG_HL_DUP_ENG_DRIVER
-static int hl_cfg_rl_on(const struct device *dev)
-{
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	uint16_t offset;
-	int ret;
-
-	offset = offsetof(struct hl_cfg_rl_regs, iq_rl_rst_token);
-	ret = hl_rl_dup_program_data(config->dup_eng_dev, data->dup_grp_id, offset,
-		data->reset_val);
-	if (ret < 0)
-		return ret;
-
-	/* no need to update max_timeout if it's already set */
-	if (data->last_max_timeout == data->max_timeout)
-		return ret;
-
-	offset = offsetof(struct hl_cfg_rl_regs, iq_rl_timeout);
-	ret = hl_rl_dup_program_data(config->dup_eng_dev, data->dup_grp_id, offset,
-		data->max_timeout);
-	if (ret == 0)
-		data->last_max_timeout = data->max_timeout;
-
-	return ret;
-}
-#else
-static int hl_cfg_rl_on(const struct device *dev)
-{
-	uint32_t reset_val, max_timeout, i;
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	volatile struct hl_cfg_rl_regs *reg_base_pu;
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-
-	reset_val = data->reset_val;
-	max_timeout = data->max_timeout;
-
-	for (i = 0; i < config->regs_num; i++) {
-		if (!(config->valid_units & BIT(i)))
-			continue;
-
-		reg_base_pu = (volatile struct hl_cfg_rl_regs *)
-			(config->base[i]);
-
-		sys_write32(reset_val, (mem_addr_t) &reg_base_pu->iq_rl_rst_token);
-		sys_write32(max_timeout, (mem_addr_t) &reg_base_pu->iq_rl_timeout);
-	}
-
-	return 0;
-}
-#endif
-
-/*
- * 1.	Set max BW coefficients to all RLs
- * 2.	Enable the RL.
- */
-static int mstr_if_init_rl_reg_once(const struct device *dev)
-{
-	int32_t max_sat, reset_val, max_timeout, i;
-	volatile struct hl_mstr_if_rl_regs *reg_base_pu;
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	uint32_t cfg = 0;
-	int ret = 0;
-
-	max_sat = data->max_sat;
-	reset_val = data->reset_val;
-	max_timeout = data->max_timeout;
-
-	for (i = 0; i < config->regs_num; i++) {
-		if (!(config->valid_units & BIT(i)))
-			continue;
-
-		reg_base_pu = (volatile struct  hl_mstr_if_rl_regs *)
-			(config->base[i]);
-		cfg |= (max_sat << MSTR_IF_CORE_HBW_RL_SATURATION_SHIFT);
-		cfg |= (reset_val << MSTR_IF_CORE_HBW_RL_RST_TOKEN_SHIFT);
-		cfg |= (max_timeout << MSTR_IF_CORE_HBW_RL_TIMEOUT_SHIFT);
-		sys_write32(cfg, (mem_addr_t) &reg_base_pu->core_hbw_rl_wr);
-		sys_write32(cfg, (mem_addr_t) &reg_base_pu->core_hbw_rl_rd);
-		cfg = 0;
-	}
-
-	/* Enable RL */
-	for (i = 0; i < config->regs_num; i++) {
-		if (!(config->valid_units & BIT(i)))
-			continue;
-
-		reg_base_pu =
-			((volatile struct  hl_mstr_if_rl_regs *)
-			 (config->base[i]));
-		sys_rmwrite32((mem_addr_t) &reg_base_pu->core_hbw_rl_wr, 1,
-						MSTR_IF_CORE_HBW_RL_EN_MASK);
-		sys_rmwrite32((mem_addr_t) &reg_base_pu->core_hbw_rl_rd, 1,
-						MSTR_IF_CORE_HBW_RL_EN_MASK);
-	}
-
-#ifdef CONFIG_HL_DUP_ENG_DRIVER
-	ret = hl_rl_prepare_dup_eng(config, data);
-
-	/*
-	 * Store mstr_if,core_hbw_rl_rd and core_hbw_rl_wr value, to be used later
-	 * in fn: hl_mstr_if_rl_on()
-	 */
-	data->mstr_if_hbw_rl_rd =
-		((volatile struct hl_mstr_if_rl_regs *) (config->base[0]))->core_hbw_rl_rd;
-	data->mstr_if_hbw_rl_wr =
-		((volatile struct hl_mstr_if_rl_regs *) (config->base[0]))->core_hbw_rl_wr;
-#endif
-
-	return ret;
-}
-
-/*
- * 1.	Set max BW coefficients to all RLs
- * 2.	Enable the RL.
- */
-static int ctrl_lo_init_rl_reg_once(const struct device *dev)
-{
-	int32_t max_sat, reset_val, max_timeout, i;
-	volatile struct hl_ctrl_lo_rl_regs *reg_base_pu;
-	const struct hl_rl_drv_cfg_info *const config = DEV_CFG(dev);
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	uint32_t cfg;
-	int ret = 0;
-
-	max_sat = data->max_sat;
-	reset_val = data->reset_val;
-	max_timeout = data->max_timeout;
-
-	for (i = 0; i < config->regs_num; i++) {
-		if (!(config->valid_units & BIT(i)))
