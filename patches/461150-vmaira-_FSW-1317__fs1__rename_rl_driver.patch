-static int hl_rl_on(const struct device *dev, clock_control_subsys_t sub_system)
-{
-	struct hl_rl_drv_data * const data = DEV_DATA(dev);
-	struct hl_rl_clock_control_t *rl_cc =
-				(struct hl_rl_clock_control_t *)(sub_system);
-	struct hl_rl_drv_cfg_info *config;
-
-	config = (struct hl_rl_drv_cfg_info *)(dev)->config;
-	/* rate needs to be between 1 to 100 */
-	if ((rl_cc->rate > data->max_rate) ||
-			(rl_cc->rate < HL_RL_MIN_RATE))	{
-		HL_RL_ERR(" rate not in range: rate = %u , parent_rate = %u\n",
-				rl_cc->rate, DEV_DATA(dev)->max_rate);
-		return -EINVAL;
-	}
-
-	/* rl_div value is controlled by application */
-	rl_cc->rate = (rl_cc->rate * rl_cc->rl_div) / 100;
-	if (rl_cc->rate < HL_RL_MIN_RATE) {
-		rl_cc->rate = HL_RL_MIN_RATE;
-	}
-
-	data->reset_val = (rl_cc->rate * (config->max_timeout + 1)) / 100;
-	data->rate = rl_cc->rate;
-	config->valid_units = rl_cc->valid_units;
-
-	/* we don't allow reset_val 0, instead we increase max timeout */
-	if (data->reset_val < HL_RL_MIN_RESET_VAL) {
-		data->reset_val = HL_RL_MIN_RESET_VAL;
-		data->max_timeout = HL_RL_MAX_TIMEOUT_DURING_MIN_RATE;
-	} else {
-		data->max_timeout = config->max_timeout;
-	}
-
-	if ((*hl_rl_is_first_init_ptr[data->block_conf])(dev)) {
-		(*init_rl_reg_once[data->block_conf])(dev);
-	}
-
-	return (*hl_rl_on_func_ptr[data->block_conf])(dev);
-}
-
-static int hl_rl_get_type(const struct device *dev)
-{
