From 13699089667b31a98feb91ce9def7795a4e6fe86 Mon Sep 17 00:00:00 2001
From: Varsha Maira <vmaira@habana.ai>
Date: Wed, 06 Nov 2024 11:16:00 +0200
Subject: [PATCH] [FSW-1317] fs1: rename rl driver

This patch renames rate limiter driver from 'hl_rl' to 'rl'.
This is in preparation for addition of rl driver for falcon
shores

Change-Id: I81036bc9cedb7bb9d8c9978cddd14e453a4e07e6
Signed-off-by: Varsha Maira <vmaira@habana.ai>
---

diff --git a/drivers/clock_control/CMakeLists.txt b/drivers/clock_control/CMakeLists.txt
index fa2c32b..da75c41 100644
--- a/drivers/clock_control/CMakeLists.txt
+++ b/drivers/clock_control/CMakeLists.txt
@@ -24,7 +24,7 @@
 zephyr_library_sources_ifdef(CONFIG_CLOCK_CONTROL_HL_CLK 	      clock_control_hl_clk.c)
 zephyr_library_sources_ifdef(CONFIG_CLOCK_CONTROL_HL_PLL 	      clock_control_hl_pll.c)
 zephyr_library_sources_ifdef(CONFIG_CLOCK_CONTROL_HL_RL         clock_control_hl_rl.c)
-zephyr_library_sources_ifdef(CONFIG_CLOCK_CONTROL_HL_RL_V2      clock_control_hl_rl_v2.c)
+zephyr_library_sources_ifdef(CONFIG_CLOCK_CONTROL_HL_RL_V2      clock_control_rl.c)
 if(CONFIG_HL_DUP_ENG_DRIVER)
 add_compile_definitions(PWRBRK_GROUP_ID=${PWRBRK_GROUP_ID})
 endif()
