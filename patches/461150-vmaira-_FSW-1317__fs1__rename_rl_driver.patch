-	int ret = 0;
-
-	if (!strcmp("mstr_if", config->block_type)) {
-		data->block_conf = CTRL_MSTR_IF;
-	} else if (!strcmp("ctrl_lo", config->block_type)) {
-		data->block_conf = CTRL_LO;
-	} else if (!strcmp("cfg", config->block_type)) {
-		data->block_conf = CFG;
-	} else {
-		 /* Error */
-		HL_RL_ERR(" HL RL: unknown type for RL, see block_type prop");
-		ret = -EINVAL;
-	}
-
-	return ret;
-}
