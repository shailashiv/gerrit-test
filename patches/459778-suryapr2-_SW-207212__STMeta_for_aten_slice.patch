diff --git a/tests/pytest_working/compile/dynamic/test_hpu_ops.py b/tests/pytest_working/compile/dynamic/test_hpu_ops.py
index d035cbb..d55ba42 100644
--- a/tests/pytest_working/compile/dynamic/test_hpu_ops.py
+++ b/tests/pytest_working/compile/dynamic/test_hpu_ops.py
@@ -1505,3 +1505,28 @@
             assert torch.allclose(h_result.to("cpu"), result, atol=0.001, rtol=0.001)
 
     execute_model(input_shapes)
+
+
+def test_backend_st_slice():
+    input_shape = [224, 224, 3]
+    indices = [
+        (200, 220, 1),
+        (201, 221, 2),
+        (202, 222, 1),
+        (203, 223, 2),
+    ]
+
+    def raw_function(t, start, end, step):
+        t = t[start:end:step]
+        t = torch.relu(t)  # to avoid fallback due to slice being a leaf view node
+        return t
+
+    compiled_fn = torch.compile(raw_function, backend="hpu_backend", dynamic=True)
+
+    for index_tuple in indices:
+        start, end, step = index_tuple
+        t1 = torch.randn(input_shape, requires_grad=False)
+        result = raw_function(t1, start, end, step)
+        t1_h = t1.to("hpu")
+        h_result = compiled_fn(t1_h, start, end, step)
+        assert torch.allclose(h_result.to("cpu"), result, atol=0.001, rtol=0.001)
