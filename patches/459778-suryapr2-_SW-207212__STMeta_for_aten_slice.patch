diff --git a/habana_kernels/index_kernels.cpp b/habana_kernels/index_kernels.cpp
index 240bbc2..dc6c627 100644
--- a/habana_kernels/index_kernels.cpp
+++ b/habana_kernels/index_kernels.cpp
@@ -2098,6 +2098,17 @@
       min <= start, "SliceOperator Start tensor min is greater than max");
 }
 
+bool SliceOperator::STMeta(
+    habana_helpers::IShapeList& inputs,
+    habana_helpers::IShapeList& outputs) {
+  std::vector<int64_t> out_shape = outputs[0].getTensorShape();
+  static_cast<void>(inputs);
+  PT_BRIDGE_DEBUG("SliceOperatorSTMeta output shape ", out_shape);
+  habana_helpers::UpdateSTShapeInfo(out_shape);
+
+  return true;
+}
+
 void SliceOperator::AllocateAndAddSynapseNode(
     synapse_helpers::graph& graph,
     torch::jit::Stack& inputs,
diff --git a/habana_kernels/index_kernels.h b/habana_kernels/index_kernels.h
index fa2532c..5054c73 100644
--- a/habana_kernels/index_kernels.h
+++ b/habana_kernels/index_kernels.h
@@ -86,6 +86,10 @@
       std::vector<int64_t>& start,
       std::vector<int64_t>& min,
       std::vector<int64_t>& max);
+
+  bool STMeta(
+      habana_helpers::IShapeList& inputs,
+      habana_helpers::IShapeList& outputs) override;
 };
 
