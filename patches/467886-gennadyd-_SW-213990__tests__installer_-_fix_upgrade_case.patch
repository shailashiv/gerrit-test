From feee5965498180a216152c039734cd134e9cd0c6 Mon Sep 17 00:00:00 2001
From: Gennady Davidov <gdavidov@habana.ai>
Date: Sun, 22 Dec 2024 15:22:14 +0200
Subject: [PATCH] [SW-213990] tests: installer - fix upgrade case

Change-Id: I256c8b5a420e52e020f0c53b785cdacda4366311
Signed-off-by: Gennady Davidov <gdavidov@habana.ai>
(cherry picked from commit 7d0a7cab52b16a60f55c2a99beb1b99991c29cb6)
---

diff --git a/tests/installer/hl-installer.sh b/tests/installer/hl-installer.sh
index dbab560..94c0eb2 100755
--- a/tests/installer/hl-installer.sh
+++ b/tests/installer/hl-installer.sh
@@ -36,11 +36,12 @@
 
 # set internal habanalabs environment
 rm -rf /tmp/.env.dev
-echo "HABANA_SERVER_NAME=${ARTIFACTORY_SERVER}" | tee /tmp/.env.dev
-echo "HABANALABS_REPO_PATH=artifactory/devops/repos" | tee -a /tmp/.env.dev
-echo "HABANALABS_SERVER_PT_DIR=artifactory/hl-generic-prod-local" | tee -a /tmp/.env.dev
-echo "HABANALABS_MLNX_REPO_PATH=artifactory/devops/tencentos" | tee -a /tmp/.env.dev
+
 if [ "${UPGRADE_ENV}" != "true" ]; then
+    echo "HABANA_SERVER_NAME=${ARTIFACTORY_SERVER}" | tee /tmp/.env.dev
+    echo "HABANALABS_REPO_PATH=artifactory/devops/repos" | tee -a /tmp/.env.dev
+    echo "HABANALABS_SERVER_PT_DIR=artifactory/hl-generic-prod-local" | tee -a /tmp/.env.dev
+    echo "HABANALABS_MLNX_REPO_PATH=artifactory/devops/tencentos" | tee -a /tmp/.env.dev
     echo "GENERATE_REPOS=FALSE" | tee -a /tmp/.env.dev
 fi
 
