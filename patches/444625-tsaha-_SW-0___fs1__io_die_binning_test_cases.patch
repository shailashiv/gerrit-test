+++ b/include/drivers/misc/common/fs1/fs1_binning_defs.h
@@ -91,4 +91,9 @@
 	void *redundancy_ctx;
 };
 
+void io_die_binning_validation_step_1(void);
+void io_die_binning_validation_step_2(void);
+void io_die_binning_validation_step_3(void);
+void io_die_binning_validation_step_4(void);
+
 #endif /* _FS1_BINNING_DEFS_H_ */
