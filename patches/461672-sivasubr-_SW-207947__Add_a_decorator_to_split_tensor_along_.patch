diff --git a/tests/pytest_working/compile/test_llamamlpsfg.py b/tests/pytest_working/compile/test_llamamlpsfg.py
index 90503fc..d2c7911 100644
--- a/tests/pytest_working/compile/test_llamamlpsfg.py
+++ b/tests/pytest_working/compile/test_llamamlpsfg.py
@@ -262,6 +262,27 @@
         return output
 
 
+def split_tensor_batch(_func=None, *, num_splits=1):
+    def decorator_split_tensor_batch(func):
+        @functools.wraps(func)
+        def wrapper_split_tensor_batch(*args, **kwargs):
+            if num_splits == 1:
+                func(*args, **kwargs)
+            else:
+                split_tensor = torch.tensor_split(args[1], num_splits)
+                out_tensor = []
+                for tensor in split_tensor:
+                    out_tensor.append(func(args[0], tensor, *args[2:], **kwargs))
+                return torch.cat(out_tensor)
+
+        return wrapper_split_tensor_batch
+
+    if _func is None:
+        return decorator_split_tensor_batch
+    else:
+        return decorator_split_tensor_batch(_func)
+
+
