+"""
+
+help_dict = {'Owner': 'Oded Rot',
+             'required OS system': ' Linux or Windows',
+             'required connection ': ' pci, usb',
+             'pci_machine_ssh_details': 'json/tests/test_machines.json',
+             }
+
+import logging
+import pytest
+import hw_manager
+from tests.test_base import TestBase
+from hw_manager.interfaces.usb_i2c import UsbI2c
+from setup_manager.hlsa_logger import hlsa_logger, hlsa_checker
+from hlsa_utils.thread_pool import ThreadPool
+from tools import hl_fw_loader_tool
+from setup_manager import options, get_command_line_option
+import monitor_manager
+import time
+import  threading
+import setup_manager.regex_parser as RegexParser
+import re
+
+
+# Logging Manipulation
+log_manager = options.get_log_manager()
+
+# Main Logger
+logger = logging.getLogger(__name__)
+
+
+class TestFT2(TestBase):
+    @classmethod
+    def setup_class(cls):
+        # Global Status
+        cls.TEST_STATUS = True
+        cls.test_code = 'FT2'
+
+        # Get Test-Options
+        hlsa_logger(level='debug', ident='Description', test_code=cls.test_code, operation='Get Test Options')
+        cls.test_options = hw_manager.get_test_options()
+
+        # Get Station Options
+        hlsa_logger(level='debug', ident='Description', test_code=cls.test_code, operation='Get Station Options')
+        cls.station_options = hw_manager.get_station_options()
+
+        # Init devices Dict
+        cls.devices = {}
+        cls.devices_tests_status = {}
+
+        cls.mcp_first_module_id_idx = cls.test_options.mcp_first_module_id_idx
+        cls.set_log_by_mezz = cls.test_options.set_log_by_mezz
+        cls.mark_input = get_command_line_option("-m")
+
+        if cls.test_options.station_setup_module == 'SA_FT':
+            cls.mcp_connected = True
+            cls.mcp_first_module_id_idx = 0
+            cls.set_log_by_mezz = False
+
+        elif cls.test_options.station_setup_module == 'SA':
+            cls.mcp_connected = True
+            cls.mcp_first_module_id_idx = 0
+            cls.set_log_by_mezz = False
+
+        cls.host = hw_manager.get_machine_component("pci_machine")
+        cls.device = hw_manager.get_dut_component()
+        cls.device_cli = cls.host.get_control(hw_manager.controls.device_cli)
+        cls.smi_control = cls.host.get_control(hw_manager.controls.smi_cli)
+        cls.driver_cli = cls.host.get_control(hw_manager.controls.driver_cli)
+
+        cls.connected_pcie_devices = cls.device_cli.get_pcie_addresses_list()
+
+        cls.global_status = hlsa_checker.check_values_is_equal(len(cls.connected_pcie_devices),
+                                                               expected_value=cls.test_options.num_of_devices,
+                                                               operation='Compare connected devices', units='String')
+
+        cls.pci_to_mezz = {}
+        cls.mezz_to_pci = {}
+        cls.pci_to_mezz_log_format = {}
+        cls.pcie_mezz_map = {}
+
+        cls.sve_run = cls.host.get_control(hw_manager.controls.sve_soc)
+        cls.device_mapper = hw_manager.device_mappers.SVE(cls)
+        cls.pci_to_mezz, cls.mezz_to_pci = cls.device_mapper.create_pci_mezz_mappings(
+            mcp_first_module_id_idx=cls.mcp_first_module_id_idx)
+
+        for pci in cls.connected_pcie_devices:
+            cls.pci_to_mezz_log_format[pci] = pci
+            if cls.set_log_by_mezz:
+                mezz = cls.pci_to_mezz[f'{pci}']
+                if mezz is not None and mezz != 'N/A':
+                    cls.pci_to_mezz_log_format[pci] = 'DUT_' + str(mezz + 1)
+
+
+        for device in cls.connected_pcie_devices:
+            hlsa_logger(level='info', ident='Description', operation=f'[SETUP] PCI Device: {device} - SETUP...')
+            # Init Device's Dict
+            cls.devices[device] = {}
+            # cls.devices[device]["hl_num"] = cls.device_cli.get_hl_number(device)
+            # cls.devices[device]["long_pci_address"] = "0000:" + str(device)
+            # cls.devices[device]["mezz"] = cls.smi_control.get_module_id(
+            #     cls.devices[device]["long_pci_address"])
+
+        for device in cls.connected_pcie_devices:
+            cls.devices_tests_status[device] = {}
+
+        if cls.mcp_connected:
+            cls.usb_devices = int(UsbI2c.get_num_devices() / 2)
+            expected_devices_usb = cls.test_options.num_of_devices
+            hlsa_checker.check_values_is_equal(cls.usb_devices, expected_value=expected_devices_usb, ident='Description',
+                                               operation=f'Getting USB Devices', ignore_assert=True,
+                                               fail_log_level='warning')
+            cls.usb_elements = {}
+            # cls.mcp_first_module_id_idx = cls.test_options.mcp_first_module_id_idx
+            # if cls.test_options.station_setup_module == 'SA_FT':
+            #     cls.mcp_first_module_id_idx = 1  # MCP0_<module_id>
+            for device_idx in range(cls.mcp_first_module_id_idx, expected_devices_usb + cls.mcp_first_module_id_idx):
+                cls.usb_elements[device_idx] = {}
+                hlsa_logger(level='info', ident='Description',
+                            operation='Setup Device Index: (%d/%d) -' % (device_idx, cls.usb_devices),
+                            result='SUCCESS')
+                try:
+                    hlsa_logger(level='debug', ident='Description', operation='Get DUT (Device Index: %d)' % device_idx)
+                    cls.usb_elements[device_idx]['device'] = hw_manager.get_dut_component(device_idx)
+
+                    # hlsa_logger(level='debug', ident='Description',
+                    #             operation='Get TCA9546A (Device Index: %d)' % device_idx)
+                    # cls.usb_elements[device_idx]['tca9546'] = cls.usb_elements[device_idx]['device'].get_component(
+                    #     hw_manager.components.TCA9546A)
+                    # cls.usb_elements[device_idx]['tca9546_registers'] = cls.usb_elements[device_idx][
+                    #     'tca9546'].get_control(
+                    #     hw_manager.controls.usb_i2c_registers)
+                    # cls.usb_elements[device_idx]['tca9546_json_regs'] = cls.usb_elements[device_idx]['tca9546'].spec
+
+                    hlsa_logger(level='debug', ident='Description', operation='Get MACHX05')
+                    cls.usb_elements[device_idx]['machx05'] = cls.usb_elements[device_idx]['device'].get_component(hw_manager.components.MACHX05)
+                    cls.usb_elements[device_idx]['machx05_registers'] = cls.usb_elements[device_idx]['machx05'].get_control(hw_manager.controls.usb_i2c_registers)
+                    cls.usb_elements[device_idx]['machx05_json_regs'] = cls.usb_elements[device_idx]['machx05'].spec
+
+                    # Get OAM_CONTROLLER from HL338 object
+                    hlsa_logger(level='debug', ident='Description', operation='Get OAM_CONTROLLER from HL338 object')
+
+                    cls.usb_elements[device_idx]['oam_controller'] = cls.usb_elements[device_idx][
+                        'device'].get_component(hw_manager.components.OAM_CONTROLLER)
+                    cls.usb_elements[device_idx]['oam_controller_signals'] = cls.usb_elements[device_idx]['oam_controller'].spec
+
+                    hlsa_logger(level='debug', ident='Description', operation='Get MACHX05')
+                    cls.usb_elements[device_idx]['machx05'] = cls.usb_elements[device_idx]['device'].get_component(
+                        hw_manager.components.MACHX05)
+                    cls.usb_elements[device_idx]['machx05_registers'] = cls.usb_elements[device_idx][
+                        'machx05'].get_control(
+                        hw_manager.controls.usb_i2c_registers)
+                    cls.usb_elements[device_idx]['machx05_json_regs'] = cls.usb_elements[device_idx]['machx05'].spec
+
+                except Exception as exception:
+                    hlsa_logger(level='warning', ident='Description',
+                                operation='Test Initialization Failure (USB Device Index %d)' % device_idx,
+                                read_value='Exception: %s' % str(exception), result='FAIL')
+
+        cls.monitor_manager = monitor_manager.MonitorManager()
+        cls.dmesg_monitor = cls.monitor_manager.add_monitor(monitor_manager.monitors.DMESG_MONITOR)
+        if cls.mcp_connected:
+            cls.uart_monitor = cls.monitor_manager.add_monitor(monitor_manager.monitors.UART_MONITOR)
+
+        cls.loader_tool_manager = hl_fw_loader_tool.HLFWLoader()
+        cls.device = hw_manager.get_dut_component()
+
+        # Get HL3090 SoC
+        hlsa_logger(level='debug', ident='Description', test_code='EFUSE',
+                    operation='Get HL3090_DIE0_DIE1')
+        cls.hl30900_die_list = [cls.device.get_component(hw_manager.components.HL3090, comp_identifier="DIE0"),
+                                cls.device.get_component(hw_manager.components.HL3090, comp_identifier="DIE1")]
+
+        # cls.hl3090_i2c_soc_registers = [cls.hl30900_die_list[0].get_control(
+        #     hw_manager.controls.usb_i2c_debug_soc_registers), cls.hl30900_die_list[1].get_control(
+        #     hw_manager.controls.usb_i2c_debug_soc_registers)]
+        # cls.hl3090_json_soc_blocks = cls.hl30900_die_list[0].spec
+        cls.hl338_efuse = cls.hl30900_die_list[0].get_component(hw_manager.logic_components.HL338_EFUSE)
+
+        cls.Regex_parser = RegexParser.RegexParser()
+
+    def setup_method(self, method):
+        self.test_name = f'{method.__name__}'.replace('test_', '')
+        if method.__name__ == 'test_update_fw':
+            for device in self.connected_pcie_devices:
+                try:
+                    self.devices_tests_status[device][self.test_name] = False
+                except Exception as exception:
+                    log_manager.log_browser()
+                    hlsa_logger(level='error', ident='Description',
+                                operation=f'Exception during {method.__name__}: {exception}')
+
+        elif method.__name__ == 'test_erom_update':
+            for device in self.connected_pcie_devices:
+                try:
+                    self.devices_tests_status[device][self.test_name] = False
+                except Exception as exception:
+                    log_manager.log_browser()
+                    hlsa_logger(level='error', ident='Description',
+                                operation=f'Exception during {method.__name__}: {exception}')
+
+        elif method.__name__ == 'test_erom_validation':
+            for device in self.connected_pcie_devices:
+                try:
+                    self.devices_tests_status[device][self.test_name] = False
+                except Exception as exception:
+                    hlsa_logger(level='error', ident='Description',
+                                operation=f'Exception during {method.__name__}: {exception}')
+
+        elif method.__name__ == 'test_erom_erase':
+            for device in self.connected_pcie_devices:
+                try:
+                    self.devices_tests_status[device][self.test_name] = False
+                except Exception as exception:
+                    log_manager.log_browser()
+                    hlsa_logger(level='error', ident='Description',
+                                operation=f'Exception during {method.__name__}: {exception}')
+
+        elif method.__name__ == 'test_security_enable':
+            for device in self.connected_pcie_devices:
+                try:
+                    self.devices_tests_status[device][self.test_name] = False
+                except Exception as exception:
+                    log_manager.log_browser()
+                    hlsa_logger(level='error', ident='Description',
+                                operation=f'Exception during {method.__name__}: {exception}')
+
+        elif method.__name__ == 'test_bis_compliant_enable':
+            for device in self.connected_pcie_devices:
+                try:
+                    self.devices_tests_status[device][self.test_name] = False
+                except Exception as exception:
+                    log_manager.log_browser()
+                    hlsa_logger(level='error', ident='Description',
+                                operation=f'Exception during {method.__name__}: {exception}')
+
+        elif method.__name__ == 'test_svn_update':
+            for device in self.connected_pcie_devices:
