+                            operation=f'Parser results', dev_address=pci_addr, mezzanine=self.pci_to_mezz[pci_addr],
+                            read_value=f'{res}')
+                for key in self.test_options[self.test_name].keys():
+                    if 'check_' in key and res[key.replace("check_", "")] != {}:
+                        if "regex_search" in self.test_options[self.test_name].keys() and \
+                                self.test_options[self.test_name]["regex_search"]:
+                            value = re.search(str(getattr(getattr(self.test_options, self.test_name), key)),
+                                str(list(res[key.replace("check_", "")].values())[0]["Description"][0]))
+
+                            if value is not None:
+                                read_value = value.string
+                                expected_val = str(getattr(getattr(self.test_options, self.test_name), key))
+                                expected_val = expected_val.replace("\\","")
+                                status = hlsa_checker.check_values_is_equal(read_value, ident='Description', test_code=self.test_code,
+                                                operation=key.replace("check_", ""), dev_address=pci_addr,
+                                                mezzanine=self.pci_to_mezz[pci_addr], fail_log_level=log_level, ignore_assert=True,
+                                                expected_value=expected_val)
+                            else:
+                                expected_val = str(getattr(getattr(self.test_options, self.test_name), key))
+                                status = hlsa_checker.check_value_is_not_none(value, ident='Description',
+                                                test_code=self.test_code, operation=key.replace("check_", ""),
+                                                dev_address=pci_addr, mezzanine=self.pci_to_mezz[pci_addr],
+                                                fail_log_level=log_level, ignore_assert=True,
+                                                expected_value=expected_val)
+
+                        else:
+                            status = hlsa_checker.check_values_is_equal(expected_value=str(
+                                getattr(getattr(self.test_options, self.test_name), key)),
+                                read_value=str(list(res[key.replace("check_", "")].values())[0]["Description"][0]),
+                                ident='Value', test_code=self.test_code, dev_address=pci_addr, mezzanine=self.pci_to_mezz[pci_addr],
+                                operation=f'{key.replace("check_", "")}', ignore_assert=True)
+
+                        if not status and log_level == 'error':
+                            return_method = False
+                        #     log_manager.update_status_false(self.pci_to_mezz_log_format[pci_addr])
+                        #     self.devices_tests_status[pci_addr][self.test_name] = False
+
+        except Exception as exception:
+            hlsa_logger(level='info', ident='Description',
+                        operation=f'Exception during regex parser: {str(exception)}')
+            return_method = False
+
+        return return_method
