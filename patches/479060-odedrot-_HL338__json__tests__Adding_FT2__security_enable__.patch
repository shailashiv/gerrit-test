+                                                                   ignore_assert=True, units='String')
+                                if field_name in efuse_definition_missing:
+                                    efuse_definition_missing.remove(field_name)
+                                if expected_value != read_value:
+                                    self.devices_tests_status[pci_addr][self.test_name]= False
+                    except Exception as exception:
+                        self.devices_tests_status[pci_addr][self.test_name] = False
+                        hlsa_logger(level='error', ident='Description', test_code=self.test_code,
+                                    operation=f'An exception occurred in field: {field_name}',
+                                    read_value=exception, dev_address=pci_addr)
+                for missing_field in efuse_definition_missing:
+                    hlsa_logger(level='ERROR', ident='Description', test_code=self.test_code,
+                                dev_address=pci_addr, operation='missing field',
+                                read_value=missing_field)
+                    self.devices_tests_status[pci_addr][self.test_name] = False
+            else:
+                hlsa_logger(level='error', ident='Description', test_code=self.test_code,
+                                 operation="efuse_content or efuse_definition are empty", result='FAIL')
+                self.devices_tests_status[pci_addr][self.test_name] = False
+
