+    def convert_string_to_hex(self, pci_addr, field_name, input_string):
+        # pci_addr = self.devices[device_idx]['short_pci_address']
+        log_manager.log_browser(self.pci_to_mezz_log_format[pci_addr])
+        try:
+            input_string = str(input_string)
+            if input_string.startswith("0x"):
+                return f'0x{input_string[2:].lstrip("0") or "0"}'
+            elif input_string.startswith("0b"):
+                return hex(int(input_string, 2))
+            elif input_string.isdigit():
+                return hex(int(input_string))
+            else:
+                return '0x'+''.join([hex(ord(char))[2:] for char in input_string])
+        except Exception as exception:
+            hlsa_logger(level='error', ident='Description', test_code=self.test_code,
+                        operation=f'Exception during converting ({field_name}) from string to decimal',
+                        read_value=input_string, dev_address=pci_addr)
+            hlsa_logger(level='error', dev_address=pci_addr, ident='Description',
+                        test_code=self.test_code, operation=f'Exception', read_value=exception)
+            self.devices_tests_status[pci_addr][self.test_name] = False
+
+    def convert_hex_to_binary(self, pci_addr, hex_list):
+        # pci_addr = self.devices[device_idx]['short_pci_address']
+        log_manager.log_browser(self.pci_to_mezz_log_format[pci_addr])
+        try:
+            return [format(int(hex_val, 16), '0{}b'.format(len(hex_val.replace('0x', '')) * 4))[::-1] for hex_val in hex_list]
+        except Exception as exception:
+            hlsa_logger(level='error', ident='Description', test_code=self.test_code,
+                        operation='Exception while converting from hex to binary',
+                        read_value=hex_list, dev_address=pci_addr)
+            hlsa_logger(level='error', dev_address=pci_addr, ident='Description',
+                        test_code=self.test_code, operation=f'Exception', read_value=exception)
+            self.devices_tests_status[pci_addr][self.test_name] = False
+            return []
+
+    def convert_binary_to_ascii(self, pci_addr, field_name, binary_string):
+        # pci_addr = self.devices[device_idx]['short_pci_address']
+        log_manager.log_browser(self.pci_to_mezz_log_format[pci_addr])
+        try:
+            binary_string = binary_string.replace("0b", "")
+            assci_string = ''.join(chr(int(binary_string[i:i + 8], 2)) for i in range(0, len(binary_string), 8))
+            if not assci_string.isalnum():
+                raise ValueError("the ASCII string not alphanumeric")
+            return assci_string
+        except Exception as exception:
+            hlsa_logger(level='error', ident='Description', test_code=self.test_code, result='FAIL',
+                        operation=f'Exception during converting ({field_name}) from binary to ASCII',
+                        read_value=binary_string, dev_address=pci_addr)
+            hlsa_logger(level='error', dev_address=pci_addr, ident='Description', result='FAIL',
+                        test_code=self.test_code, operation=f'Exception', read_value=exception)
+            self.devices_tests_status[pci_addr][self.test_name] = False
+            return ""
