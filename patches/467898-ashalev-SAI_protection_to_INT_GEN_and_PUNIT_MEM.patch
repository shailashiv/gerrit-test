From ac1fa7cdb1534026d9ce7d4eebcde4126ac930bc Mon Sep 17 00:00:00 2001
From: Amit Shalev <ashalev@habana.ai>
Date: Mon, 30 Dec 2024 11:42:46 +0200
Subject: [PATCH] SAI protection to INT_GEN and PUNIT_MEM

Change-Id: Ic124bfa9b0a2241fef9b37ab7746d5c8b7db6c6c
---

diff --git a/prototypes/m2w_int_gen.xml b/prototypes/m2w_int_gen.xml
index 46b8fb6..9dc1c5b 100644
--- a/prototypes/m2w_int_gen.xml
+++ b/prototypes/m2w_int_gen.xml
@@ -23,4 +23,5 @@
     <BRIEF_DESCRIPTION></BRIEF_DESCRIPTION>
     <DESCRIPTION></DESCRIPTION>
   </REGISTER>
+  <SUBBLOCK ADDR="18" EXTERNAL="" NAME="SPECIAL" PROTOTYPE="SPECIAL_REGS" RTL_PATH="" />
 </BLOCK_DB>
diff --git a/prototypes/punit.xml b/prototypes/punit.xml
index 47e2225..afef2c6 100644
--- a/prototypes/punit.xml
+++ b/prototypes/punit.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="ISO-8859-1"?>
 <BLOCK_DB>
-  <CONFIG ADD_QMAN_EXT_IF="" MEM_NUM="" OWNER="igeorgy" PROTOTYPE_SIZE="4" PT_TYPE="UNIT" />
+  <CONFIG ADD_QMAN_EXT_IF="" GEN_ZERO_REGS="" MEM_NUM="" OWNER="igeorgy" PROTOTYPE_SIZE="4" PT_TYPE="UNIT" />
   <DESCRIPTION>Punit communication registers</DESCRIPTION>
   <INTERRUPT ADDR="C00" INT_TYPE="SPI" NAME="REGION_HIT">
     <CAUSE HW_VALID="" INDEX="0" LKD="" NAME="R0" RESET="" SEVERITY="" SW_VALID="">
@@ -108,5 +108,21 @@
       <DESCRIPTION></DESCRIPTION>
     </FIELD>
   </REGISTER>
+  <REGISTER ACCESS_TYPE="rw" ADDR_OFFSET="804" COLD_RST="" COPIES_NUM="" DIS_RD_CHK="" DIS_WR_CHK="" EXT_REG="" GEN_TRIG="" NAME="MEM_SAI_PROT" PRIVILEGE="" RESET_PARAM="" SECURED="" VISIBLE="">
+    <BRIEF_DESCRIPTION>PUNIT_MEM SAI PROT </BRIEF_DESCRIPTION>
+    <DESCRIPTION></DESCRIPTION>
+    <FIELD ACCESS_TYPE="ro" ASYNC_RESET="" DIS_EXT_IF_WR="" NAME="VAL" RECONF="" RESET_VAL="FFFFFFFF" START_BIT_OFFSET="0" WIDTH="32">
+      <BRIEF_DESCRIPTION></BRIEF_DESCRIPTION>
+      <DESCRIPTION></DESCRIPTION>
+    </FIELD>
+  </REGISTER>
+  <REGISTER ACCESS_TYPE="rw" ADDR_OFFSET="808" COLD_RST="" COPIES_NUM="" DIS_RD_CHK="" DIS_WR_CHK="" EXT_REG="" GEN_TRIG="" NAME="MEM_SAI_ERR" PRIVILEGE="" RESET_PARAM="" SECURED="" VISIBLE="">
+    <BRIEF_DESCRIPTION>PUNIT_MEM SAI ERR RESP</BRIEF_DESCRIPTION>
+    <DESCRIPTION></DESCRIPTION>
+    <FIELD ACCESS_TYPE="ro" ASYNC_RESET="" DIS_EXT_IF_WR="" NAME="VAL" RECONF="" RESET_VAL="1" START_BIT_OFFSET="0" WIDTH="1">
+      <BRIEF_DESCRIPTION></BRIEF_DESCRIPTION>
+      <DESCRIPTION></DESCRIPTION>
+    </FIELD>
+  </REGISTER>
   <SUBBLOCK ADDR="E00" EXTERNAL="" NAME="SPECIAL" PROTOTYPE="SPECIAL_REGS" RTL_PATH="" />
 </BLOCK_DB>
