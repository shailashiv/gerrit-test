+#define SHA_SUM_LEN			SHA384_SUM_LEN
+#define SHA_DER_LEN			SHA384_DER_LEN
+#define SHA_DER_PRE			sha384_der_prefix
+#define FIT_SHA				"sha384"
+#define FIT_ALGO_PROP_EXPECTED_VALUE	"sha384,rsa3072"
+
+#define RSA2048_BYTES			(2048 / 8)
+#define RSA3072_BYTES			(3072 / 8)
+#define RSA4096_BYTES			(4096 / 8)
+
+extern const uint8_t sha384_der_prefix[SHA384_DER_LEN];
+
+void sha_csum(const unsigned char *input, unsigned int ilen,
+		unsigned char *output);
+
+void sha_csum_regions(const struct image_region region[], int region_count,
+			u8 *output);
