-const void *get_public_key(const void *fit, int noffset);
 int fit_decompress_image(uint64_t dst, const void *buf, int len,
 		const char *cmpr, uint32_t max_dst_size);
-int fit_get_key_prop(const void *pub_key_fit, const char *key_name, struct key_prop *prop);
