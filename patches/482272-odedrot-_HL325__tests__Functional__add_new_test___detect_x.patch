+        manf_mode_value = cls.usb_elements[device_idx]['oam_controller'].get_signal(cls.manf_mode_signal)
+        hlsa_checker.check_value_is_not_none(manf_mode_value, ident='Value', test_code=test_code,
+                                             operation='Manf_Mode Signal After Change')
+
+        if manf_mode_value == cls.manf_mode_value_to_set and module_id_value == cls.module_id_value_to_set:
+            hlsa_logger(level='info', ident='Description', test_code=test_code,
+                        operation=f'Card On Manf Mode Debug State {rma_mode}', result='SUCCESS')
+            return True
+        else:
+            hlsa_logger(level='error', ident='Description', test_code=test_code,
+                        operation='Card Not On Manf Mode Debug State', result='FAIL')
+            return False
