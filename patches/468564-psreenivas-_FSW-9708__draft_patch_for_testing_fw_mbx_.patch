diff --git a/drivers/ipm/ipm_fs_fw.h b/drivers/ipm/ipm_fs_fw.h
new file mode 100644
index 0000000..91af4cf
--- /dev/null
+++ b/drivers/ipm/ipm_fs_fw.h
@@ -0,0 +1,35 @@
+#include <hl_platform_defs.h>
+
+#include <zephyr/logging/log.h>
+
+#define LOG_ERR_LOCAL(...)		LOG_INST_ERR(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_WRN_LOCAL(...)		LOG_INST_WRN(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_INF_LOCAL(...)		LOG_INST_INF(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_DBG_LOCAL(...)		LOG_INST_DBG(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_HEXDUMP_ERR_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_ERR(DEV_CFG(dev)->log, _data, _length, _str)
+#define LOG_HEXDUMP_WRN_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_WRN(DEV_CFG(dev)->log, _data, _length, _str)
+#define LOG_HEXDUMP_INF_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_INF(DEV_CFG(dev)->log, _data, _length, _str)
+#define LOG_HEXDUMP_DBG_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_DBG(DEV_CFG(dev)->log, _data, _length, _str)
+
+struct fs_fw_config {
+	uint32_t cfg_base;
+	uint32_t intr_mask;
+	uint8_t mbx_idx;
+	uint8_t mask_idx;
+
+	LOG_INSTANCE_PTR_DECLARE(log);
+};
+
+struct fs_fw_data {
+	fs_fw_callback_t callback;
+	const struct device *shared_irq_dev;
+};
+#define DEV_CFG(dev) \
+	((struct fs_fw_config *)(dev->config))
+
+#define DEV_DATA(dev) \
+	((struct fs_fw_data * const)(dev->data))
diff --git a/drivers/ipm/ipm_fs_fw_mbx.c b/drivers/ipm/ipm_fs_fw_mbx.c
new file mode 100644
index 0000000..8d4a1a9
--- /dev/null
+++ b/drivers/ipm/ipm_fs_fw_mbx.c
@@ -0,0 +1,100 @@
+/*
+ * Copyright (c) 2024 Habanalabs
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#define DT_DRV_COMPAT		intel_fs_fw_mbx
+#include <zephyr/device.h>
+#include <soc/intel/gpu/fs1/soc.h>
+#include <zephyr/shared_irq.h>
+
+#include <zephyr/logging/log.h>
+#include <ipm_fs_fw.h>
+#include "ipm_fs_fw.h"
+#include <psoc_fw_mailbox_regs.h>
+
+#define LOG_MODULE_NAME		fs_fw_mbx
+LOG_MODULE_REGISTER(LOG_MODULE_NAME, CONFIG_IPM_LOG_LEVEL);
+
+static void fs_fw_isr(const struct device *dev)
+{
+	const struct fs_fw_config *config = DEV_CFG(dev);
+	struct fs_fw_data *data = DEV_DATA(dev);
+	uint32_t cause = (config->cfg_base + mmPSOC_FW_MAILBOX_INTR_SPI_CAUSE_MAILBOX_WR);
+	uint32_t status = sys_read32((mem_addr_t)(cause)) & BIT(config->mbx_idx);
+	uint32_t value = sys_read32((mem_addr_t)config->cfg_base);
+
+	if (!status) {
+		LOG_DBG("Interrupt does not belong to dev %p", dev);
+		return;
+	}
+
+	if (data->callback)
+		data->callback(dev, config->mbx_idx, value);
+	sys_write32(BIT(config->mbx_idx), (mem_addr_t)cause);
+}
+
+static void fs_fw_register_callback(const struct device *dev, fs_fw_callback_t cb)
+{
+	struct fs_fw_data *data = dev->data;
+
+	data->callback = cb;
+}
+
+static int fs_fw_irq_init(const struct device *dev)
+{
+	const struct fs_fw_config *config = DEV_CFG(dev);
+	struct fs_fw_data *const data = DEV_DATA(dev);
+	uint32_t val = sys_read32((mem_addr_t) config->intr_mask);
+
+	data->shared_irq_dev = device_get_binding(DT_LABEL(DT_NODELABEL(sw_malibox_irq)));
+	if (!data->shared_irq_dev) {
+		LOG_ERR("Failed to get sw_malibox_irq device binding");
+		return -ENODEV;
+	}
+
+	/* Register for interrupt */
+	shared_irq_isr_register(data->shared_irq_dev, (isr_t)fs_fw_isr, dev);
+	/* Unmask the psoc interrupt */
+	val &= ~BIT(config->mask_idx);
+	sys_write32(val, config->intr_mask);
+	/* Enable the psoc interrupt */
+	shared_irq_enable(data->shared_irq_dev, dev);
+
+	LOG_INF("FW Mbx idx %u", config->mbx_idx);
+	return 0;
+}
+
+static int fs_fw_init(const struct device *dev)
+{
+	LOG_INF("FS FW mbx comms dev %p enumeration start", dev);
+
+	fs_fw_irq_init(dev);
+
+	LOG_INF("FS FW mbx comms dev %p enumeration end", dev);
+
+	return 0;
+}
+
+static const struct fs_fw_driver_api fw_drv_api = {
+	.register_callback = fs_fw_register_callback
+};
+
+#define CREATE_FS_FW_DEVICE(inst)								\
+	static const struct fs_fw_config fs_fw_##inst##_config	= {			\
+		.cfg_base = DT_REG_ADDR_BY_NAME(DT_INST(inst, intel_fs_fw_mbx), cfg),\
+		.mbx_idx = ((DT_REG_ADDR_BY_NAME(DT_INST(inst, intel_fs_fw_mbx), cfg) & 0xFF) / 4),\
+		.intr_mask = (uint32_t) DT_INST_REG_ADDR_BY_NAME(inst, intr_mask),		\
+		.mask_idx = (uint8_t) DT_INST_PROP(inst, mask_idx),				\
+	};											\
+	static struct fs_fw_data fs_fw_##inst##_data;					\
+												\
+	DEVICE_DT_INST_DEFINE(inst, &fs_fw_init,						\
+				NULL,								\
+				&fs_fw_##inst##_data,					\
+				&fs_fw_##inst##_config, POST_KERNEL,			\
+				CONFIG_SHARED_IRQ_INIT_PRIORITY,				\
+				&fw_drv_api);						\
+												\
+
+DT_INST_FOREACH_STATUS_OKAY(CREATE_FS_FW_DEVICE)
