-int get_data_and_size_from_fit(const void *fit, int node_offset,
-				const void **data, size_t *size)
-{
-	bool external_data = false;
-	int offset;
-	int len;
-	int ret_val = 0;
-	const fdt32_t *val;
-
-	val = fdt_getprop(fit, node_offset, FIT_DATA_POSITION_PROP, NULL);
-	if (val != 0) {
-		offset	= fdt32_to_cpu(*val);
-		external_data = true;
-	} else {
-		val = fdt_getprop(fit, node_offset, FIT_DATA_OFFSET_PROP, NULL);
-		if (val != 0) {
-			offset	= fdt32_to_cpu(*val);
-			external_data = true;
-			/*
-			 * For FIT with external data, figure out where
-			 * the external images start. This is the base
-			 * for the data-offset properties in each image.
-			 */
-			offset += ((fdt_totalsize(fit) + 3) & ~3);
-		} else {
-			ret_val = -1;
-		}
-	}
-	if (external_data == true) {
-
-		val = fdt_getprop(fit, node_offset, FIT_DATA_SIZE_PROP, NULL);
-		if (val != 0) {
-			len = fdt32_to_cpu(*val);
-			*data = (void *)((uint8_t *)fit + offset);
-			*size = len;
-		} else {
-			ret_val = -1;
-		}
-	} else {
-		*data = fdt_getprop(fit, node_offset, FIT_DATA_PROP, &len);
-		if (*data == NULL) {
-			fit_get_debug(fit, node_offset, FIT_DATA_PROP, len);
-			*size = 0;
-			ret_val = -1;
-		} else {
-			*size = len;
-			ret_val = 0;
-		}
-	}
-
-	return ret_val;
 }
 
