-/**
- * fit_image_get_node - get node offset for component image of a given unit name
- * @fit: pointer to the FIT format image header
- * @image_uname: component image node unit name
- *
- * fit_image_get_node() finds a component image (within the '/images'
- * node) of a provided unit name. If image is found its node offset is
- * returned to the caller.
- *
- * returns:
- *     image node offset when found (>=0)
- *     negative number on failure (FDT_ERR_* code)
- */
-int fit_image_get_node(const void *fit, const char *image_uname)
-{
-	int noffset, images_noffset;
-
-	images_noffset = fdt_path_offset(fit, FIT_IMAGES_PATH);
-	if (images_noffset < 0) {
-		LOG_ERR("Can't find images parent node '%s' (%s)\n",
-		      FIT_IMAGES_PATH, fdt_strerror(images_noffset));
-		return images_noffset;
-	}
-
-	noffset = fdt_subnode_offset(fit, images_noffset, image_uname);
-	if (noffset < 0) {
-		LOG_ERR("Can't get node offset for image unit name: '%s'(%s)\n",
-		      image_uname, fdt_strerror(noffset));
-	}
-
-	return noffset;
-}
-
-/*
- * fit_get_data_from_image() finds data property in a given image node.
- *
- * returns:
- *     0, on success
- *     -1, on failure
- */
-int fit_get_data_from_image(const void *fit, int node_off,
-		const void **data, size_t *size)
-{
-	int len;
-
-	*data = fdt_getprop(fit, node_off, FIT_DATA_PROP, &len);
-	if (*data == NULL) {
-		LOG_ERR("Can't get '%s' property from FIT 0x%08lx, offset: %d",
-				FIT_DATA_PROP, (unsigned long)fit, node_off);
-		*size = 0;
-		return -1;
-	}
-
-	*size = len;
-	return 0;
-}
-
-int fit_get_property_from_image(const void *fit, int node_off, const char *property,
-		const void **data, size_t *size)
-{
-	int len;
-
-	*data = fdt_getprop(fit, node_off, property, &len);
-	if (*data == NULL) {
-		LOG_ERR("Can't get '%s' property from FIT 0x%08lx, offset: %d",
-				property, (unsigned long)fit, node_off);
-		*size = 0;
-		return -1;
-	}
-
-	*size = len;
-	return 0;
-}
-
-/*
- * fit_find_load_addr_image() finds load address property in a given component
- * image node. If the property is found, its value is returned to the caller.
- *
- * returns:
- *     0, on success
- *     -1, on failure
- */
-int fit_find_load_addr_image(const void *fit, int node_off,
-				unsigned long *load)
-{
-	int len, cell_len;
-	const fdt32_t *cell;
-	uint64_t load64 = 0;
-
-	cell = fdt_getprop(fit, node_off, FIT_LOAD_PROP, &len);
-	if (cell == NULL) {
-		LOG_ERR("Can't get %s property from FIT 0x%08lx node_off:%d",
-				FIT_LOAD_PROP, (unsigned long)fit, node_off);
-		return -1;
-	}
-
-	if (len > sizeof(unsigned long)) {
-		LOG_ERR("Error: %s address size", FIT_LOAD_PROP);
-		return -1;
-	}
-
-	cell_len = len >> 2;
-	while (cell_len--) {
-		load64 = (load64 << 32) | uimage_to_cpu(*cell);
-		cell++;
-	}
-	*load = (unsigned long)load64;
-	return 0;
-}
-
-int fit_get_prop_node_index(const void *fit, int node_off,
-		const char *prop_name, int index)
-{
-	const char *uname;
-	int len;
-
-	uname = fdt_stringlist_get(fit, node_off, prop_name, index, &len);
-	if (uname == NULL)
-		return len;
-
-	return fit_image_get_node(fit, uname);
-}
-
-int fit_get_node_from_conf(const void *fit, const char *conf_uname)
-{
-	int node_off, confs_node_off;
-	int len;
-	const char *s;
-	char *conf_uname_copy = NULL;
-
-	confs_node_off = fdt_path_offset(fit, FIT_CONFS_PATH);
-	if (confs_node_off < 0) {
-		LOG_ERR("Can't find configurations parent node '%s'",
-		      FIT_CONFS_PATH);
-		return confs_node_off;
-	}
-
-	if (conf_uname == NULL) {
-		/* get configuration unit name from the default property */
-		LOG_INF("No configuration specified, trying default...");
-		conf_uname = (char *)fdt_getprop(fit, confs_node_off,
-						 FIT_DEFAULT_PROP, &len);
-		if (conf_uname == NULL) {
-			LOG_ERR("Can't get %s property 0x%08lx node_off:%d",
-					FIT_DEFAULT_PROP,
-					(unsigned long)fit, confs_node_off);
-			return len;
-		}
-		LOG_INF("Found default configuration: '%s'\n", conf_uname);
-	}
-
-	s = strchr(conf_uname, '#');
-	if (s) {
-		len = s - conf_uname;
-		conf_uname_copy = malloc(len + 1);
-		if (!conf_uname_copy)
-			return -ENOMEM;
-
-		memcpy(conf_uname_copy, conf_uname, len);
-		conf_uname_copy[len] = '\0';
-		conf_uname = conf_uname_copy;
-	}
-
-	node_off = fdt_subnode_offset(fit, confs_node_off, conf_uname);
-	if (node_off < 0) {
-		LOG_ERR("Can't get node offset for conf unit name:'%s' (%s)\n",
-		      conf_uname, fdt_strerror(node_off));
-	}
-
-	if (conf_uname_copy)
-		free(conf_uname_copy);
-
-	return node_off;
-}
-
-int fit_check_format(const void *fit)
-{
-	int ret = fdt_check_header(fit);
-
-	if (ret) {
-		LOG_ERR("FIT header check failed..:%d\n", ret);
-		goto error;
-	}
-
-	/* mandatory / node 'description' property */
-	if (fdt_getprop(fit, 0, FIT_DESC_PROP, NULL) == NULL) {
-		LOG_ERR("Wrong FIT format: no description\n");
-		goto error;
-	}
-
-	/* mandatory subimages parent '/images' node */
-	if (fdt_path_offset(fit, FIT_IMAGES_PATH) < 0) {
-		LOG_ERR("Wrong FIT format: no images parent node\n");
-		goto error;
-	}
-
-	return 1;
-
-error:
-	fit_set_err(HL_FW_FIT_BOOT_ERR_CORRUPTED);
-	return 0;
-}
