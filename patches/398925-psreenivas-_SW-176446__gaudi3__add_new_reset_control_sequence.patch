From b57e26a7ff3903f66270b9baba404d42b703a2c0 Mon Sep 17 00:00:00 2001
From: Pavan S <psreenivas@habana.ai>
Date: Mon, 04 Mar 2024 11:37:43 +0200
Subject: [PATCH] [SW-176446] gaudi3: add new reset control sequence

This patch adds new reset sequence in soc init which
will be called by arcmgmt in hw init. The new reset
sequence is as per the embedded PRM.

Signed-off-by: Pavan S <psreenivas@habana.ai>
Change-Id: I7bfc18e5fe035fd69782aa868d46835408d46347
---

diff --git a/include/gaudi3/hl_noc_cfg_defs.h b/include/gaudi3/hl_noc_cfg_defs.h
index fa83c38..51a37f6 100644
--- a/include/gaudi3/hl_noc_cfg_defs.h
+++ b/include/gaudi3/hl_noc_cfg_defs.h
@@ -22,5 +22,6 @@
 void gaudi3_init_cache(const struct hl_noc_cfg_info *cfg);
 void gaudi3_init_mc(const struct hl_noc_cfg_info *cfg);
 void gaudi3_init_axiovrd(const struct hl_noc_cfg_info *cfg);
+void gaudi3_rst_ctrl_init(void);
 
 #endif /* NOC_CFG_INCLUDE_GAUDI3_HL_NOC_CFG_DEFS_H_ */
