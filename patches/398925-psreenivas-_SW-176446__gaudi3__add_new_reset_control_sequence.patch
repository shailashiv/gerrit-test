+void gaudi3_rst_ctrl_init(void)
+{
+	uint32_t iter;
+	uint8_t sku = hl_get_sku_type();
+
+	for (iter = 0; iter < ARRAY_SIZE(rst_ctrl); iter++) {
+		CFG_WREG32(D0_PSOC_RESET_CONF_REG(rst_ctrl[iter]), iter);
+		if (sku == HL_DUAL_DIE_SKU)
+			CFG_WREG32(D1_PSOC_RESET_CONF_REG(rst_ctrl[iter]), iter);
+	}
