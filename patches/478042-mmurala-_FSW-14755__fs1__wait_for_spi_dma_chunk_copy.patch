From f9d4a06a0dfb90e618931fa6bf00f7597659482f Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Thu, 24 Apr 2025 06:21:27 +0300
Subject: [PATCH] [FSW-14755] fs1: wait for spi dma chunk copy

At present spi dma status done bit is used to
identify dma copy completed, it is a short pulse
and only useful if we start checking this bit
immediately. In case of just initialize copy and
check its status after some predefined operations
completed, this done was not useful and it may be
cleared before bootrom check for this. So we use
copied count here after.

Change-Id: I5d7d970d1c4bb6c749c9ecb103d9c167280a273b
---

diff --git a/arch/fs1/arc/dev_dma.c b/arch/fs1/arc/dev_dma.c
index 9cdd971..1d4fa66 100644
--- a/arch/fs1/arc/dev_dma.c
+++ b/arch/fs1/arc/dev_dma.c
@@ -13,6 +13,7 @@
 #include <fs1_reg_map.h>
 #include <progress_bits.h>
 #include <dma.h>
+#include <delay.h>
 
 #define DMA_ADDRESS_LOW(x)	((x) & MASK_32_BIT)
 #define DMA_ADDRESS_HIGH(x)	(((x) >> 32) & MASK_32_BIT)
@@ -66,15 +67,24 @@
 		      IO0_H0_PSOC_PARC_CFG_MISC_BASE(mmPARC_GLOBAL_CONF_SPI_DMA_CTRL));
 }
 
-uint32_t dma_wait_finish(void)
+enum dma_error dma_wait_finish(uint32_t size)
 {
-	uint32_t reg_spi_dma_status_s = 0;
+	uint32_t reg_spi_dma_status_s = 0, copied = 0;
+	uint64_t start = boot_rom_get_ts_us();
 
 	do {
+		if (boot_rom_timeout_expired(start, SPI_DMA_TIMEOUT_US))
+			return DMA_COPY_TIMEOUT;
+
 		reg_spi_dma_status_s =
 		  regmap_readl(IO0_H0_PSOC_PARC_CFG_MISC_BASE(mmPARC_GLOBAL_CONF_SPI_DMA_STATUS));
-	} while ((reg_spi_dma_status_s & PARC_GLOBAL_CONF_SPI_DMA_STATUS_DONE_M) == 0);
 
-	/* TODO: implement timeout for 64KB data chunk */
-	return (reg_spi_dma_status_s & PARC_GLOBAL_CONF_SPI_DMA_STATUS_ERROR_M);
+		copied = ((reg_spi_dma_status_s & PARC_GLOBAL_CONF_SPI_DMA_STATUS_COPIED_M) >>
+			PARC_GLOBAL_CONF_SPI_DMA_STATUS_COPIED_S) * DMA_DST_BLOCK_SIZE;
+	} while(copied != size);
+
+	if ((reg_spi_dma_status_s & PARC_GLOBAL_CONF_SPI_DMA_STATUS_ERROR_M) != 0)
+		return DMA_INVALID_CRC_ERROR;
+
+	return DMA_SUCCESS;
 }
