diff --git a/common/dma.c b/common/dma.c
index 9a7b4bb..4027c89 100644
--- a/common/dma.c
+++ b/common/dma.c
@@ -26,6 +26,8 @@
 		else if (err == DMA_INVALID_FLASH_OFFSET)
 			boot_rom_status_update_bringup(dma_sts_base,
 						       PROGRESS_DMA_INVALID_FLASH_OFFSET);
+		else if (err == DMA_COPY_TIMEOUT)
+			boot_rom_status_update_bringup(dma_sts_base, PROGRESS_DMA_COPY_TIMEOUT);
 		else
 			boot_rom_status_update_bringup(dma_sts_base, PROGRESS_DMA_ERROR);
 		return 1;
@@ -85,9 +87,14 @@
 		copy_size -= dma_size;
 
 		if (wait) {
-			ret = dma_wait_finish();
-			if ((mask_crc_err == 0) && (ret == PARC_GLOBAL_CONF_SPI_DMA_STATUS_ERROR_M)) {
-				return DMA_INVALID_CRC_ERROR;
+			ret = dma_wait_finish(dma_size);
+			if (ret != DMA_SUCCESS) {
+				if (ret == DMA_INVALID_CRC_ERROR) {
+					if (mask_crc_err == 0) {
+						return DMA_INVALID_CRC_ERROR;
+					}
+				} else
+					return ret;
 			}
 		} else {
 			/* background spi dma copy */
