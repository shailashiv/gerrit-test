 export ZEPHYR_CONF_DEV_EXTRA_CFLAGS += -I$(SPECS_EMB_PROJ_DIR)/common
 export ZEPHYR_CONF_DEV_EXTRA_CFLAGS += -I$(SPECS_EMB_PROJ_DIR)/$(DEV_PREFIX)
