From 0fdf76de3dd6e110a5947deacfe5facc51a5693d Mon Sep 17 00:00:00 2001
From: Witold Netel <wnetel@habana.ai>
Date: Thu, 10 Apr 2025 11:15:43 +0300
Subject: [PATCH] [SW-225024] Docker: TC3-PT, python alternative

to point to default python3 (3.10)

Change-Id: I6f0a96d16abd8ee087893cc548bad4e058d6f4c0
Signed-off-by: Witold Netel <wnetel@habana.ai>
---

diff --git a/dockerfiles/pytorch/Dockerfile.tencentos3.1 b/dockerfiles/pytorch/Dockerfile.tencentos3.1
index 3a8f2be..093558c 100644
--- a/dockerfiles/pytorch/Dockerfile.tencentos3.1
+++ b/dockerfiles/pytorch/Dockerfile.tencentos3.1
@@ -39,6 +39,8 @@
         zlib-devel && \
     dnf clean all
 
+RUN alternatives --set python /usr/bin/python3
+
 # Variables needed to enable gcc11
 ENV PATH=/opt/rh/gcc-toolset-11/root/usr/bin:${PATH}
 ENV MANPATH=/opt/rh/gcc-toolset-11/root/usr/share/man:${MANPATH}
