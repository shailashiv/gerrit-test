+static void set_instr_dly(uint32_t *instr_dly)
+{
+	switch (hbm_cfg.ck_freq) {
+	case HBM_PLL_1200:
+		instr_dly[0] = 0xbb8;
+		instr_dly[1] = 0x12c;
+		instr_dly[2] = 0x96;
+		break;
+
+	case HBM_PLL_1600:
+		instr_dly[0] = 0xfa0;
+		instr_dly[1] = 0x190;
+		instr_dly[2] = 0xc8;
+		break; /* This was missing. any reason? */
+
+	case HBM_PLL_1800:
+	default:
+		instr_dly[0] = 0x1194;
+		instr_dly[1] = 0x1c2;
+		instr_dly[2] = 0xe1;
+		break;
+	}
