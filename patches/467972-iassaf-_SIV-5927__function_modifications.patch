+static int bit_shift (int x){
+	return (1 << x);
+}
+
+static int sign_conversion(unsigned int val){
+	if (val & bit_shift(6))
+		return -(0x1f - (val & ~bit_shift(6)) + 1);
+	else
+		return val;
+}
+#endif
