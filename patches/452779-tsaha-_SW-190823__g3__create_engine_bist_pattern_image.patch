From df839f59bcbd4163de457b6de35e128050066dd6 Mon Sep 17 00:00:00 2001
From: Tamal <tasaha@habana.ai>
Date: Fri, 27 Sep 2024 13:23:24 +0300
Subject: [PATCH] [SW-190823] g3: create engine bist pattern image

This patch creates engine bist pattern.
These patterns are recevied from DFT team.

This patch updates engine setup pattern
in die_engine_mbist_data.txt.
engine_mbist_data.h file

Change-Id: I105e16a9af18439fd7a221a4b11962b230e529ce
Signed-off-by: Tamal <tasaha@habana.ai>
---

diff --git a/board/habanalabs/common/post-image-spi-arc_global.sh b/board/habanalabs/common/post-image-spi-arc_global.sh
index 0d730de..641d688 100755
--- a/board/habanalabs/common/post-image-spi-arc_global.sh
+++ b/board/habanalabs/common/post-image-spi-arc_global.sh
@@ -490,7 +490,6 @@
 	swap_file ${BINS_DIR}/${DEV_PREFIX}-ppboot-pcie_phy_fw.bin.le ${BINS_DIR}/${DEV_PREFIX}-ppboot-pcie_phy_fw.bin.be
 	swap_file ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.le ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.be
 	swap_file ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.le ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.be
-	swap_file ${BINS_DIR}/${DEV_PREFIX}-sram-mbist-data.bin.le ${BINS_DIR}/${DEV_PREFIX}-sram-mbist-data.bin.be
 
 	calc_image_ptrs_sha384 ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.be
 
diff --git a/board/habanalabs/gaudi3_arc/agent-fw_loader.its b/board/habanalabs/gaudi3_arc/agent-fw_loader.its
index 5596615..4b0e7e1 100644
--- a/board/habanalabs/gaudi3_arc/agent-fw_loader.its
+++ b/board/habanalabs/gaudi3_arc/agent-fw_loader.its
@@ -40,5 +40,17 @@
 				algo = "sha384";
 			};
 		};
+
+		engine_mbist_data {
+			description = "Habana Engine MBIST DATA content for preboot";
+			data = /incbin/("gaudi3-engine-mbist-data.bin.be");
+			type = "standalone";
+			arch = "arc";
+			compression = "@HL_COMPRESS@";
+			offset = <0x00164000>;
+			hash {
+				algo = "sha384";
+			};
+		};
 	};
 };
