From 782a02fbb88f22aa8688348529d04425a18ac40e Mon Sep 17 00:00:00 2001
From: Alexey Nikandrov <anikandrov@habana.ai>
Date: Tue, 15 Oct 2024 09:41:23 +0300
Subject: [PATCH] [SW-203620] installer: ubuntu - fixed installer errors

Change-Id: I64e90d528bc3f99cc880b53b27b727e9c4b6848c
Signed-off-by: Alexey Nikandrov <anikandrov@habana.ai>
---

diff --git a/installer/src/lib/common.sh b/installer/src/lib/common.sh
index 00ff3b3..e9c86ff 100644
--- a/installer/src/lib/common.sh
+++ b/installer/src/lib/common.sh
@@ -745,7 +745,7 @@
     case $OS_NAME in
         "ubuntu")
             ${_SUDO_CMD} ${__pkg__} update
-            ${_SUDO_CMD} DEBIAN_FRONTEND=noninteractive ${__pkg__} install -y libmkl-dev
+            ${_SUDO_CMD} env DEBIAN_FRONTEND=noninteractive ${__pkg__} install -y libmkl-dev
         ;;
         "debian")
             echo "deb http://ftp.debian.org/debian buster non-free" | ${_SUDO_CMD} tee -a /etc/apt/sources.list
