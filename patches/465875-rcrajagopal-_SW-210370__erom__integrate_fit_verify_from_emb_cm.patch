@@ -26,6 +26,8 @@
 #include "pll.h"
 #include "fit.h"
 #include <fit_load.h>
+#include <fit_verify.h>
+#include <fit_error.h>
 
 #define WFC_TIMEOUT_MS			500
 #define TIMEOUT_US			1000
