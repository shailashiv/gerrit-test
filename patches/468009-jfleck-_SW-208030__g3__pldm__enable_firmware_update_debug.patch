From 143c6eb99d6848868b3c32a1053390cd1423bc86 Mon Sep 17 00:00:00 2001
From: John Fleck <jfleck@habana.ai>
Date: Mon, 30 Dec 2024 18:07:57 +0200
Subject: [PATCH] [SW-208030] g3: pldm: enable firmware update debug

Enable force firmware update for internal validation

Change-Id: I219d8d3c76f8ace9df677af18ad3de7cdf9b3448
Signed-off-by: John Fleck <jfleck@habana.ai>
---

diff --git a/src/pldm_fu.c b/src/pldm_fu.c
index 7769953..11c2550 100644
--- a/src/pldm_fu.c
+++ b/src/pldm_fu.c
@@ -50,15 +50,15 @@
 /* Options that override the version stamp in the request, allowing testing of
  * different code paths.
  */
-#define TESTING_VERSION_STAMP_EQUAL	0
-#define TESTING_VERSION_STAMP_OLDER	0
-#define TESTING_VERSION_STAMP_NEWER	0
+#define TESTING_VERSION_STAMP_EQUAL	1
+#define TESTING_VERSION_STAMP_OLDER	1
+#define TESTING_VERSION_STAMP_NEWER	1
 
 /* Used by the 'OLDER' and 'NEWER' test flags to adjust the version stamp */
 #define TESTING_VERSION_STAMP_DIFF	0x00010100
 
 /* Forces the 'force update' flag to be set, allowing testing of different code paths */
-#define TESTING_FORCE_UPDATE		0
+#define TESTING_FORCE_UPDATE		1
 
 /* DSP0267 Section 6.8: minimum num bytes that can be requested by RequestFirmwareData */
 #define BASELINE_TRANSFER_SIZE	32
