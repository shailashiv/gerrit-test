diff --git a/dts/arc/fs1_pmfw.dtsi b/dts/arc/fs1_pmfw.dtsi
new file mode 100644
index 0000000..2c4a170
--- /dev/null
+++ b/dts/arc/fs1_pmfw.dtsi
@@ -0,0 +1,27 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include "fs1_emb.dtsi"
+
+/ {
+	chosen {
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+	};
+
+	iccm0: iccm@ARC_PMFW_ICCM_OFFSET {
+		device_type = "memory";
+		compatible = "arc,iccm";
+		reg = <PREFIX_0X(ARC_PMFW_ICCM_OFFSET) ARC_PMFW_ICCM_SIZE>;
+	};
+
+	dccm0: dccm@ARC_PMFW_DCCM_OFFSET {
+		device_type = "memory";
+		compatible = "arc,dccm";
+		reg = <PREFIX_0X(ARC_PMFW_DCCM_OFFSET) ARC_PMFW_DCCM_SIZE>;
+	};
+};
