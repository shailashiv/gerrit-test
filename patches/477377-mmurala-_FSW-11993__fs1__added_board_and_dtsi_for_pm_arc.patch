 	bool
 	select SOC_SERIES_FS1
 
+config SOC_FS1_PMFW
+	bool
+	select SOC_SERIES_FS1
+
 config SOC_FS1_AGENT
 	bool
 	select SOC_SERIES_FS1
@@ -52,3 +56,4 @@
 	default "fs1_agent" if SOC_FS1_AGENT
 	default "fs1_preboot" if SOC_FS1_PREBOOT
 	default "fs1_rst" if SOC_FS1_RST
