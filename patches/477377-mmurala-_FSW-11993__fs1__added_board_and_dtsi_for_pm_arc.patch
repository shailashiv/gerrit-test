diff --git a/soc/intel/gpu/fs1/emb/Kconfig.defconfig b/soc/intel/gpu/fs1/emb/Kconfig.defconfig
index bb00d17..6bd0956d 100644
--- a/soc/intel/gpu/fs1/emb/Kconfig.defconfig
+++ b/soc/intel/gpu/fs1/emb/Kconfig.defconfig
@@ -110,6 +110,10 @@
 source "soc/intel/gpu/fs1/emb/Kconfig.defconfig_rst"
 endif #SOC_FS1_RST
 
+if SOC_FS1_PMFW
+source "soc/intel/gpu/fs1/emb/Kconfig.defconfig_pmfw"
+endif #SOC_FS1_PMFW
+
 if SOC_FS1_AGENT
 source "soc/intel/gpu/fs1/emb/Kconfig.defconfig_agent"
 endif #SOC_FS1_AGENT
diff --git a/soc/intel/gpu/fs1/emb/Kconfig.defconfig_pmfw b/soc/intel/gpu/fs1/emb/Kconfig.defconfig_pmfw
new file mode 100644
index 0000000..21ee46d
--- /dev/null
+++ b/soc/intel/gpu/fs1/emb/Kconfig.defconfig_pmfw
@@ -0,0 +1,24 @@
+# Copyright 2024 HabanaLabs, Ltd. All Rights Reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+if SOC_FS1_PMFW
+
+config SOC
+	default "fs1_pmfw"
+
+config HARVARD
+	default y
+
+config NUM_IRQS
+	range 17 255
+	# TODO: Get these numbers for FS1
+	# must be > the highest interrupt number used
+	default 255
+
+config PMFW_RUN_FROM_ICCM
+	default n
+	bool "Run pmfw app from ICCM memory"
+	help
+	  pmfw app is executing from ICCM memory
+
+endif # SOC_FS1_PMFW
