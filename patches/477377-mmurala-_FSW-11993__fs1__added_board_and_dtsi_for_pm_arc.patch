diff --git a/boards/intel/fs/fs1_pmfw_asic.dts b/boards/intel/fs/fs1_pmfw_asic.dts
new file mode 100644
index 0000000..8c6c95f
--- /dev/null
+++ b/boards/intel/fs/fs1_pmfw_asic.dts
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+/dts-v1/;
+
+#include <fs1_pmfw.dtsi>
+
+/ {
+	model = "fs1_pmfw";
+	compatible = "intel,fs1_pmfw";
+
+	chosen {
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+	};
+};
+
+&refclk {
+	clock-frequency = <50000000>;
+};
+
+&uart0 {
+	current-speed = <115200>;
+	status = "okay";
+};
