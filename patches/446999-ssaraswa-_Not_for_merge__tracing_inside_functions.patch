diff --git a/backend/profiling/trace_sources/bridge_logs_source.cpp b/backend/profiling/trace_sources/bridge_logs_source.cpp
index f956ee7..a4115e7 100644
--- a/backend/profiling/trace_sources/bridge_logs_source.cpp
+++ b/backend/profiling/trace_sources/bridge_logs_source.cpp
@@ -37,8 +37,8 @@
 struct BridgeLogsSourceImpl : public TraceSource {
   BridgeLogsSourceImpl() = default;
   ~BridgeLogsSourceImpl() override = default;
-  void log(std::string_view id, bool is_begin) {
-    if (enabled(id)) {
+  void log(std::string_view id, bool is_begin, bool extra_trace) {
+    if (extra_trace or enabled(id)) {
       int64_t dtime = NowMicros();
       pid_t tid = syscall(__NR_gettid);
       std::string event_id{id};
@@ -173,14 +173,14 @@
 }
 
 namespace bridge {
-void trace_start(std::string_view id) {
-  BridgeLogsSourceImpl::instance().log(id, true);
+void trace_start(std::string_view id, bool extra_trace) {
+  BridgeLogsSourceImpl::instance().log(id, true, extra_trace);
 }
-void trace_end(std::string_view id) {
-  BridgeLogsSourceImpl::instance().log(id, false);
+void trace_end(std::string_view id, bool extra_trace) {
+  BridgeLogsSourceImpl::instance().log(id, false, extra_trace);
 }
-bool is_enabled(std::string_view name) {
-  return BridgeLogsSourceImpl::instance().enabled(name);
+bool is_enabled(std::string_view name, bool extra_trace) {
+  return extra_trace or BridgeLogsSourceImpl::instance().enabled(name);
 }
 }; // namespace bridge
 }; // namespace profile
