+          at::Tensor tensor = input.toTensor();
+          ptRefs.push_back(std::move(tensor));
+          inDevPtr.push_back(reinterpret_cast<synapse_helpers::device_ptr>(
+              input.toTensor().storage().data_ptr().get()));
+        }
       }
     }
