From cbc7d8b99fac58b43074b8cee524d354666a4dc6 Mon Sep 17 00:00:00 2001
From: Akshay Pradip Bharad <apbharad@habana.ai>
Date: Mon, 16 Jun 2025 19:53:45 +0300
Subject: [PATCH] [SW-0] make unmask response ndata

Change-Id: I5124180aa7bb4dd52e3ce66617383cd463a21180
Signed-off-by: Akshay Pradip Bharad <apbharad@habana.ai>
---

diff --git a/src/gaudi3/dev.c b/src/gaudi3/dev.c
index f8ab932..6280cf5 100644
--- a/src/gaudi3/dev.c
+++ b/src/gaudi3/dev.c
@@ -73,13 +73,13 @@
 
 static void hl_mbx_send_reply(const struct device *dev,
 			      struct mbx_msg_id mbx_msg_id,
-			      uint32_t *data)
+			      uint32_t *data, uint32_t size)
 {
 	uint8_t i;
 	int ret;
 
 	for (i = 0; i < EVENT_IPM_RETRIES; i++) {
-		ret = ipm_send(dev, 0, mbx_msg_id.u32, data, sizeof(int));
+		ret = ipm_send(dev, 0, mbx_msg_id.u32, data, size);
 
 		if (ret == 0) {
 			/* Success */
@@ -192,6 +192,7 @@
 	uint32_t event_id;
 	uint8_t i;
 	int key;
+	uint32_t size = sizeof(reply_data);
 
 	switch (mbx_msg_id.common.msg_id) {
 	case HL_MBX_MSG_START_OPS:
@@ -211,6 +212,9 @@
 	case HL_MBX_MSG_UNMASK_EVENT:
 		event_id = *((uint32_t *)data);
 		reply_data = gaudi3_process_interrupt(config, event_id, HL_UNMASK_INTR);
+		if (!reply_data)
+			reply = true;
+		size = 0;
 		break;
 	default:
 		msg_handled = false;
@@ -222,7 +226,7 @@
 		ipm_clear(config->mbx.hl_mbx_dev, mbx_msg_id.u32);
 
 		if (reply)
-			hl_mbx_send_reply(config->mbx.hl_mbx_dev, mbx_msg_id, &reply_data);
+			hl_mbx_send_reply(config->mbx.hl_mbx_dev, mbx_msg_id, &reply_data, size);
 
 		if (!early_reply)
 			return;
@@ -462,7 +466,7 @@
 
 	config->dev_data->stop_ops.pending = false;
 	config->state = HL_EVENT_STOP;
-	hl_mbx_send_reply(config->mbx.hl_mbx_dev, config->dev_data->stop_ops.id, &reply_data);
+	hl_mbx_send_reply(config->mbx.hl_mbx_dev, config->dev_data->stop_ops.id, &reply_data, sizeof(reply_data));
 }
 
 static void notify_bis_and_reset(struct hl_event_config *config)
