+
+void ConstantInformation::InsertRecipeScaleConst(
+    key_t recipe_key,
+    float const_value,
+    size_t input_idx,
+    id_t const_id) {
+  PT_BRIDGE_DEBUG("Albin InsertRecipeScaleConst begin")
+  std::unique_lock lock(checksum_map_mtx_);
+  auto recipe_iterator = recipe_scale_constant_map_.find(recipe_key);
+  scaleInput_t scale_input = get_scale_input_key(const_value, input_idx);
+  if (recipe_iterator == recipe_scale_constant_map_.end()) {
+    auto recipe_value =
+        std::unordered_map<scaleInput_t, std::unordered_set<id_t>>{
+            {scale_input, std::unordered_set<id_t>{const_id}}};
+    recipe_scale_constant_map_.emplace(recipe_key, recipe_value);
+  } else {
+    auto recipe_input_iter = recipe_iterator->second.find(scale_input);
+    if (recipe_input_iter == recipe_iterator->second.end()) {
+      recipe_iterator->second.emplace(
+          scale_input, std::unordered_set<id_t>{const_id});
+    } else {
+      auto& const_id_set = recipe_input_iter->second;
+      if (const_id_set.find(const_id) == const_id_set.end()) {
+        const_id_set.insert(const_id);
+      } else {
+        PT_BRIDGE_DEBUG(
+            "Recipe ",
+            recipe_key,
+            " already contain input value:",
+            const_value,
+            " with index ",
+            input_idx,
+            " and constant id:",
+            const_id);
+      }
+    }
+  }
+  PT_BRIDGE_DEBUG("Albin InsertRecipeScaleConst end")
+}
+
+ConstantInformation::id_t ConstantInformation::GetMatchedConstIdIfScaleConstantExist(key_t recipe_key, id_t const_id, scaleInput_t scale_input) {
+  std::shared_lock lock(checksum_map_mtx_);
+  PT_BRIDGE_DEBUG("Albin GetMatchedConstIdIfScaleConstantExist starts")
+  auto recipe_iterator = recipe_scale_constant_map_.find(recipe_key);
+  auto recipe_input_iter = recipe_iterator->second.find(scale_input);
+  auto const_id_set = recipe_input_iter->second;
+  HABANA_ASSERT(
+      const_id_set.size(),
+      "Const id list is empty for recipe ",
+      recipe_key,
+      " const_id ",
+      const_id);
+  PT_BRIDGE_DEBUG("Albin GetMatchedConstIdIfScaleConstantExist const_id_set size:", const_id_set.size());
+  PT_BRIDGE_DEBUG("Albin GetMatchedConstIdIfScaleConstantExist const_id_set:", const_id_set);
+  if (const_id_set.find(const_id) == const_id_set.end()) {
+    return *(const_id_set.begin());
+  }
+
+  return ConstantInformation::id_t{INT_MAX};
+}
