+void ConstantInformation::CheckAndAddScaleConstIdForRecipe(
+    key_t recipe_key,
+    at::Tensor& pt_tensor,
+    size_t input_idx,
+    id_t const_id) {
+  PT_BRIDGE_DEBUG("Albin CheckAndAddScaleConstIdForRecipe begin")
+  float const_value = pt_tensor.item<float>();
+  PT_BRIDGE_DEBUG("Albin Check for recipe ", recipe_key, " and const id ",
+   const_id, " input_idx ", input_idx, " const_value ", const_value)
+  scaleInput_t scale_input = get_scale_input_key(const_value, input_idx);
+  //std::unique_lock lock(checksum_map_mtx_);
+  auto matched_const_id = GetMatchedConstIdIfScaleConstantExist(recipe_key, const_id, scale_input);
+  PT_BRIDGE_DEBUG("Albin CheckAndAddScaleConstIdForRecipe matched_const_id:", matched_const_id)
+  if (*matched_const_id != INT_MAX) {
+    CreateCopyConstInfo(matched_const_id, const_id, recipe_key, pt_tensor);
+  }
+  for (auto it = id_unused_data_ptr_.begin(); it != id_unused_data_ptr_.end(); ++it) {
+    PT_BRIDGE_DEBUG("id_unused_data_ptr_ key:", it->first, ", value:", it->second.value().get())
+  }
+  PT_BRIDGE_DEBUG("Albin CheckAndAddScaleConstIdForRecipe end")
+}
