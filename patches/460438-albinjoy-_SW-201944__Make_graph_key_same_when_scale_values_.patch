+bool IsConstantScaleTensor(at::Tensor& tensor) {
+  auto tmeta{habana::get_tensor_extra_meta(tensor)};
+  if (tmeta->is_const_tensor() && (tensor.numel() == 1)) {
+    return true;
+  } else {
+    return false;
+  }
