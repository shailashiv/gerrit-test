+CreateCopyConstInfo(id_t from_const_id, id_t to_const_id, key_t recipe_key, at::Tensor& pt_tensor) {
+  PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin")
+  TensorExtraMeta::prepare_const_tensor(pt_tensor, true);
+  auto get_const_info = [&](ConstantInformation::id_t const_id, ConstantInformation::key_t r_key) -> const ConstantInformation::constInfo_t& {
+    std::shared_lock lock(checksum_map_mtx_);
+    auto const_checksum_iterator = const_checksum_map_.find(const_id);
+    HABANA_ASSERT(
+        const_checksum_iterator != const_checksum_map_.end(),
+        "Const id  {} not presented in const_checksum_map_",
+        const_id)
+    // TODO what is the constant id for the specific recipe
+    for (auto& info : const_checksum_iterator->second.infos_) {
+      for (auto& key : info.recipe_key_) {
+        if (key == r_key) {
+          PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo from_const_id:", from_const_id, ", to_const_id:",
+          to_const_id, ", r_key:", r_key, ", info.checksum_:", info.checksum_, ", info.section_size_:", info.section_size_)
+          return info;
+        }
+      }
+    }
+    ConstantInformation::checksum_t checksum{0};
+    ConstantInformation::key_t tmp_key{0};
+    static ConstantInformation::constInfo_t constInfo{checksum, {tmp_key}, 0, {}};
+    return constInfo;
+  };
+
+  const ConstantInformation::constInfo_t& info = get_const_info(from_const_id, recipe_key);
+  checksum_t checksum = info.checksum_;
+  uint64_t section_size = info.section_size_;
+  PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin before allocation")
+  at::DataPtr data =
+      pt_tensor.storage().allocator()->allocate(section_size);
+  auto old_data_ptr = pt_tensor.storage().set_data_ptr(std::move(data));
+  pt_tensor.storage().set_nbytes(section_size);
+  PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin after allocation, old_data_ptr:", old_data_ptr.get(),
+  ", new address:", pt_tensor.data_ptr())
+  // add_unused_ptr(to_const_id, std::move(old_data_ptr));
+  PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin before backing up old_data_ptr")
+  id_unused_data_ptr_.emplace(to_const_id, std::move(old_data_ptr));
+
+  PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin before insert")
+  Insert(to_const_id, checksum);
+  PushInfo(to_const_id, checksum, recipe_key, section_size);
+  PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin before host copy")
+
+  if (section_size != 0) {
+    void* tmp_host_ptr{};
+    auto& device = habana::HPUDeviceContext::get_device();
+    //auto device_id = device.id();
+    if (info.data_ptr_.has_value()) {
+      PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo before host copy pt_tensor.data_ptr():",
+      pt_tensor.data_ptr(), ", info.data_ptr_.value().get():", info.data_ptr_.value().get(),
+      ", GetNBytes:", habana_helpers::GetNBytes(pt_tensor),
+      ", section_size:", section_size)
+      auto status = device.get_host_memory().malloc(&tmp_host_ptr, section_size);
+      HABANA_ASSERT(
+          status == synStatus::synSuccess,
+          Logger::synStatusToStr(status));
+      HABANA_ASSERT(section_size == habana_helpers::GetNBytes(pt_tensor))
+      std::atomic<bool> copyDone{false};
+      HPUDeviceContext::copy_data_to_host(
+          reinterpret_cast<synapse_helpers::device_ptr>(info.data_ptr_.value().get()),
+          tmp_host_ptr,
+          reinterpret_cast<synapse_helpers::device_ptr>(
+              info.data_ptr_.value().get()),
+          section_size,
+          [&copyDone]() { copyDone = true; },
+          false,
+          c10::hpu::getCurrentHPUStream());
+
+      habana_helpers::AutoNoGIL gil_release;
+      // wait for copy completion
+      while (!copyDone) {
+        std::this_thread::yield();
+      }
+    } else {
+      PT_BRIDGE_DEBUG("Albin info.data_ptr_ has No value")
+      //auto checksum_if_exists = constant_information.GetDeviceChecksum(const_id);
+      HABANA_ASSERT(section_size == habana_helpers::GetNBytes(pt_tensor))
+      auto tmeta{get_tensor_extra_meta(pt_tensor)};
+      tmp_host_ptr = tmeta->get_host_ptr();
+    }
+
+
+    PT_BRIDGE_DEBUG("Albin CreateCopyConstInfo begin before device copy")
+    PT_BRIDGE_DEBUG("Albin tmp_host_ptr:", tmp_host_ptr, ", device data new address:", pt_tensor.data_ptr())
+    std::atomic<bool> copyDone1{false};
+    habana::HPUDeviceContext::copy_data_to_device(
+        tmp_host_ptr,
+        reinterpret_cast<synapse_helpers::device_ptr>(pt_tensor.data_ptr()),
+        reinterpret_cast<synapse_helpers::device_ptr>(
+            pt_tensor.storage().data_ptr().get()),
+        habana_helpers::GetNBytes(pt_tensor),
+        [&copyDone1]() { copyDone1 = true; },
+        false,
+        true,
+        c10::hpu::getCurrentHPUStream());
+
+    // Release GIL if going to wait
+    habana_helpers::AutoNoGIL gil_release_;
+    // wait for copy completion
+    while (!copyDone1) {
+      std::this_thread::yield();
+    }
+
+    // std::atomic<bool> copyDone1{false};
+    // habana::HPUDeviceContext::copy_data_to_device(
+    //     (void*)tmp_host_ptr,
+    //     reinterpret_cast<synapse_helpers::device_ptr>(pt_tensor.data_ptr()),
+    //     reinterpret_cast<synapse_helpers::device_ptr>(
+    //         pt_tensor.storage().data_ptr().get()),
