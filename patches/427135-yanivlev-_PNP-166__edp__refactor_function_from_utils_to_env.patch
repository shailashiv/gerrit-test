diff --git a/include/lib/utils.h b/include/lib/utils.h
index 35695f2..6178530 100644
--- a/include/lib/utils.h
+++ b/include/lib/utils.h
@@ -19,6 +19,7 @@
 #define MILLI_TO_BASE(x)	((x) / 1000)
 #define CONVER_MICRO_TO_MILLI(x) ((x) / 1000)
 #define TO_KB(bytes)		((bytes) >> 10)
+#define MICRO_J_PER_MILLI_J	1000
 
 #define DT_STR_SZ				16
 
diff --git a/lib/common/envelope.c b/lib/common/envelope.c
index a61adcc..f1fd8d2 100644
--- a/lib/common/envelope.c
+++ b/lib/common/envelope.c
@@ -7,6 +7,7 @@
 
 #include <zephyr.h>
 #include <pid.h>
+#include <utils.h>
 #include <envelope.h>
 
 #define LOG_LEVEL CONFIG_LOG_DEFAULT_LEVEL
@@ -44,6 +45,20 @@
 	return false;
 }
 
+void update_edp_budget_max(struct pid_table *platdata)
+{
+	struct pid_power_table *power = platdata->power;
+	struct pid_edp_data *edp;
+	int i;
+
+	/* Update EDPs budget upper limit to TDP * EDP_multiplier * EDP_duration */
+	for (i = 0; i < power->excursion.num_edps; i++) {
+		edp = &power->excursion.edps[i];
+		edp->budget_max = (power->power.limit_power * edp->tdp_multiplier /
+			edp->tdp_denom) * edp->duration / MICRO_J_PER_MILLI_J;
+	}
+}
+
 void envelope_work(void *data)
 {
 	struct pid_table *platdata = (struct pid_table *)data;
