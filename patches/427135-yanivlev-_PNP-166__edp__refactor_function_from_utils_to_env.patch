From 49eb4fc4b527a219a4f15a9b8f05e671ab4900ee Mon Sep 17 00:00:00 2001
From: Yaniv Levinsky <ylevinsky@habana.ai>
Date: Mon, 24 Jun 2024 14:16:59 +0300
Subject: [PATCH] [PNP-166] edp: refactor function from utils to envelope

Refactor the update_edp_budget_max function from utils to envelope.

The envelope controller is responsible for EDP support, so all EDP
related function should be part of this controller.

This commit is in preparation for adding AEDP support.

Change-Id: I9cd1d7f46b4a8b627392a0ce9c915f32c8dd3522
Signed-off-by: Yaniv Levinsky <ylevinsky@habana.ai>
---

diff --git a/arch/gaudi3/common.c b/arch/gaudi3/common.c
index 545fae3..feb75d3 100644
--- a/arch/gaudi3/common.c
+++ b/arch/gaudi3/common.c
@@ -11,6 +11,7 @@
 #include <pid.h>
 #include <common.h>
 #include <utils.h>
+#include <envelope.h>
 #include <power_int.h>
 #include <power_hb.h>
 #include <api.h>
diff --git a/include/lib/envelope.h b/include/lib/envelope.h
index d8977ce..e9c4216 100644
--- a/include/lib/envelope.h
+++ b/include/lib/envelope.h
@@ -17,4 +17,6 @@
 struct pid_thread *get_envelope_thread_data(void);
 void envelope_work(void *data);
 
+void update_edp_budget_max(struct pid_table *platdata);
+
