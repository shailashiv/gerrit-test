diff --git a/python_packages/habana_frameworks/torch/low_overhead_profiler/README.txt b/python_packages/habana_frameworks/torch/low_overhead_profiler/README.txt
new file mode 100644
index 0000000..6fa3608
--- /dev/null
+++ b/python_packages/habana_frameworks/torch/low_overhead_profiler/README.txt
@@ -0,0 +1,52 @@
+# Example usage in a python. Uses start/stop API and predefined user events (check bindings file for a list) that will be visible on trace.
+import os
+
+os.environ["PT_HPU_LAZY_MODE"] = "0"
+
+import torch
+import habana_frameworks.torch as ht
+import habana_frameworks.torch.core as htcore
+import habana_frameworks.torch.low_overhead_profiler.profiler as lop
+
+s0 = ht.hpu.Stream()
+s1 = ht.hpu.Stream()
+
+def my_func(x):
+    default_stream = ht.hpu.default_stream()
+    y = x.add(1.0)
+    
+    ht.hpu.set_stream(s0)
+    z = y.add(2.0)
+    z = z.mul(2.0)
+
+    ht.hpu.set_stream(s1)
+    w = y.add(2.0)
+    w = w.mul(2.0)
+    
+    ht.hpu.set_stream(default_stream)
+    s0.synchronize()
+    s1.synchronize()
+    
+    res = z + w
+    res = res.t()
+    
+    return res
+
+lop.start() 
+
+lop.emit_begin(lop.profiler.INIT)
+in0 = torch.rand(16, 16).to("hpu")
+lop.emit_end(lop.profiler.INIT)
+
+lop.emit_begin(lop.profiler.LOOP)
+for i in range(50):
+  lop.emit_begin(lop.profiler.ITERATION)
+  res = my_func(in0)
+  lop.emit_end(lop.profiler.ITERATION)
+lop.emit_end(lop.profiler.LOOP)
+
+lop.stop()
+lop.flush()
+
+print(res)
+
