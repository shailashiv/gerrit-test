diff --git a/python_packages/habana_frameworks/torch/low_overhead_profiler/csrc/bindings.cpp b/python_packages/habana_frameworks/torch/low_overhead_profiler/csrc/bindings.cpp
new file mode 100644
index 0000000..e3ae94f
--- /dev/null
+++ b/python_packages/habana_frameworks/torch/low_overhead_profiler/csrc/bindings.cpp
@@ -0,0 +1,70 @@
+#include <torch/extension.h>
+#include "pybind11/stl.h"
+#include "synapse_api.h"
+#include "pytorch_helpers/low_overhead_profiler/profiler.h"
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.doc() = "This module registers low overhead host profiler API";
+
+  m.def("_start_lo_host_profiler", []() {
+    LOP::ProfilerEngine::get_inst().enable();
+  });
+  m.def("_stop_lo_host_profiler", []() {
+    LOP::ProfilerEngine::get_inst().disable();
+  });
+  m.def("_flush_lo_host_profiler", []() {
+    LOP::ProfilerEngine::get_inst().flush();
+  });
+  m.def("_start_hw_profiler", []() {
+    if (synProfilerStart(synTraceDevice, 0) != synSuccess) {
+      std::cerr << "synProfilerStart failed" << std::endl;
+    }
+  });
+  m.def("_stop_hw_profiler", []() {
+    if (synProfilerStop(synTraceDevice, 0) != synSuccess) {
+      std::cerr << "synProfilerStop failed" << std::endl;
+    }
+  });
+  m.def("_flush_hw_profiler", []() {
+    if (synProfilerGetTrace(synTraceDevice, 0, synTraceFormatTEF, nullptr, nullptr, nullptr) != synSuccess) {
+      std::cerr << "synProfilerGetTrace failed" << std::endl;
+    }
+  });
+  m.def("_emit_begin_lop_event", [](uint32_t user_event_id) {
+    LOP::emit_event_by_id(true, 3, user_event_id);
+  });
+  m.def("_emit_end_lop_event", [](uint32_t user_event_id) {
+    LOP::emit_event_by_id(false, 3, user_event_id);
+  });
+
+  py::enum_<LOP::predefined_events_ids>(m, "event")
+    .value("TRAINING",          LOP::predefined_events_ids::TRAINING)
+    .value("VALIDATION",        LOP::predefined_events_ids::VALIDATION)
+    .value("TEST",              LOP::predefined_events_ids::TEST)
+    .value("INFERENCE",         LOP::predefined_events_ids::INFERENCE)
+    .value("FORWARD",           LOP::predefined_events_ids::FORWARD)
+    .value("BACKWARD",          LOP::predefined_events_ids::BACKWARD)
+    .value("OPTIMIZER",         LOP::predefined_events_ids::OPTIMIZER)
+    .value("EPOCH",             LOP::predefined_events_ids::EPOCH)
+    .value("LOOP",              LOP::predefined_events_ids::LOOP)
+    .value("LOOP_OUTER",        LOP::predefined_events_ids::LOOP_OUTER)
+    .value("LOOP_INNER",        LOP::predefined_events_ids::LOOP_INNER)
+    .value("MINIBATCH",         LOP::predefined_events_ids::MINIBATCH)
+    .value("ITERATION",         LOP::predefined_events_ids::ITERATION)
+    .value("SNAPSHOT_SAVE",     LOP::predefined_events_ids::SNAPSHOT_SAVE)
+    .value("SNAPSHOT_RESTORE",  LOP::predefined_events_ids::SNAPSHOT_RESTORE)
+    .value("COLLECTIVE",        LOP::predefined_events_ids::COLLECTIVE)
+    .value("RUN",               LOP::predefined_events_ids::RUN)
+    .value("LAUNCH",            LOP::predefined_events_ids::LAUNCH)
+    .value("GRAPH_COMPILE",     LOP::predefined_events_ids::GRAPH_COMPILE)
+    .value("INIT",              LOP::predefined_events_ids::INIT)
+    .value("SYNC",              LOP::predefined_events_ids::SYNC)
+    .value("CLEANUP",           LOP::predefined_events_ids::CLEANUP)
+    .value("BLOCK1",            LOP::predefined_events_ids::BLOCK1)
+    .value("BLOCK2",            LOP::predefined_events_ids::BLOCK2)
+    .value("BLOCK3",            LOP::predefined_events_ids::BLOCK3)
+    .value("BLOCK4",            LOP::predefined_events_ids::BLOCK4)
+    .value("BLOCK5",            LOP::predefined_events_ids::BLOCK5)
+    .export_values();
+
+}
