+const std::map<predefined_events_ids, const char*> predefined_events_strings{
+    {predefined_events_ids::TRAINING,         "training"},
+    {predefined_events_ids::VALIDATION,       "validation"},
+    {predefined_events_ids::TEST,             "test"},
+    {predefined_events_ids::INFERENCE,        "inference"},
