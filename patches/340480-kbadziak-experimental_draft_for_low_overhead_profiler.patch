@@ -0,0 +1,27 @@
+import torch
+from enum import Enum
+import habana_frameworks.torch.utils._lop_profiler_C as profiler
+
+def start():
+    profiler._start_lo_host_profiler()
+
+def stop():
+    profiler._stop_lo_host_profiler()
+
+def flush():
+    profiler._flush_lo_host_profiler()
+
+def hw_start():
+    profiler._start_hw_profiler()
+
+def hw_stop():
+    profiler._stop_hw_profiler()
+
+def hw_flush():
+    profiler._flush_hw_profiler()
+
+def emit_begin(id):
+    profiler._emit_begin_lop_event(id)
+
+def emit_end(id):
+    profiler._emit_end_lop_event(id)
