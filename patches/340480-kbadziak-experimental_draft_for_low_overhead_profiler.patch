+    {predefined_events_ids::LOOP_INNER,       "loop_inner"},
+    {predefined_events_ids::MINIBATCH,        "minibatch"},
+    {predefined_events_ids::ITERATION,        "iteration"},
+    {predefined_events_ids::SNAPSHOT_SAVE,    "snapshot_save"},
