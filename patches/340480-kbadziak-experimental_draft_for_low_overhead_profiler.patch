+void ProfilerEngine::add_ring_buffer(EventRingBuffer* ring_buffer) {
+    const std::lock_guard<std::mutex> lock(this->rings_mutex);
+    this->ring_buffers.push_back(ring_buffer);
+}
+
+void ProfilerEngine::remove_ring_buffer(EventRingBuffer* ring_buffer) {
+    const std::lock_guard<std::mutex> lock(this->rings_mutex);
+    this->ring_buffers.remove(ring_buffer);
+}
+
+void ProfilerEngine::copying_handler(ProfilerEngine* engine) {
+    while (!engine->initialization_completed)
+        std::this_thread::sleep_for(std::chrono::nanoseconds(500));
+
+    bool limit_reached = false;
+    while (engine->running && !limit_reached) {
+        std::this_thread::sleep_for(std::chrono::nanoseconds(500));
+        {
+            const std::lock_guard<std::mutex> lock(engine->rings_mutex);
+            for(EventRingBuffer* ring : engine->ring_buffers) {
+                // We want to read them exactly now and once, as END might increase in the meantime.
+                volatile auto begin = ring->b;
+                volatile auto end = ring->e;
+
+                if (begin < end) {
+                    // Single memcopy can handle it.
+                    auto num_of_elements = end - begin;
+
+                    if (engine->events_counter + num_of_elements > EVENT_TABLE_SIZE) {
+                        printf("Reached event limit. Bailing out.\n");
+                        limit_reached = true;
+                        break;
+                    }
+
+                    memcpy(engine->events_table + engine->events_counter, &ring->events[begin], num_of_elements * sizeof(Event));
+
+                    engine->events_counter += num_of_elements;
+                    ring->b = end;
+
+                    if (engine->biggest_copy < num_of_elements) engine->biggest_copy = num_of_elements;
+
+                } else if (begin > end) {
+                    // Two memcopies needed.
+                    auto num_of_elements1 = LOP_RING_SIZE - begin;
+                    auto num_of_elements2 = end;
+
+                    if (engine->events_counter + num_of_elements1 + num_of_elements2 > EVENT_TABLE_SIZE) {
+                        printf("Reached event limit. Bailing out.\n");
+                        limit_reached = true;
+                        break;
+                    }
+
+                    memcpy(engine->events_table + engine->events_counter, &ring->events[begin], num_of_elements1 * sizeof(Event));
+                    memcpy(engine->events_table + engine->events_counter + num_of_elements1, &ring->events[0], num_of_elements2 * sizeof(Event));
+
+                    engine->events_counter += num_of_elements1 + num_of_elements2;
+                    ring->b = end;
+
+                    if (engine->biggest_copy < (num_of_elements1 + num_of_elements2)) engine->biggest_copy = num_of_elements1 + num_of_elements2;
+                }
+            }
+        }
+
+    }
+}
+
+EventRingBuffer::EventRingBuffer() {
+    this->thread_id = pthread_self();
+    this->events = new Event[LOP_RING_SIZE];
+    ProfilerEngine::get_inst().add_ring_buffer(this);
+}
+
+EventRingBuffer::~EventRingBuffer() {
+    printf("EventRingBuffer::~EventRingBuffer at TID:%u\n", this->thread_id); fflush(stdout);
+    ProfilerEngine::get_inst().remove_ring_buffer(this);
+    if (this->events) {
+        delete[] this->events;
+        this->events = nullptr;
+    }
+
+    this->thread_id = -1;
+    printf("EventRingBuffer::~EventRingBuffer finished\n"); fflush(stdout);
+}
+
+void emit_event(bool is_begin, uint32_t log_level, const char* name)
+{
+    static thread_local EventRingBuffer event_ring_buffer;
+    Event* events_buffer = event_ring_buffer.events;
+    bool is_pointer_valid = events_buffer != nullptr;
+    bool is_enabled = ProfilerEngine::get_inst().is_enabled();
+    bool is_loglevel = ProfilerEngine::get_inst().is_loglevel(log_level);
+    if (is_pointer_valid & is_enabled & is_loglevel) {
+        uint64_t tsc = 0;
+        uint32_t aux = 0;
+        __asm__ __volatile__(
+            "rdtscp\n\t"
+            "shl $32, %%rdx\n\t"
+            "or %%rdx, %%rax\n\t"
+            : "=a"(tsc), "=c" (aux)
+            :
+            : "%rdx", "memory");
+
+        Event& new_event = events_buffer[event_ring_buffer.e];
+        new_event.timestamp = tsc;
+        new_event.name = name;
+        new_event.thread_id = event_ring_buffer.thread_id;
+        new_event.cpu_id = aux;
+        new_event.is_begin = is_begin;
+
+        // This would be more accurate as there would be less space for RDTSCP to slide around.
+        // but it would also incur constant penalty everywhere, effectively reducing profiling accuracy anyway.
+        // __asm__ __volatile__("lfence\n\t" ::: "memory"); 
+        // ...so, let's try below one, just to make sure compiler won't reorder these.
+        // It shouldn't be that bad, because:
+        // Last operation here is write and CPU will not do StoreStore reordering. Meaning RDTSCP could at worst scenario
+        // execute just before END pointer being incremented (because at that point write of TSC into structure
+        // must be already completed). And that is perfectly fine.
+        __asm__ __volatile__("" ::: "memory");
+
+        event_ring_buffer.e = (event_ring_buffer.e + 1) & (LOP_RING_SIZE-1);
+    }
+}
+
+void emit_event_fast(bool is_begin, const char* name)
+{
+    // This function is faster because it use lighter RDTSC instead of RDTSCP. It's latency is lower but it also
+    // does not make partial barrier like RDTSCP does. Caveat is that we no longer know the CPUs on which we took TSC.
+    // It also does not check whether event buffer is correct (so it's less reliable). It does not support log levels.
+    if (ProfilerEngine::get_inst().is_enabled()) {
+        static thread_local EventRingBuffer event_ring_buffer;
+        uint64_t tsc = 0;
+        __asm__ __volatile__(
+            "rdtsc\n\t"
+            "shl $32, %%rdx\n\t"
+            "or %%rdx, %%rax\n\t"
+            : "=a"(tsc)
+            :
+            : "%rdx", "memory");
+
+        Event& new_event = event_ring_buffer.events[event_ring_buffer.e];
+        new_event.timestamp = tsc;
+        new_event.name = name;
+        new_event.thread_id = event_ring_buffer.thread_id;
+        new_event.is_begin = is_begin;
+
+        __asm__ __volatile__("" ::: "memory");
+
+        event_ring_buffer.e = (event_ring_buffer.e + 1) & (LOP_RING_SIZE-1);
+    }
+}
+
+void emit_counter_event_fast(uint32_t ctr_id, uint32_t count)
+{
+    // This function is faster because it use lighter RDTSC instead of RDTSCP. It's latency is lower but it also
+    // does not make partial barrier like RDTSCP does. Caveat is that we no longer know the CPUs on which we took TSC.
+    // It also does not check whether event buffer is correct (so it's less reliable).
+    // It does not support log levels.
+    if (ProfilerEngine::get_inst().is_enabled()) {
+        static thread_local EventRingBuffer event_ring_buffer;
+        uint64_t tsc = 0;
+        __asm__ __volatile__(
+            "rdtsc\n\t"
+            "shl $32, %%rdx\n\t"
+            "or %%rdx, %%rax\n\t"
+            : "=a"(tsc)
+            :
+            : "%rdx", "memory");
+
+        Event& new_event = event_ring_buffer.events[event_ring_buffer.e];
+        new_event.timestamp = tsc;
+        new_event.thread_id = ctr_id;
+        new_event.name = "_internal_counter_event";
+        new_event.user_event_id = count; // let's reuse this field as a counter
+
+        __asm__ __volatile__("" ::: "memory");
+
+        event_ring_buffer.e = (event_ring_buffer.e + 1) & (LOP_RING_SIZE-1);
+    }
+}
+
+void emit_event_by_id(bool is_begin, uint32_t log_level, uint32_t user_event_id)
+{
+    static thread_local EventRingBuffer event_ring_buffer;
+    Event* events_buffer = event_ring_buffer.events;
+    bool is_pointer_valid = events_buffer != nullptr;
+    bool is_enabled = ProfilerEngine::get_inst().is_enabled();
+    bool is_loglevel = ProfilerEngine::get_inst().is_loglevel(log_level);
+    if (is_pointer_valid & is_enabled & is_loglevel) {
+        uint64_t tsc = 0;
+        uint32_t aux = 0;
+        __asm__ __volatile__(
+            "rdtscp\n\t"
+            "shl $32, %%rdx\n\t"
+            "or %%rdx, %%rax\n\t"
+            : "=a"(tsc), "=c" (aux)
+            :
+            : "%rdx", "memory");
+
+        Event& new_event = events_buffer[event_ring_buffer.e];
+        new_event.timestamp = tsc;
+        new_event.name = nullptr;
+        new_event.thread_id = event_ring_buffer.thread_id;
+        new_event.cpu_id = aux;
+        new_event.user_event_id = user_event_id;
+        new_event.is_begin = is_begin;
+
+        __asm__ __volatile__("" ::: "memory");
+
+        event_ring_buffer.e = (event_ring_buffer.e + 1) & (LOP_RING_SIZE-1);
+    }
+}
+
+};
