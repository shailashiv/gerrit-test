+    const char* name;
+
+public:
+    FastScopedProfiler(const char* name) {
+        this->name = name;
+        emit_event_fast(true, this->name);
+    }
+
+    ~FastScopedProfiler() {
+        emit_event_fast(false, this->name);
+    }
+};
+
+class FastManualProfiler {
+    const char* name;
+
+public:
+    FastManualProfiler(const char* name) {
+        this->name = name;
+        emit_event_fast(true, this->name);
+    }
+
+    ~FastManualProfiler() {}
+
+    void end() {
+        emit_event_fast(false, this->name);
+    }
+};
