+static void mc_scheduler_init(uint32_t hbm_dev)
+{
+	uint32_t hbm_offset = CALC_HBM_OFFSET(hbm_dev);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_PFETCH_OPEN_SCORE), 0x96);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_PFETCH_CLOSED_SCORE), 0x96);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_REF_ARB_TH_VAL), 0xffff);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_SAT_MED_RPSB), 0x1);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_SAT_HIGH_RPSB), 0x3);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_MIN_SATURATED), 0x14);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_WR_SAT_MED_RPSB), 0x1);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_WR_SAT_HIGH_RPSB), 0x3);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_WR_MIN_SATURATED), 0x14);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_ALMOST_EMPTY_LEVEL), 0x5);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_WR_ALMOST_EMPTY_LEVEL), 0x202);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RWS_CNT), 0x1);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_SEQ_REQ_CNT), 0x1);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_0), 0x80);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_1), 0x168);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_2), 0x1b8);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_3), 0x1ff);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_QOS_ALMOST_FULL_TH_0), 0x1e);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_QOS_ALMOST_FULL_TH_1), 0x1e);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_QOS_ALMOST_FULL_TH_2), 0x1e);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_QOS_ALMOST_FULL_TH_3), 0x1e);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_WR_QOS_ALMOST_FULL_TH), 0x1e);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RDB_CREDIT_INIT), 0x40);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS0_SCORE_1),
+											0x32);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS1_SCORE_1),
+											0x32);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS2_SCORE_1),
+											0x32);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS3_SCORE_1),
+											0x32);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS0_SCORE_2),
+											0x50);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS1_SCORE_2),
+											0x50);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS2_SCORE_2),
+											0x50);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS3_SCORE_2),
+											0x50);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS0_SCORE_3),
+											0x82);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS1_SCORE_3),
+											0x82);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS2_SCORE_3),
+											0x82);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_QOS3_SCORE_3),
+											0x82);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_LATENCY_LEVEL_SAT_SCORE),
+											0xc8);
+
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_RD_OPEN_PAGE_SCORE), 0x32);
+	CFG_WREG32(hbm_offset + D0_HBM0_BCAST_MC_REG(mmMC_CH_RSCH_WR_OPEN_PAGE_SCORE), 0x32);
+
