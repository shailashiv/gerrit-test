+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2023 HabanaLabs, Ltd.
+ * All rights reserved.
+ *
+ */
+
+#ifndef GAUDI3_HBM_FUSE_SCAN_H_
+#define GAUDI3_HBM_FUSE_SCAN_H_
+
+#include <stdint.h>
+
+#define HBM_ROWS_FUSE_SCAN_DELAY_US		6	/* 6 micro sec */
+#define FUSE_CHECK_BIT				0
+#define HBM_ROW_FUSE_CH_GROUPS			2	/* group0: ch0/1/4/5, group1: ch2/3/6/7 */
+
+const uint32_t fuse_sid0_bit = 23;
+const uint32_t fuse_sid1_bit = 24;
+
+/*
+ * The fuse array size is 512 vectors:
+ *	8 spare rows per Bank
+ *	16 Banks per PC
+ *	2 PCs per channel
+ *	2 channel groups (group0 -> ch0/1/4/5, group1 -> ch2/3/6/7
+ * Each scan cmd will return 4 vectors for all channels per MC (MC0 -> CH0/1/4/5, MC1 -> CH2/3/6/7)
+ */
+/* DO NOT CHANGE THE ORDER OF THE ARRAY */
+
+const uint32_t hbm_fuse_scan_arr[HBM_ROW_FUSE_CH_GROUPS][NUM_PC_PER_CH][HBM_BANKS_PER_PC]
+				[HBM_MAX_SPARE_ROWS_PER_BANK] = {
+{{{0x120180, 0x1201c0, 0x120980, 0x1209c0, 0x121180, 0x1211c0, 0x121980, 0x1219c0},
+{0x120200, 0x120240, 0x120a00, 0x120a40, 0x121200, 0x121240, 0x121a00, 0x121a40},
+{0x120580, 0x1205c0, 0x120d80, 0x120dc0, 0x121580, 0x1215c0, 0x121d80, 0x121dc0},
+{0x120600, 0x120640, 0x120e00, 0x120e40, 0x121600, 0x121640, 0x121e00, 0x121e40},
+{0x140180, 0x1401c0, 0x140980, 0x1409c0, 0x141180, 0x1411c0, 0x141980, 0x1419c0},
+{0x140200, 0x140240, 0x140a00, 0x140a40, 0x141200, 0x141240, 0x141a00, 0x141a40},
+{0x140580, 0x1405c0, 0x140d80, 0x140dc0, 0x141580, 0x1415c0, 0x141d80, 0x141dc0},
+{0x140600, 0x140640, 0x140e00, 0x140e40, 0x141600, 0x141640, 0x141e00, 0x141e40},
+{0x128180, 0x1281c0, 0x128980, 0x1289c0, 0x129180, 0x1291c0, 0x129980, 0x1299c0},
