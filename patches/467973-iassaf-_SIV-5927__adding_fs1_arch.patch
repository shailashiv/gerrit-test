+#define DQ2_LANE_MAP_CODE			0xe3
+#define DQ3_LANE_MAP_CODE			0xe4
+#define DQ4_LANE_MAP_CODE			0xe5
+#define DQ5_LANE_MAP_CODE			0xe6
+#define DQ6_LANE_MAP_CODE			0xe7
+#define DQ7_LANE_MAP_CODE			0xe8
+#define DQ8_LANE_MAP_CODE			0x1e
+#define DQ9_LANE_MAP_CODE			0x2e
+#define DQ10_LANE_MAP_CODE			0x3e
+#define DQ11_LANE_MAP_CODE			0x4e
+#define DQ12_LANE_MAP_CODE			0x5e
+#define DQ13_LANE_MAP_CODE			0x6e
+#define DQ14_LANE_MAP_CODE			0x7e
+#define DQ15_LANE_MAP_CODE			0x8e
+#define DM0_LANE_MAP_CODE			0xe0
+#define DM1_LANE_MAP_CODE			0x0e
+#define INVALID_LANE_MAP_CODE			0xaa
+#define PREFETCH_NUM_PER_MC			16
+
+
+#define ROW_REPAIR_RB_SHIFT				(15)
+#define ROW_REPAIR_DQ_POSITION_SHIFT			(19)
+#define ROW_REPAIR_SID_SHIFT				(20)
+#define ROW_REPAIR_ENABLE_SHIFT				(21)
+#define PBT_PATTERNS_NUM_PER_SID			(5)
+#define MBIST_PBT_RESULT_SIZE				(522)		/* garbage bit modified */
+#define MBIST_LEGACY_RESULT_SIZE			(476)		/* garbage bit modified */
+
+
+/*
+ * Patrol scrubbing
+ * 24 hours divided by number of transactions to cover a PC's memory region,
+ * and convert the result to MC cycles (900MHz = 1.111ns)
+ * i.e.:
+ * 86,400sec / (2^30bytes / 256bytes-per-transaction) =  86400/4194304 = 20599365ns
+ * to cycles: 20599365/1.1111111111 = 18539428 = 0x11AE3A4 --> 0x11ABCDE
+ */
+#define PATROL_SCRB_START_ADDR			0x0
+#define PATROL_SCRB_END_ADDR			0x3fffffff
+#define PATROL_SCRB_DLY_CNTR			0x11abcde
+#define PATROL_SCRB_RELOAD_EN			0x1
+
+/* CALCS */
+#define CEIL(numerator, denominator) ((numerator + denominator - 1) / (denominator))
+
+#define MAX_REPAIR_VECTORS	(MBIST_HL_MAX_REPAIR_VECTORS_NUM * HBM_PHY_CHANNELS_NUM)
+
+struct sec_repair_data_reg {
+	uint32_t ra :15;
+	uint32_t rb :4;
+	uint32_t dq_position :1;
+	uint32_t sid : 1;
+	uint32_t reserved :11;
+	uint32_t ch;
+};
+
+enum phy_pstate {
+	PSTATE_0 = 0x0,
+	PSTATE_1 = 0x1,
+	PSTATE_2 = 0x2,
+	PSTATE_3 = 0x3,
+	BCAST = 0x7,
+	PSTATE_NUM = 0x4,
+};
+
+enum pubmode {
+	PUBMODE_EXIT = 0x0,
+	PUBMODE_ENTER = 0x1,
+};
+
+enum phy_indirect_access_chiplet {
+	PHY_CHIPLET_CH = 0x0,
+	PHY_CHIPLET_MASTER = 0x2,
+	PHY_CHIPLET_INITENG = 0x9,
+};
+
+enum drive_strength {
+	DRIVE_STRENGTH_6MA,
+	DRIVE_STRENGTH_9MA,
+	DRIVE_STRENGTH_12MA,
+	DRIVE_STRENGTH_15MA,
+	DRIVE_STRENGTH_18MA,
+};
+
+enum hbm_vref {
+	P50VDDQ,
+	P46VDDQ,
+	P42VDDQ,
+	P38VDDQ,
+	P54VDDQ,
+	P58VDDQ,
+	P62VDDQ,
+	P66VDDQ,
+	HBM_VREF_STEPS
+};
+
+enum ieee1500_bus_freq_div {
+	DIV_16 = 0x0,
+	DIV_32 = 0x1,
+	DIV_64 = 0x2,
+	DIV_128 = 0x3,
+};
+
+enum train_cmd_repeat {
+	CMD_REPEAT_SHORT = 63,
+	CMD_REPEAT_LONG = 254,
+};
+
+enum train_data_pattern {
+	LFSR_PRESET = 0x0,
+	LFSR = 0x1,
+};
+
+enum hbm_status {
+	STATUS_PASS,
+	STATUS_FAIL,
+	STATUS_SKIP,
+};
+
+enum no_write_inflight_poll {
+	NO_POLL_WR_INFLIGHT = 0x0,
+	POLL_WR_INFLIGHT = 0x1,
+};
+
+enum hbm_training_type {
+	TRAIN_TYPE_HW_ONLY,
+	TRAIN_TYPE_SEMI_AUTO,
+	TRAIN_TYPE_SW,
+};
+
+enum train_params {
+	TRAIN_CA,
+	TRAIN_RD_LAT,
+	TRAIN_RD_EYE,
+	TRAIN_VREF,
+	TRAIN_WR_EYE,
+};
+
+enum ieee1500_op {
+	wir_only = 0x0,
+	wir_write = 0x1,
+	wir_read = 0x2,
+	write_only = 0x3,
+	read_only = 0x4
+};
+
+enum ieee1500_instruction {
+	ieee1500_bypass = 0x00,
+	ieee1500_extest_rx = 0x01,
+	ieee1500_extest_tx = 0x02,
+	ieee1500_intest_rx = 0x03,
+	ieee1500_intest_tx = 0x04,
+	ieee1500_hbm_reset = 0x05,
+	ieee1500_mbist = 0x06,		/* Not used */
+	ieee1500_soft_repair = 0x07,
+	ieee1500_hard_repair = 0x08,
+	ieee1500_dword_misr = 0x09,
+	ieee1500_aword_misr = 0x0a,
+	ieee1500_channel_id = 0x0b,
+	ieee1500_misr_mask = 0x0c,
+	ieee1500_aword_misr_config = 0x0d,
+	ieee1500_device_id = 0x0e,
+	ieee1500_temperature = 0x0f,
+	ieee1500_mode_register_dump_set = 0x10,
+	ieee1500_read_lfsr_compare_sticky = 0x11,
+	ieee1500_soft_lane_repair = 0x12,
+	ieee1500_hard_lane_repair = 0x13,
+	ieee1500_mbist_a6 = 0xa6,
+	ieee1500_mbist_a7 = 0xa7,
