+				      <SPSRAM_CMPT0_MGMT_TX_IO_MGMT_RX_MBX SPSRAM_IPM_BUFF_SIZE>;
+				reg-names = "cfg", "data";
+				mbx_type = <1>;
+				inter_die;
+				node_label = "FS_MBX_CMPTD0MGMT_IOD0MGMT";
+			};
+
+			mbx_iod0mgmt_cmptd0mgmt: fs-mbx@COMPUTE0_SW_MAILBOX0_0 {
+				compatible = "intel,fs_mbx_rx";
+				reg = <PREFIX_0X(COMPUTE0_SW_MAILBOX0_0) 0x590>,
+				      <0xf9c80b80 0xf>;
+				reg-names = "cfg", "intr_mask";
+				mask_idx = <31>;
+				mbx_type = <2>;
+				inter_die;
+				node_label = "FS_MBX_IOD0MGMT_CMPTD0MGMT";
+			};
+		};
 	};
 };
diff --git a/dts/arc/fs1_rst.dtsi b/dts/arc/fs1_rst.dtsi
