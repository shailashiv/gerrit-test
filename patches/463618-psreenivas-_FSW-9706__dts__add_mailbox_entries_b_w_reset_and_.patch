@@ -37,6 +37,7 @@
 		.mbx_type = DT_INST_PROP(inst, mbx_type),					\
 		.intr_mask = (uint32_t) DT_INST_REG_ADDR_BY_NAME(inst, intr_mask),		\
 		.mask_idx = (uint8_t) DT_INST_PROP(inst, mask_idx),				\
+		.inter_die = (uint8_t) DT_INST_PROP(inst, inter_die),				\
 		LOG_INSTANCE_PTR_INIT(log, LOG_MODULE_NAME, inst)				\
