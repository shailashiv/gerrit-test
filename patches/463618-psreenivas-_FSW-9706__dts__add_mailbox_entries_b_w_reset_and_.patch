 	static struct ipm_fs_data ipm_fs_##inst##_data;						\
diff --git a/dts/arc/fs1_io_mgmt.dtsi b/dts/arc/fs1_io_mgmt.dtsi
index 7bdb526..d68872a 100644
--- a/dts/arc/fs1_io_mgmt.dtsi
+++ b/dts/arc/fs1_io_mgmt.dtsi
@@ -139,6 +139,46 @@
 				mbx_type = <2>;
 				node_label = "FS_MBX_IOD0PID_IOD0MGMT";
 			};
+
+			mbx_iod0mgmt_iod0rst: fs-mbx@IO0_HALF0_SW_MAILBOX1_1 {
+				compatible = "intel,fs_mbx_tx";
+				reg = <PREFIX_0X(IO0_HALF0_SW_MAILBOX1_1) 0x590>,
+				      <SPSRAM_IO_MGMT_TX_IO_RST_RX_MBX SPSRAM_IPM_BUFF_SIZE>;
+				reg-names = "cfg", "data";
+				mbx_type = <1>;
+				node_label = "FS_MBX_IOD0MGMT_IOD0RST";
+			};
+
+			mbx_iod0rst_iod0mgmt: fs-mbx@IO0_HALF0_SW_MAILBOX2_1 {
+				compatible = "intel,fs_mbx_rx";
+				reg = <PREFIX_0X(IO0_HALF0_SW_MAILBOX2_1) 0x590>,
+				      <0xf9c80b80 0xf>; /* Psoc glbl mask */
+				reg-names = "cfg", "intr_mask";
+				mask_idx = <31>;
+				mbx_type = <2>;
+				node_label = "FS_MBX_IOD0RST_IOD0MGMT";
+			};
+
+			mbx_iod0mgmt_cmptd0mgmt: fs-mbx@COMPUTE0_SW_MAILBOX0_0 {
+				compatible = "intel,fs_mbx_tx";
+				reg = <PREFIX_0X(COMPUTE0_SW_MAILBOX0_0) 0x590>,
+				      <SPSRAM_IO_MGMT_TX_CMPT0_MGMT_RX_MBX SPSRAM_IPM_BUFF_SIZE>;
+				reg-names = "cfg", "data";
+				mbx_type = <1>;
+				inter_die;
+				node_label = "FS_MBX_IOD0MGMT_IOD0PID";
+			};
+
+			mbx_cmptd0mgmt_iod0mgmt: fs-mbx@IO0_HALF0_SW_MAILBOX0_0 {
+				compatible = "intel,fs_mbx_rx";
+				reg = <PREFIX_0X(IO0_HALF0_SW_MAILBOX0_0) 0x590>,
+				      <0xf9c80b80 0xf>; /* Psoc glbl mask */
+				reg-names = "cfg", "intr_mask";
+				mask_idx = <31>;
+				mbx_type = <2>;
+				inter_die;
+				node_label = "FS_MBX_IOD0PID_IOD0MGMT";
+			};
 		};
 	};
 };
