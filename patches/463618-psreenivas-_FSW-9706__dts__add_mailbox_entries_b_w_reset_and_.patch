+				compatible = "intel,fs_mbx_tx";
+				reg = <PREFIX_0X(IO0_HALF0_SW_MAILBOX2_1) 0x590>,
+				<SPSRAM_IO_RST_TX_IO_MGMT_RX_MBX SPSRAM_IPM_BUFF_SIZE>;
+				reg-names = "cfg", "data";
+				mbx_type = <1>;
+				node_label = "FS_MBX_IOD0RST_IOD0MGMT";
+			};
+
+			mbx_iod0mgmt_iod0rst: fs-mbx@IO0_HALF0_SW_MAILBOX1_1 {
+				compatible = "intel,fs_mbx_rx";
+				reg = <PREFIX_0X(IO0_HALF0_SW_MAILBOX1_1) 0x590>,
+				<0xf9c80b80 0xf>;
+				reg-names = "cfg", "intr_mask";
+				mask_idx = <31>;
+				mbx_type = <2>;
+				node_label = "FS_MBX_IOD0MGMT_IOD0RST";
+			};
+		};
+	};
 };
