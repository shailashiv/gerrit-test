@@ -37,6 +37,7 @@
 				IPM_FS_MBX_MASK) / IPM_FS_NUM_SW_MBX),				\
 		.data_base = DT_REG_ADDR_BY_NAME(DT_INST(inst, intel_fs_mbx_tx), data),		\
 		.data_size = DT_REG_SIZE_BY_NAME(DT_INST(inst, intel_fs_mbx_tx), data),		\
+		.inter_die = (uint8_t) DT_INST_PROP(inst, inter_die),				\
 		LOG_INSTANCE_PTR_INIT(log, LOG_MODULE_NAME, inst)				\
