From 24a549b15b0792f6dcf25a6b26761d230ddf76aa Mon Sep 17 00:00:00 2001
From: Pavan S <psreenivas@habana.ai>
Date: Tue, 13 May 2025 11:16:49 +0300
Subject: [PATCH] [FSW-9706] dts: add mailbox entries b/w reset and mgmt

This patch adds reset and mgmt tx and rx dtsi sw mailbox
ipm entries to device tree.
IO0_HALF0_SW_MAILBOX1_1 - TX(MGMT) --> RX (RESET)
IO0_HALF0_SW_MAILBOX2_1 - TX(RESET) --> RX (MGMT)

Signed-off-by: Pavan S <psreenivas@habana.ai>
Change-Id: I4b576e04f249da9db5177dfd894392f24ab6145b
---

diff --git a/boards/intel/fs/fs1_mgmt_compute_asic_defconfig b/boards/intel/fs/fs1_mgmt_compute_asic_defconfig
index 8ad24ba..a4d9126 100644
--- a/boards/intel/fs/fs1_mgmt_compute_asic_defconfig
+++ b/boards/intel/fs/fs1_mgmt_compute_asic_defconfig
@@ -21,3 +21,5 @@
 CONFIG_IPM=y
 CONFIG_IPM_INTEL_FS=y
 CONFIG_IPM_INTEL_GPU_BRIDGE=y
+CONFIG_IPM_INTEL_FS_TX_MBX=y
+CONFIG_IPM_INTEL_FS_RX_MBX=y
diff --git a/boards/intel/fs/fs1_rst_asic_defconfig b/boards/intel/fs/fs1_rst_asic_defconfig
index d3d603f..ea71182 100644
--- a/boards/intel/fs/fs1_rst_asic_defconfig
+++ b/boards/intel/fs/fs1_rst_asic_defconfig
@@ -19,3 +19,7 @@
 CONFIG_MINIMAL_LIBC_OPTIMIZE_STRING_FOR_SIZE=n
 CONFIG_BOOT_IF_PSEUDO_RO_TIMER=y
 CONFIG_XIP=n
+CONFIG_IPM=y
+CONFIG_IPM_INTEL_FS=y
+CONFIG_IPM_INTEL_FS_TX_MBX=y
+CONFIG_IPM_INTEL_FS_RX_MBX=y
diff --git a/drivers/ipm/ipm_fs.c b/drivers/ipm/ipm_fs.c
index da2d860..32d24ad 100644
--- a/drivers/ipm/ipm_fs.c
+++ b/drivers/ipm/ipm_fs.c
@@ -8,12 +8,15 @@
 #include <soc/intel/gpu/fs1/soc.h>
 #include <zephyr/drivers/ipm.h>
 #include <zephyr/shared_irq.h>
+#include <gpu_utils.h>
 
 #include <zephyr/logging/log.h>
 #include "ipm_fs.h"
 
 #define LOG_MODULE_NAME			ipm_fs
 LOG_MODULE_REGISTER(LOG_MODULE_NAME, CONFIG_IPM_LOG_LEVEL);
+#define fs_ipm_write32(v, c) (config->inter_die) ? CFG_ADDR_MNPL_WREG32(c, v) : sys_write32(v, c)
+#define fs_ipm_read32(c) (config->inter_die) ? CFG_ADDR_MNPL_RREG32(c) : sys_read32(c)
 
 /*
  * Below apis are copied from queue driver. Since the block registers
@@ -35,8 +38,8 @@
 
 	*size = 0;
 
-	data->mbx.pi = sys_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
-	data->mbx.ci = sys_read32((mem_addr_t) &reg_base->ci[config->mbx_idx]);
+	data->mbx.pi = fs_ipm_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	data->mbx.ci = fs_ipm_read32((mem_addr_t) &reg_base->ci[config->mbx_idx]);
 
 	if (data->mbx.pi_to_cb >= data->mbx.ci) {
 		avail_len = (data->mbx.len - (data->mbx.pi_to_cb - data->mbx.ci));
@@ -94,7 +97,7 @@
 		return -EINVAL;
 
 	data->mbx.pi = (data->mbx.pi + size) % data->mbx.len;
-	sys_write32(data->mbx.pi, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	fs_ipm_write32(data->mbx.pi, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
 	return 0;
 }
 
@@ -119,7 +122,7 @@
 		return -EINVAL;
 
 	data->mbx.ci = (data->mbx.ci + size) % data->mbx.len;
-	sys_write32(data->mbx.ci, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
+	fs_ipm_write32(data->mbx.ci, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
 	return 0;
 }
 
@@ -137,11 +140,12 @@
 	__ASSERT(data->callback != NULL,
 		 "No callback registered to ipm_fs interrupt driver %p", dev);
 
-	data->mbx.pi = sys_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	data->mbx.pi = fs_ipm_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
 	if (data->mbx.pi == data->mbx.ci) {
 		LOG_ERR("no data received, spurious interrupt");
 		return;
 	}
+	CFG_HBW_ADDR_MNPL(0);
 
 	addr = data->mbx.base_addr + data->mbx.pi_to_cb;
 	mbx_data.buffer_info[0].addr_lo = (uint32_t) (addr);
@@ -186,6 +190,9 @@
 		 */
 		m_size = 0;
 		memset(&cb_data, 0x0, sizeof(struct ipm_fs_mbx_buffer_data));
+		LOG_HEXDUMP_DBG_LOCAL((void *)mbx_data.buffer_info[0].addr_lo,
+					mbx_data.buffer_info[0].size, "receive");
+
 		if (mbx_data.buffer_info[0].size >= hdr_sz) {
 			memcpy(&msg_hdr, (void *)mbx_data.buffer_info[0].addr_lo, hdr_sz);
 			/* update size and addr */
@@ -200,6 +207,7 @@
 			if (msg_hdr.size > t_size) {
 				LOG_ERR_LOCAL("Incorrect msg size: %d send by transmitter dev:%p",
 						msg_hdr.size, dev);
+				CFG_HBW_ADDR_MNPL(1);
 				return;
 			}
 
@@ -271,6 +279,7 @@
 					m_size, dev);
 		t_size -= m_size;
 	}
+	CFG_HBW_ADDR_MNPL(1);
 }
 
 static void ipm_fs_init_mbx_data(const struct device *dev)
@@ -279,9 +288,10 @@
 	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
+
 	data->mbx.base_addr =
-		(uint32_t)sys_read32((mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
-	data->mbx.len = sys_read32((mem_addr_t) &reg_base->q_size[config->mbx_idx]);
+		(uint32_t)fs_ipm_read32((mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
+	data->mbx.len = fs_ipm_read32((mem_addr_t) &reg_base->q_size[config->mbx_idx]);
 	data->mbx.ci = 0;
 	data->mbx.pi = 0;
 	data->mbx.pi_to_cb = 0;
@@ -296,25 +306,23 @@
 	 * 1. mbx enable
 	 * 2. pi write
 	 */
-	uint32_t en_sts = (sys_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx));
-	uint32_t pi_sts = (sys_read32((mem_addr_t)&reg_base->pi_sts) & BIT(config->mbx_idx));
+	uint32_t en_sts = (fs_ipm_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx));
+	uint32_t pi_sts = (fs_ipm_read32((mem_addr_t)&reg_base->pi_sts) & BIT(config->mbx_idx));
 
 	if (!en_sts && !pi_sts) {
 		LOG_DBG("Interrupt does not belong to dev %p", dev);
-		return;
 	}
-
 	/* mbx enable routine */
 	if (en_sts) {
 		ipm_fs_init_mbx_data(dev);
-		sys_write32(BIT(config->mbx_idx), (mem_addr_t)&(reg_base->en_sts));
+		fs_ipm_write32(BIT(config->mbx_idx), (mem_addr_t)&(reg_base->en_sts));
 		return;
 	}
 
 	/* PI write routine */
 	if (pi_sts) {
 		ipm_fs_mbx_process_data(dev);
-		sys_write32(BIT(config->mbx_idx), (mem_addr_t)&reg_base->pi_sts);
+		fs_ipm_write32(BIT(config->mbx_idx), (mem_addr_t)&reg_base->pi_sts);
 	}
 }
 
@@ -323,8 +331,8 @@
 	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
-	if ((sys_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx)) ||
-		!sys_read32((mem_addr_t)&reg_base->en[config->mbx_idx])) {
+	if ((fs_ipm_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx)) ||
+		!(fs_ipm_read32((mem_addr_t)&reg_base->en[config->mbx_idx]))) {
 		return false;
 	}
 	return true;
@@ -349,11 +357,12 @@
 		return -EINVAL;
 	}
 
+	CFG_HBW_ADDR_MNPL(0);
 	ret = ipm_fs_mbx_claim_buffer(dev, req_sz, &mbx_data);
 	if (ret) {
 		LOG_ERR_LOCAL("mailbox buffer allocation failed ret:%d req_sz: %d",
 				ret, req_sz);
-		return ret;
+		goto addr_mnpl;
 	}
 
 	msg_hdr.id = id;
@@ -385,12 +394,15 @@
 		memcpy((void *)mbx_data.buffer_info[0].addr_lo, &msg_hdr, hdr_sz);
 		if (data)
 			memcpy((void *) (mbx_data.buffer_info[0].addr_lo + hdr_sz), data, size);
+		LOG_HEXDUMP_DBG_LOCAL((void *)mbx_data.buffer_info[0].addr_lo,
+					hdr_sz + size, "send");
 	}
 
 	ret = ipm_fs_mbx_manage_pi(dev, req_sz);
 	if (ret)
 		LOG_ERR_LOCAL("unable to send message ret:%d for msg_id: %d", ret, id);
-
+addr_mnpl:
+	CFG_HBW_ADDR_MNPL(1);
 	return ret;
 }
 
@@ -445,7 +457,7 @@
 	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
-	sys_write32((enable) ? 0x1 : 0x0, (mem_addr_t) &reg_base->en[config->mbx_idx]);
+	fs_ipm_write32((enable) ? 0x1 : 0x0, (mem_addr_t) &reg_base->en[config->mbx_idx]);
 	return 0;
 }
 
@@ -463,14 +475,16 @@
 	 * TX will fill all the buffer content lo/hi addr and size
 	 * and then set enable interrupt in ipm_fs_set_enabled function.
 	 */
-	sys_write32(config->data_base, (mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
-	sys_write32(0x0, (mem_addr_t) &reg_base->base_addr_msb[config->mbx_idx]);
-	sys_write32(config->data_size, (mem_addr_t) &reg_base->q_size[config->mbx_idx]);
-	sys_write32(0x0, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
-	sys_write32(0x0, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
+	fs_ipm_write32(config->data_base, (mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
+	fs_ipm_write32(0x0, (mem_addr_t) &reg_base->base_addr_msb[config->mbx_idx]);
+	fs_ipm_write32(config->data_size, (mem_addr_t) &reg_base->q_size[config->mbx_idx]);
+	fs_ipm_write32(0x0, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	fs_ipm_write32(0x0, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
 
+	CFG_HBW_ADDR_MNPL(0);
 	/* Clear mailbox buffer */
 	memset((void *)config->data_base, 0x0, config->data_size);
+	CFG_HBW_ADDR_MNPL(1);
 
 	/* init mbx buffer data */
 	ipm_fs_init_mbx_data(dev);
diff --git a/drivers/ipm/ipm_fs.h b/drivers/ipm/ipm_fs.h
