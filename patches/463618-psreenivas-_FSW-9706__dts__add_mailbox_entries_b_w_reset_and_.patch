 	LOG_INSTANCE_PTR_DECLARE(log);
 };
diff --git a/drivers/ipm/ipm_fs_rx.c b/drivers/ipm/ipm_fs_rx.c
index 9a29a5d..2016be8 100644
--- a/drivers/ipm/ipm_fs_rx.c
