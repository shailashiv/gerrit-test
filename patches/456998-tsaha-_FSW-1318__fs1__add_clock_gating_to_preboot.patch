From a07ad3f9fff8711194188b953988ec1066621131 Mon Sep 17 00:00:00 2001
From: Tamal <tasaha@habana.ai>
Date: Thu, 17 Oct 2024 12:07:02 +0300
Subject: [PATCH] [FSW-1318] fs1: add clock gating to preboot

This patch enables clock gating driver in
preboot application.

Change-Id: Iaebd4d186c1a7b9debdcb9db988ff50991c67c67
Signed-off-by: Tamal <tasaha@habana.ai>
---

diff --git a/boards/intel/fs/fs1_preboot_asic_defconfig b/boards/intel/fs/fs1_preboot_asic_defconfig
index 26fcc69..ea2db2d 100644
--- a/boards/intel/fs/fs1_preboot_asic_defconfig
+++ b/boards/intel/fs/fs1_preboot_asic_defconfig
@@ -46,3 +46,4 @@
 CONFIG_CLOCK_CONTROL_HL_PLL_V2=y
 CONFIG_GPU_UTILS=y
 CONFIG_CRC=y
+CONFIG_CLOCK_GATING=y
