diff --git a/connection/pci_i2c_connection.py b/connection/pci_i2c_connection.py
index c3b238b..333f365 100644
--- a/connection/pci_i2c_connection.py
+++ b/connection/pci_i2c_connection.py
@@ -7,6 +7,7 @@
 * Proprietary and confidential.
 ****************************************************************************
 """
+import os
 from os import path
 from connection.base_connection import BaseConnection, BaseStubConnection, BaseRemoteConnection
 
@@ -37,8 +38,8 @@
 
 class LocalPciI2cConnection(BaseConnection):
     type = "pci"
-    _pci_root_path = "/sys/kernel/debug/habanalabs"
-    _pci_path = _pci_root_path + "/hl%d"
+    _pci_root_path = "/sys/kernel/debug/accel"
+    _pci_path = _pci_root_path + "/%s"
     _max_pci_devices = 20
 
     _pci_i2c_bus_file = _pci_path + "/i2c_bus"
@@ -47,7 +48,9 @@
     _pci_i2c_data_file = _pci_path + "/i2c_data"
 
     def __init__(self, device_id=0):
-        self._device_id = device_id
+        # convert to pci address
+        self._device_id =  os.listdir(self._pci_root_path)[device_id] #"0000:08:00.0"
+
         self._bus_file_name = None
         self._address_file_name = None
         self._register_file_name = None
@@ -182,8 +185,9 @@
         # Arguments are accessed directly using the frame
         # pylint:disable=unused-argument
         added_args = ''
-        if self._device_id != 0:
-            added_args = 'device_id=%d' % self._device_id
+        # if self._device_id != 0:
+        #     added_args = 'device_id=%d' % self._device_id
+        added_args = 'device_id=%d' % self._device_id
         res, output = self._execute_remote_function(added_args)
         if res != 0:
             self._logger.error("failed to read from bus %d, address 0x%x, register 0x%x, #FAIL_DETAIL#",
diff --git a/hw_manager/components/machx.py b/hw_manager/components/machx.py
index 3d37381..e11ce2f 100644
--- a/hw_manager/components/machx.py
+++ b/hw_manager/components/machx.py
@@ -18,11 +18,17 @@
     def __init__(self, component_config, identifier):
         super(MACHX, self).__init__(component_config, identifier)
         self.MACHX_USB_I2C = None
+        self.MACHX_PCI_I2C = None
         try:
             self.MACHX_USB_I2C = self.get_control(hw_manager.controls.usb_i2c_registers)  # USB I2C Control
         except:
             pass
 
+        try:
+            self.MACHX_PCI_I2C = self.get_control(hw_manager.controls.pci_i2c_registers)  # PCI I2C Control
+        except:
+            pass
+
     # CPLD Power Cycle
     def power_cycle(self):
         # Register, Bit, Value
diff --git a/hw_manager/interfaces/pci_i2c.py b/hw_manager/interfaces/pci_i2c.py
index 5b89f15..0672775 100644
--- a/hw_manager/interfaces/pci_i2c.py
+++ b/hw_manager/interfaces/pci_i2c.py
@@ -27,7 +27,7 @@
 
         # set i2c_bus and i2c_address
         if bus is None:
-            self.i2c_bus = 0
+            self.i2c_bus = 1 # should be 1
         else:
             self.i2c_bus = bus
         self.i2c_address = i2c_address
