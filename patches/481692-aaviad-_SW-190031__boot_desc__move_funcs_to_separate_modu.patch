-		idx = 1;
-		break;
-	case IMG_IDX_AUTO:
-	default:
-		idx = img_desc->idx;
-		if (upd_status == FLOPS_UPD_PENDING)
-			idx = (idx + 1) % 2;
-		break;
-	}
-
-	LOG_INF("using index: 0x%08x", idx);
-
-	desc->spi_offset = img_desc->offset[idx];
-	desc->img_size = img_desc->size[idx];
-	desc->loadaddr = ((u64)img_desc->load_high[idx] << 32) | img_desc->load_low[idx];
-	desc->desc_ver = img_desc->desc_ver;
-	if (desc->desc_ver >= MULTI_CSUM_BOOT_VER)
-		memcpy(desc->chksum, img_desc->chksum2[idx],
-			ARRAY_SIZE(desc->chksum));
-	else
-		memcpy(desc->chksum, img_desc->chksum[idx],
-			ARRAY_SIZE(desc->chksum));
-
-	if (desc->desc_ver >= DESC_VER_BOOT_VER)
-		memcpy(desc->version, img_desc->version, HL_IMG_VERSION_SIZE);
-	else
-		memset(desc->version, 0, HL_IMG_VERSION_SIZE);
-
-	return idx;
-}
