 	if (boot_rom_process_dma_err(err, img_sts_base)) {
-		boot_rom_report_image_status(manifest_idx, CRC_FAIL);
+		boot_rom_report_image_status(man_idx, CRC_FAIL);
 		return BOOT_ROM_FAIL;
