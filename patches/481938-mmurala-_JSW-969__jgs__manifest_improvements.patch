From 0eb353b18e43798d073b148795feb7e811c79ede Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Mon, 16 Jun 2025 16:57:13 +0300
Subject: [PATCH] [JSW-969] jgs: manifest improvements

This patch has changes related to boot flow to
simplify the usage of manifest index and type.
Added simplified prefetch status structure to
maintain prefetch status as done, failed, valid,
and manifest index based on fw update/flip.
Used very simple approach to maintain manifest
type with structure array, to avoid frequent
manifest index switching based on type.

Change-Id: I92fd1f9e4b89c7bb82c44b9986bd9123e3d20cc3
---

diff --git a/app/boot_rom.c b/app/boot_rom.c
index 8819a86..6683a88 100644
--- a/app/boot_rom.c
+++ b/app/boot_rom.c
@@ -59,7 +59,7 @@
 	}
 
 	/* If any ppboot secondary prefetch is not done, start prefetch */
-	if (boot_rom_boot_flow_is_secondary_manifest_valid())
+	if (boot_rom_boot_flow_is_manifest_valid(BOOT_ROM_SECONDARY))
 		boot_rom_boot_flow_prefetch_img(HL_FW_IMG_PPBOOT);
 
 	if (boot_rom_boot_flow_is_ppboot_valid(BOOT_ROM_PRIMARY)) {
diff --git a/arch/jgs/arc/common.c b/arch/jgs/arc/common.c
