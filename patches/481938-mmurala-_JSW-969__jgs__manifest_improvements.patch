+	if (boot_desc_get_img_desc(man_idx, img_type, desc, 0) != BOOT_ROM_SUCCESS) {
 		boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_NO_IMG_DESC);
 		return BOOT_ROM_FAIL;
 	}
@@ -48,11 +57,11 @@
 	    != BOOT_ROM_SUCCESS)
