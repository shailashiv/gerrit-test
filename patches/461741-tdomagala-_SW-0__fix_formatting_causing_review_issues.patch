+void Node::eraseOutput(size_t i) {
+  HABANA_ASSERT(i < outputs_.size());
+  HABANA_ASSERT(outputs_[i]->uses().empty());
+  op_ = nullptr;
+  Value* n = outputs_[i];
+  outputs_.erase(outputs_.begin() + i);
+  owningGraph()->freeValue(n);
+  for (const auto j : c10::irange(i, outputs_.size())) {
+    outputs_[j]->offset_--;
+  }
+}
