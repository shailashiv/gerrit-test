+
+void Node::eraseBlock(size_t i) {
+  HABANA_ASSERT(i < blocks_.size());
+  op_ = nullptr;
+  Block* n = blocks_[i];
+  blocks_.erase(blocks_.begin() + i);
+  n->destroy();
+}
+
+void Node::destroy() {
+  while (!outputs().empty()) {
+    eraseOutput(outputs().size() - 1);
+  }
+  while (!blocks().empty()) {
+    eraseBlock(blocks().size() - 1);
+  }
+  removeAllInputs();
+  if (inBlockList()) {
     removeFromList();
