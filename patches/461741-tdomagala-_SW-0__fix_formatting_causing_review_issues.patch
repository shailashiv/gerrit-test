+    // AliasAnalysisKind::CONSERVATIVE but this is the intended behavior for
+    // all current ops and a good error check. We can consider lifting this
+    // constraint later if we have a use case for it.
+
+    HABANA_ASSERT(
+        (op->aliasAnalysisKind() ==
+             c10::AliasAnalysisKind::INTERNAL_SPECIAL_CASE ||
+         op->aliasAnalysisKind() == c10::AliasAnalysisKind::FROM_SCHEMA ||
+         op->aliasAnalysisKind() == c10::AliasAnalysisKind::CONSERVATIVE),
+        "aten:: and prim:: ops should have c10::AliasAnalysisKind::INTERNAL_SPECIAL_CASE, c10::AliasAnalysisKind::FROM_SCHEMA or c10::AliasAnalysisKind::CONSERVATIVE but",
+        kind_.toDisplayString(),
