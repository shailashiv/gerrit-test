diff --git a/tools/GUI/Widget/create_config_dut.py b/tools/GUI/Widget/create_config_dut.py
index 851f088..f64b527 100644
--- a/tools/GUI/Widget/create_config_dut.py
+++ b/tools/GUI/Widget/create_config_dut.py
@@ -80,19 +80,32 @@
         command = ""
         if self.label_name == "Set Fan Speed":
             selected = self.combo_var.get()
-            command = "echo '%s' | " % self.values.index(selected)
+            command = "echo '%s' | " % (self.values.index(selected) + 1)
         command += self.data["command"]
 
         options = dict(self.data["config_dut"]["options"])
         if self.label_name in options.keys():
             command += " " + options[self.label_name]["flag"]
 
+        if self.label_name == "Set Strap":
+            command = command + " " + self.combo_var.get() + " " + self.entry_var.get()
+        if self.label_name in ["Set C_VDD & D2D_VDD Value", "Set C_VDD Value", "Set D2D_VDD Value"]:
+            value = int(self.entry_var.get())
+            if value < options[self.label_name]["min_value"] or value > options[self.label_name]["max_value"]:
+                self.show_error("please put value between %s-%s" % (
+                options[self.label_name]["min_value"], options[self.label_name]["max_value"]))
+                return
+            command = command + " " + str(value)
         print(f"Executing: {command}")
 
         # Run command in a separate thread
         thread = threading.Thread(target=self.run_command, args=(command,))
         thread.start()
 
+    def show_error(self, messge):
+        from tkinter import messagebox
+        messagebox.showerror("Error", messge)
+
