---

diff --git a/docs/Pytorch_Operators.rst b/docs/Pytorch_Operators.rst
index 56a0f3d..5c59484 100644
--- a/docs/Pytorch_Operators.rst
+++ b/docs/Pytorch_Operators.rst
@@ -81,6 +81,7 @@
 tanh                                     Yes      Yes      Yes       No       No        No       No     torch.nn.functional
 threshold                                Yes      Yes      No        No       No        No       No     torch.nn.functional
 upsample                                 Yes      Yes      Yes       No       No        No       No     torch.nn.functional
+upsample_bilinear                        Yes      Yes      Yes       No       No        No       No     torch.nn.functional
 upsample_nearest                         Yes      Yes      Yes       No       No        No       No     torch.nn.functional
