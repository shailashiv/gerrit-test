diff --git a/scripts/hpu_op.yaml b/scripts/hpu_op.yaml
index 7a669b2..4beeb2b 100644
--- a/scripts/hpu_op.yaml
+++ b/scripts/hpu_op.yaml
@@ -6697,6 +6697,30 @@
     Gaudi2: [BFloat16, Float, Half]
     Gaudi3: [BFloat16, Float, Half]
 
+_upsample_bilinear2d_aa.out:
+  custom_fill_params: FillBilinearFwdParams
+  output_meta: UpsampleBilinear2DFwdMeta
+  dtypes:
+    Gaudi: [BFloat16, Float]
+    Gaudi2: [BFloat16, Float, Half]
+    Gaudi3: [BFloat16, Float, Half]
+  guid: resize_fwd
+  synapse_layouts:
+  - [WHCN, WHCN]
+  - [WHCN]
+
+_upsample_bilinear2d_aa_backward.grad_input:
+  custom_fill_params: FillBilinearBwdParams
+  output_meta: UpsampleBilinear2DBwdMeta
+  dtypes:
+    Gaudi: [BFloat16, Float]
+    Gaudi2: [BFloat16, Float, Half]
+    Gaudi3: [BFloat16, Float, Half]
+  guid: resize_bwd
+  synapse_layouts:
+  - [WHCN, WHCN]
+  - [WHCN]
+
 upsample_bilinear2d_backward:
   custom_fill_params: FillBilinearBwdParams
   output_meta: UpsampleBilinear2DBwdMeta
diff --git a/tests/cpp/hpu_ops/upsample_bilinear2d.cpp b/tests/cpp/hpu_ops/upsample_bilinear2d.cpp
index 0413c5f..f11f0d9 100644
--- a/tests/cpp/hpu_ops/upsample_bilinear2d.cpp
+++ b/tests/cpp/hpu_ops/upsample_bilinear2d.cpp
@@ -247,4 +247,153 @@
       {},
       result);
   Compare(expected, result);
-}
\ No newline at end of file
+}
+
+// antialiasing variants
+
+TEST_F(HpuOpTest, _upsample_bilinear2d_aa_fwd_scale_CL) {
+  GenerateInputs(1, {{2, 7, 3, 4}});
+  std::vector<double> scale_factor = {1.999, 2.999};
+
+  auto expected = torch::_upsample_bilinear2d_aa(
+      GetCpuInput(0).to(c10::MemoryFormat::ChannelsLast),
+      c10::nullopt,
+      /*align_corner*/ false,
+      scale_factor);
+  auto result = torch::_upsample_bilinear2d_aa(
+      GetCpuInput(0).to(c10::MemoryFormat::ChannelsLast).to("hpu"),
+      c10::nullopt,
+      /*align_corner*/ false,
+      scale_factor);
+  Compare(expected, result);
+}
+TEST_F(HpuOpTest, _upsample_bilinear2d_aa_fwd_scale) {
+  GenerateInputs(1, {{2, 7, 3, 4}});
+  std::vector<double> scale_factor = {1.999, 2.999};
+
+  auto expected = torch::_upsample_bilinear2d_aa(
+      GetCpuInput(0),
+      c10::nullopt,
+      /*align_corner*/ false,
+      scale_factor);
+  auto result = torch::_upsample_bilinear2d_aa(
+      GetHpuInput(0),
+      c10::nullopt,
+      /*align_corner*/ false,
+      scale_factor);
+  Compare(expected, result);
+}
+//
+TEST_F(HpuOpTest, _upsample_bilinear2d_aa_fwd_scale_zero_CL) {
+  GTEST_SKIP(); // [SW-186353] Unsupported test configuration
+  GenerateInputs(1, {{2, 7, 3, 4}});
+  std::vector<double> scale_factor = {0.6, 1.7};
+
+  auto expected = torch::_upsample_bilinear2d_aa(
+      GetCpuInput(0).to(c10::MemoryFormat::ChannelsLast),
