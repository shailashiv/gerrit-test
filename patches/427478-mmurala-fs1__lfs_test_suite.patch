+void read_records(char *int_names[])
+{
+	char result[50];
+	uint32_t count = 0, res;
+	struct student data2 = { 0 };
+
+	for (count = 1; count < 5; count++) {
+		memset(&data2, 0, sizeof(data2));
+		if (lfs_file_copy(LFS_TAG_BOOT_INFO, count, &data2, sizeof(data2))) {
+			boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_INVALID);
+			//return;
+		}
+		res = sprintf(result, "roll-%d, age-%d, name-%s", data2.roll_num, data2.age, data2.name);
+		put_str(result, res);
+
+		if ((data2.age != count+5) ||
+			(data2.roll_num != count) ||
+			(strcmp(data2.name, int_names[count-1]) != 0)) {
+			boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_DATA_GET_FAIL);
+		}
+	}
+}
