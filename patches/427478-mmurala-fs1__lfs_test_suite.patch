+/* TO make sure after every data write data written to disk instead of cache */
+#define FILE2 23
+void write_test_below_cache_size()
+{
+	char name[13] = "abcdefghijkl";
+	char name2[13] = "mnopqrstuvwx";
+
+	if (lfs_file_set(LFS_TAG_BOOT_INFO, FILE1, name, strlen(name))) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FAIL);
+		return;
+	}
+
+	if (lfs_file_set(LFS_TAG_BOOT_INFO, FILE2, name2, strlen(name))) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FAIL);
+		return;
+	}
+}
+void boot_rom_get_boot_info(void)
+{
+	if (boot_rom_global.boot_info_set_done) {
+		/* Read and make sure proper data after any reset */
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_START);
+
+		/* TODO: retrieve boot info and verify */
+
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_FINISH);
+	}
+
+	/* Flag which is indication for other modules to know Boot ROM done with LFS */
+	boot_rom_status_update(PROGRESS_BOOT_INFO_LFS_FINISHED);
+}
+void boot_rom_set_boot_info(void)
+{
+	uint32_t count = 0;
+	struct student data = { 0 };
+
+	struct fs1_cold_rst_data cold_rst_data;
+
+	if(boot_rom_skip_boot_info())
+		return;
+
+	// write_test_below_cache_size();
+	// return;
+
+	if (!boot_rom_global.boot_info_set_done) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_START);
+
+		/* INFO: save records */
+		/* file name cant be 0 as we use name type tag "br" for boot_rom */
+		for (count = 1; count < 5; count++) {
+			memset(&data, 0, sizeof(data));
+			data.roll_num = count;
+			data.age = count + 5;
+			memcpy(data.name, names[count-1], strlen(names[count-1]));
+
+			if (lfs_file_set(LFS_TAG_BOOT_INFO, count, &data, sizeof(data))) {
+				boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FAIL);
+				return;
+			}
+		}
+
+		//resize_disk();
+
+		/* INFO: retrieve records */
+		read_records(names);//working
+
+#if 1
+		/* INFO: write partial */
+		for (count = 1; count < 5; count++) {
+			memset(&data, 0, sizeof(data));
+
+			memcpy(data.name, names_1[count-1], strlen(names_1[count-1]));
+			if(lfs_file_set_partial(LFS_TAG_BOOT_INFO, count, names_1[count-1],
+					(sizeof(data.roll_num) + sizeof(data.age)), strlen(names_1[count-1]) )) {
+				boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FAIL);
+				return;
+			}
+		}
+
+		/* INFO: retrieve records */
+		read_records(names_1);//working
+#endif
+
+		put_str("end", 3);
+
+		cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		cold_rst_data.boot_info_set_done = 1;
+		regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FINISH);
+	} else {
+		/* Read and make sure databackup after any reset */
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_START);
+
+		read_records(names_1);
+
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_FINISH);
+	}
+
+	return;
+}
+
+void custom_printf(const char *format, uint32_t value1, uint32_t value2) {
+    char buffer[100];  // Adjust the size as needed
+	int len;
+
+    // Format the string using snprintf
+    len = snprintf(buffer, sizeof(buffer), format, value1, value2);
+
+    // Print the formatted string
+    put_str(buffer, len + 1);
+}
