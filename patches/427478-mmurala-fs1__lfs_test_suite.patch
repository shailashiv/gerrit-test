+	char temp[10] = "xyz";
+	char data[20];
+
+	if(lfs_file_set_partial(LFS_TAG_BOOT_INFO, FILE1, temp, 5, 3)) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_SECURITY_DATA_SET_FAIL);
+		return;
+	}
+
+	print_file_size(FILE1);
+
+	if (lfs_file_copy(LFS_TAG_BOOT_INFO, FILE1, data, 8)) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_INVALID);
+		return;
+	}
+
+	put_str(data, 8);
