+	uint32_t roll_num;
+	uint32_t age;
+	char name[10];
+};
+
+#define LFS_EXT_IMPLEMENTATION 1
+
+#if LFS_EXT_IMPLEMENTATION == 1
+extern lfs_t lfs;
+extern struct lfs_file_config defaults;
+
+int boot_info_get_size(__unused char *tag, __unused enum hl_boot_info_type file_num, uint32_t *size)
+{
+	static char full_name[LFS_NAME_MAX] = { '\0' };
+	lfs_file_t file;
+	int ret;
+
+	ret = lfs_init_disk();
+	if (ret)
+		return ret;
+
+	lfs_get_file_name(full_name, tag, file_num);
+	ret = lfs_file_opencfg(&lfs, &file, full_name, LFS_O_RDONLY, &defaults);
+	if (ret < 0) {
+		*size = 0;
+		return 0;
+	}
+
+	*size = (uint32_t)lfs_file_size(&lfs, &file);
+
+	lfs_file_close(&lfs, &file);
+
+	return ret;
+}
+/* Modify data inside an existing info. Same constraints as lfs_file_set() */
+int lfs_file_set_partial(__unused char *tag, __unused enum hl_boot_info_type file_num, const void *data, uint32_t offset, uint32_t size)
+{
+	static char full_name[LFS_NAME_MAX] = { '\0' };
+	lfs_file_t file;
+	int ret;
+	size_t fsize;
+
+	ret = lfs_init_disk();
+	if (ret)
+		return ret;
+
+	lfs_get_file_name(full_name, tag, file_num);
+	ret = lfs_file_opencfg(&lfs, &file, full_name, LFS_O_RDWR | LFS_O_CREAT, &defaults);
+	if (ret < 0)
+		return ret;
+
+	fsize = lfs_file_size(&lfs, &file);
+	if (fsize > size + offset) {
+		ret = lfs_file_truncate(&lfs, &file, size + offset);
+	}
+
+	if (!ret) {
+		lfs_file_seek(&lfs, &file, offset, LFS_SEEK_SET);
+		ret = lfs_file_write(&lfs, &file, data, size);
+	}
+
+	lfs_file_close(&lfs, &file);
+
+	return ret >= 0 ? 0 : ret;
+}
+#endif
+
+void boot_rom_putc(const char ch)
+{
+	while ((regmap_readl(IO0_H0_PSOC_CFG_UART(mmUART_STATE)) & UART_SR_TXFULL) != 0);
+	regmap_writel(ch, IO0_H0_PSOC_CFG_UART(mmUART_DATA));
+}
+
+void new_line()
+{
+	boot_rom_putc('\r');
+	boot_rom_putc('\n');
+}
+
+void put_str(char *str, uint32_t size)
+{
+	uint32_t i;
+	new_line();
+	for (i = 0 ; i< size ; i++) {
+		boot_rom_putc(str[i]);
+	}
+	new_line();
+}
+
+int print_file_size(int file)
+{
+	uint32_t size = 0, len;
+	char data[20];
+
+	boot_info_get_size(LFS_TAG_BOOT_INFO, file, &size);
+	len = sprintf(data, "size - %d", size);
+	put_str(data, len);
+	return size;
+}
+
+bool boot_rom_skip_boot_info(void)
+{
+	if (boot_rom_global.die_type != FS1_IO_DIE_MASTER)
+		return true;
+
+	/* check boot info efuse
+	* if (EFUSE_SKIP_BOOT_INFO == 1)
+	* 	return true;
+	*/
+
+	return false;
+}
+
+void file_read_test()
+{
+	char data[20];
+	int size;
+
+	size = print_file_size(FILE1); /* size provided by user at the time of write.*/
+	if (lfs_file_copy(LFS_TAG_BOOT_INFO, FILE1, data, size)) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_INVALID);
+		return;
+	}
+	put_str(data, size);
+}
+
+void set_part_test_shrink()
+{
