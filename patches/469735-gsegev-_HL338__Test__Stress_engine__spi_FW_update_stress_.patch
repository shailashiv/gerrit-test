@@ -386,6 +386,7 @@
                         operation=f"Error occurred during get_VRM_version: {error_message}")
             return True, {"status": False, "error_message": error_message}
 
+
     # todo: Before using this operation make sure the driver is UN-LOADED
     def run_Austin_SBR(self, test_name, iteration, op_idx):
         try:
@@ -487,4 +488,50 @@
         output = return_code.stdout.strip()
         return return_code.returncode, output
 
+    def burn_cards_fw(self, test_name, op_idx, iteration,  fw_path):
+        try:
+            # Get device_cli and driver_cli
+            host = hw_manager.get_machine_component("pci_machine")
+            device_cli = host.get_control(hw_manager.controls.device_cli)
+            driver_cli = host.get_control(hw_manager.controls.driver_cli)
+
+            # Verify fw_path is indeed located on host
+            find_cmd = ("find " + fw_path)
+            code, stdout = device_cli.execute_command(find_cmd)
+            if code == 0 and stdout[0] == fw_path:
+                hlsa_logger(level='debug', ident='Description', test_code='burn_cards_fw',
+                            operation='FW package path exist on host', result='SUCCESS')
+            else:
+                hlsa_logger(level='debug', ident='Description', test_code='burn_cards_fw',
+                            operation='FW package was not found on host', result='FAIL')
+                assert False, "FW package: %s was not found on host" % fw_path
+            # Burn FW on flash
+            hlsa_logger(level='debug', ident='Description', test_code='HL325_FW_UPDATE',
+                        operation='Test Initialization Failure',
+                        read_value='Burn firmware package %s: ' % fw_path)
+            burn_status = driver_cli.flash_firmware_file(fw_path, 'host_pc')
+            hlsa_checker.check_status_is_true(burn_status, ident='Description', test_code='burn_cards_fw',
+                                              operation='Test Initialization Failure',
+                                              read_value='Burning firmware %s to flash SPI: ' % fw_path)
+
+            # # Check fw version changed
+            # cmd = "cd " + fw_path.replace("gaudi3-agent-fw_loader-fit.itb", "") + " && cat hl-fw-version.txt"
+            # code, fw_ver = device_cli.execute_command(cmd)
+            # hlsa_checker.check_status_is_true(code == 0, ident='Description', test_code='HL325_FW_UPDATE',
+            #                                   operation='can\'t read fw_version txt_file')
+            # code, stdout = device_cli.execute_command("sudo hl-fw-loader -v")
+            # hlsa_checker.check_status_is_true(code == 0, ident='Description', test_code='HL325_FW_UPDATE',
+            #                                   operation='can\'t read fw_version with: sudo hl-fw-loader -v')
+            # hlsa_checker.check_status_is_true(fw_ver in stdout, ident='Description', test_code='HL325_FW_UPDATE',
+            #                                   operation='fw_ver successfully updated in iteration: %s' % iteration)
+
+            return True, {"status": burn_status}
+        except Exception as e:
+            error_message = str(e)
+            hlsa_logger(level='error', ident='Description',
+                        operation=f"burn_cards_fw: {error_message}")
+            return True, {"status": False, "error_message": error_message}
+
+
+
 
