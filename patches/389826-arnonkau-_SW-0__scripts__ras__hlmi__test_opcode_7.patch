+	sts=$(hlmi_ca_wfs 4 0.3)
+	if [ $? -ne 0 ]; then
+		echo '[Timeout] Read' $*
+		return 1
+	fi
+	[ $((sts)) -eq 0 ] && {
+		hlmi_ca_read_data
+		return 0
+	} || return 1
+}
+
