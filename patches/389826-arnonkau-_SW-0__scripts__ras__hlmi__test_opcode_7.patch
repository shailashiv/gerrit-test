@@ -0,0 +1,410 @@
+# Script to test using RAS config access by running FW loader
+# protocol using the hlmi-test raw mode.
+# Using Opcode - 7
+
+if [ -z $oamid ]; then
+	export oamid=1
+fi
+
+hlmi_long_to_args()
+{
+	local val
+
+	val=$(printf "%08x" $(($1)))
+	echo ${val:6:2} ${val:4:2} ${val:2:2} ${val:0:2}
+}
+
+hlmi_long_long_to_args()
+{
+	local val
+
+	val=$(printf "%016x" $(($1)))
+	echo ${val:14:2} ${val:12:2} ${val:10:2} ${val:8:2} ${val:6:2} ${val:4:2} ${val:2:2} ${val:0:2}
+}
+
+hlmi_args_to_long_str()
+{
+	printf "0x%s%s%s%s" $4 $3 $2 $1
+}
+
+hlmi_args_to_long_long_str()
+{
+	printf "0x%s%s%s%s%s%s%s%s" $8 $7 $6 $5 $4 $3 $2 $1
+}
+
+hlmi_args_to_long()
+{
+	local val
+	val=$(hlmi_args_to_long_str $*)
+	echo $((val))
+}
+
+hlmi_args_to_long_long()
+{
+	local val
+	val=$(hlmi_args_to_long_long_str $*)
+	echo $((val))
+}
+
+hlmi_set_oam()
+{
+	export oamid=$1
+}
+
+hlmi_write_raw()
+{
+	local opcode=$1
+	local offset=$2
+	shift 2
+	hlmi-test -d ${oamid} -k 4 -c $opcode -o $offset -l $# -w "$*" > /dev/null 2>&1
+}
+
+hlmi_read_raw()
+{
+	local opcode=$1
+	local offset=$2
+	local len=$3
+	hlmi-test -d ${oamid} -k 4 -c $opcode -o $offset -l $len | awk '/^00/ { $1=""; print $0}'
+}
+
+##############################
+
+hlmi_read_long_long()
+{
+	local val
+	val=$(hlmi_read_raw $1 $2 8)
+	data=$(hlmi_args_to_long_long $val)
+	printf "0x%08x" $data
+}
+
+hlmi_read_long()
+{
+	local val
+	val=$(hlmi_read_raw $1 $2 4)
+	data=$(hlmi_args_to_long $val)
+	printf "0x%08x" $data
+}
+
+hlmi_read_short()
+{
+
+	local val
+	val=$(hlmi_read_raw $1 $2 2)
+	data=$(hlmi_args_to_long $val)
+	printf "0x%04x" $data
+}
+
+hlmi_read_byte()
+{
+
+	local val
+
+	val=$(hlmi_read_raw $1 $2 1 | cut -d' ' -f2)
+	printf "0x%s" ${val:-5}
+
+	[ -z $val ] && return 1 || return 0
+}
+
+hlmi_write_byte()
+{
+	hlmi_write_raw $1 $2 $3
+}
+
+hlmi_write_long()
+{
+	local val
+
+	val=$(hlmi_long_to_args $3)
+	hlmi_write_raw $1 $2 $val
+}
+
+##############################
+
+hlmi_ca_read_address()
+{
+	hlmi_read_long 7 0
+}
+
+hlmi_ca_read_data()
+{
+	hlmi_read_long 7 4
+}
+
+hlmi_ca_read_cmd()
+{
+	hlmi_read_byte 7 8
+}
+hlmi_ca_read_status()
+{
+	hlmi_read_byte 7 9
+}
+
+hlmi_ca_write_address()
+{
+	hlmi_write_long 7 0 $1
+}
+
+hlmi_ca_write_data()
+{
+	hlmi_write_long 7 4 $1
+}
+
+hlmi_ca_write_cmd()
+{
+	hlmi_write_byte 7 8 $1
+}
+hlmi_ca_write_status()
+{
+	hlmi_write_byte 7 9 $1
+}
+
+##############################
+
+hlmi_ca_read_all_fields_helper()
+{
+	local address
+	local data
+	local cmd
+	local status
+
+	address=$(hlmi_args_to_long $1 $2 $3 $4)
+	data=$(hlmi_args_to_long $5 $6 $7 $8)
+	cmd=$(($9))
+	status=$(($10))
+
+	printf "0x%08x 0x%08x %d %d" ${address} ${data} ${cmd} ${status}
+	return $status
+}
+
+hlmi_ca_read_all_fields()
+{
+	local ans
+	ans=$(hlmi_read_raw 7 0 10)
+	hlmi_ca_read_all_fields_helper $ans
+}
+
+hlmi_ca_write_all_fields()
+{
+	local address
+	local data
+	local cmd
+
+	address=$(hlmi_long_to_args $1)
+	data=$(hlmi_long_to_args $2)
+	cmd=$(printf "%02x" $3)
+	hlmi_write_raw 7 0 $address $data $cmd
+}
+
+hlmi_ca_wfs_2()
+{
+	local sts
+	local loops=0
+
+	while : ; do
+		sts=$(hlmi_ca_read_status)
+		#ans=$(hlmi_ca_read_all_fields)
+
+		if [ ${sts} -eq 0 ]; then
+			echo 0
+			return 0
+		elif [ ${sts} -eq 1 ]; then
+			echo 1
+			return 0
+		fi
+		if [ $((loops)) -gt 4 ]; then
+			return 1
+		fi
+		loops=$(( loops ++ ))
+		sleep 0.3
+	done
+}
+
+
+hlmi_ca_wfs()
+{
+	local sts
+	local loops=0
+	local max_loops=$1
+	local tsleep=$2
+
+	while : ; do
+		sts=$(hlmi_ca_read_status)
+		#ans=$(hlmi_ca_read_all_fields)
+
+		if [ $((sts)) -eq 0 ]; then
+			echo 0
+			return 0
+		elif [ $((sts)) -eq 1 ]; then
+			echo 1
+			return 0
+		fi
+		if [ $((loops)) -gt $((max_loops)) ]; then
+			return 1
+		fi
+
+		loops=$(( loops ++ ))
+		sleep $tsleep
+	done
+}
+
+#######################################################################
+
+hlmi_write_reg()
+{
+	local sts
+	local address
+	local data
+
+	address=$(hlmi_long_to_args $1)
+	data=$(hlmi_long_to_args $2)
+
+	hlmi_write_raw 7 0 ${address} ${data} 00
+	sts=$(hlmi_ca_wfs 4 0.3)
+	if [ $? -ne 0 ]; then
+		echo '[Timeout] Write ' $*
+		return 1
+	fi
+	[ $((sts)) -eq 0 ] && return 0 || return 0
+}
+
+hlmi_read_reg()
+{
+	local sts
+	local address
+	local data
+	address=$(hlmi_long_to_args $1)
+
+	hlmi_write_raw 7 0 $address 00 00 00 00 01
+	sts=$(hlmi_ca_wfs 4 0.3)
+	if [ $? -ne 0 ]; then
+		echo '[Timeout] Read' $*
+		return 1
+	fi
+	[ $((sts)) -eq 0 ] && {
+		hlmi_ca_read_data
+		return 0
+	} || return 1
+}
+
+#######################################################################
+
+hlmi_mcpy_read_address()
+{
+	hlmi_read_long_long 21 0
+}
+
+hlmi_mcpy_read_size()
+{
+	hlmi_read_long 21 8
+}
+
+hlmi_mcpy_read_cmd()
+{
+	hlmi_read_byte 21 12
+}
+hlmi_mcpy_read_status()
+{
+	hlmi_read_byte 21 13
+}
+
+hlmi_mcpy_write_address()
+{
+	hlmi_write_long 21 0 $1
+}
+
+hlmi_mcpy_write_size()
+{
+	hlmi_write_long 21 8 $1
+}
+
+hlmi_mcpy_write_cmd()
+{
+	hlmi_write_byte 21 12 $1
+}
+hlmi_mcpy_write_status()
+{
+	hlmi_write_byte 21 13 $1
+}
+
+hlmi_mcpy_write_data()
+{
+	local offset=$1
+	local len=$2
+	hlmi_write_raw 22 $offset $len
+}
+
+hlmi_mcpy_read_data()
+{
+	hlmi_read_raw 22 0 255
+}
+
+##############################
+hlmi_wait_for_reg_value()
+{
+	local is_not=$1
+	local reg=$2
+	local value=$3
+	local mask=$4
+	local tout=$5
+	local max_loops=$6
+	local loops=0
+	local ans
+
+	while :; do
+		ans=$(hlmi_read_reg $reg)
+		if [ $? -eq 0 ]; then
+			if [ $((is_not)) -eq 0 ]; then
+				if [ $((ans & mask)) -eq $((value)) ]; then
+					printf "0x%08x" $((ans))
+					return 0
+				fi
+			else
+				if [ $((ans & mask)) -ne $((value)) ]; then
+					printf "0x%08x" $((ans))
+					return 0
+				fi
+			fi
+		fi
+		if [ $((loops)) -gt $((max_loops)) ]; then
+			return 1
+		fi
+
+		loops=$(( loops ++ ))
+		sleep $tout
+	done
+
+	echo "ERROR ERROR ERROR"
+}
+
+
