+export g_sts=0
+export g_sts_id=0
+export g_sts_val=0
+
+hlmi_parse_status()
+{
+	g_sts_id=$(echo $g_sts | cut -d' ' -f1)
+	g_sts_val=$(echo $g_sts | cut -d' ' -f2)
+}
+
+hlmi_wfs_change()
+{
+	local g_new_sts=0
+	g_new_sts=$(hlmi_wait_for_change $g_sts 0xf0000000)
+	echo
+	echo "STATUS Change $g_sts => $g_new_sts"
+	g_sts=$g_new_sts
+	hlmi_parse_status
+	printf "STATUS: cmd=%d offset=0x%08x\n" ${g_sts_id:--1} ${g_sts_val:-0xffffffff}
+}
