+##############################
+hlmi_wait_for_reg_value()
+{
+	local is_not=$1
+	local reg=$2
+	local value=$3
+	local mask=$4
+	local tout=$5
+	local max_loops=$6
+	local loops=0
+	local ans
+
+	while :; do
+		ans=$(hlmi_read_reg $reg)
+		if [ $? -eq 0 ]; then
+			if [ $((is_not)) -eq 0 ]; then
+				if [ $((ans & mask)) -eq $((value)) ]; then
+					printf "0x%08x" $((ans))
+					return 0
+				fi
+			else
+				if [ $((ans & mask)) -ne $((value)) ]; then
+					printf "0x%08x" $((ans))
+					return 0
+				fi
+			fi
+		fi
+		if [ $((loops)) -gt $((max_loops)) ]; then
+			return 1
+		fi
+
+		loops=$(( loops ++ ))
+		sleep $tout
+	done
+
+	echo "ERROR ERROR ERROR"
+}
+
+hlmi_wait_for_boot_fit()
+{
+	local ans
+	local err
+
+	ans=$(hlmi_wait_for_reg_value 0 0x04c4b300 0x00000010 0xffffffff 0.5 4)
+	err=$?
+
+	return $err
+}
+
+hlmi_snd_cmd()
+{
+	hlmi_write_reg 0x04c4b16c $1
+}
+
+hlmi_wfs()
+{
+	local val
+
+	val=$(hlmi_wait_for_reg_value $1 0x04c4b168 $2 $3 0.5 4)
+	if [ $? -ne 0 ];then
+		return 1
+	fi
+
+	printf "0x%x 0x%07x" $((val >> 28)) $((val & 0xfffffff))
+	return 0
+}
+
+hlmi_clr_sts()
+{
+	hlmi_snd_cmd 0x10000000
+}
+
+hlmi_rst_state()
+{
+	hlmi_snd_cmd 0x20000000
+}
+
+hlmi_proto_status()
+{
+	hlmi_snd_cmd 0xf0000000
+}
+
+hlmi_cmd_noop()
+{
+	hlmi_snd_cmd 0x00000000
+}
+
+hlmi_wait_for_noop()
+{
+	local ans
+	local err
+	ans=$(hlmi_wfs 0 0x00000000 0xffffffff)
+	err=$?
+	if [ $err -eq 0 ]; then
+		echo "WAIT4NOP: ok"
+	else
+		echo "WAIT4NOP: failed"
+	fi
+	return $err
+}
+
+hlmi_wait_for_no_noop()
+{
+	local ans
+	local err
+
+	ans=$(hlmi_wfs 1 0x00000000 0xf0000000)
+	err=$?
+	if [ $err -eq 0 ]; then
+		echo "WAIT4NONOP: ok"
+	else
+		echo "WAIT4NONOP: failed"
+	fi
+}
+
+hlmi_wait_for_change()
+{
+	hlmi_wfs 1 $1 $2
+}
+
+hlmi_wait_for_rst_ok()
+{
+	hlmi_wfs 0 0x70000000 0xf0000000
+}
