--- a/dts/bindings/d2d/d2d,controller.yaml
+++ /dev/null
@@ -1,15 +0,0 @@
-# Copyright 2022 HabanaLabs, Ltd.
-# SPDX-License-Identifier: Apache-2.0
-
-# Common fields for D2D controller devices
-
-# Copyright 2022 HabanaLabs, Ltd.
-# SPDX-License-Identifier: Apache-2.0
