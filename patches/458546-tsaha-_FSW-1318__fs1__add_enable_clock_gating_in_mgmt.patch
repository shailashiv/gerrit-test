From 062bd739e2957d45bc3144c57a940a67c1201872 Mon Sep 17 00:00:00 2001
From: Tamal <tasaha@habana.ai>
Date: Fri, 25 Oct 2024 12:49:50 +0300
Subject: [PATCH] [FSW-1318] fs1: add enable clock gating in mgmt

This patch enables clock gating at arcmgmt stage.

Change-Id: Ie58ce91bf6038a9de620315115e2c8137f1ee085
Signed-off-by: Tamal <tasaha@habana.ai>
---

diff --git a/arch/fs1/io/device.c b/arch/fs1/io/device.c
index 9f3f9e4..dddb917 100644
--- a/arch/fs1/io/device.c
+++ b/arch/fs1/io/device.c
@@ -26,7 +26,16 @@
 #include <fs1_reg_map.h>
 #include <arc_regs.h>
 #include <zephyr/drivers/misc/hl_cpld/hl_cpld.h>
-
+#include <fs1_fw_if.h>
+#include <zephyr/devicetree.h>
+#include <fs1_binning_defs.h>
+#include <arc_local_conf_masks.h>
+#include <arc_local_conf_regs.h>
+#include <zephyr/drivers/misc/clk_gating/clk_gating_api.h>
+#include <zephyr/drivers/misc/clk_gating/fs1/fs_clk_gating_defs.h>
+#include <zephyr/drivers/misc/fs_isolation_binning/fs1/fs1_binning_api.h>
+#include <zephyr/drivers/misc/hl_cpld/hl_cpld.h>
+#include <hl_devs.h>
 #include <arc_regs.h>
 
 #define LOG_LEVEL CONFIG_LOG_DEFAULT_LEVEL
@@ -48,6 +57,7 @@
 #define STATUS_LED_GPIO_PIN		7
 #define GPIO_PIN_LEVEL_HIGH		1
 
+static void *masks;
 /*
  * TODO: the below section will need to be reworked for FS1
  * Currently it is not called from FS1 code.
@@ -96,8 +106,59 @@
 }
 #endif
 
+static void fs1_clock_gating_init(void *masks, enum fs1_die_id die_id)
+{
+	const struct device *cgm_dev = CLK_GATING_DEV_INST;
+	struct fs_clock_gating_info cgm_info = {
+			.die_id = die_id,
+			.redundancy_ctx = masks,
+	};
+
+	if (cgm_dev == NULL) {
+		LOG_ERR("Clock gating driver not found, skipping init");
+		return;
+	}
+
+	clk_gating_inject_info(cgm_dev, (void *)&cgm_info);
+	clk_gating_enable_all(cgm_dev, true);
+}
+
+__weak bool fs1_engine_init(struct hl_dev_config *dev_config)
+{
+	const struct device *eng_binning_dev = ENGINE_BINNING_DEV_INST;
+	enum fs1_die_id die_id = ((CFG_RREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE +
+			mmARC_LOCAL_CONF_DIE_CPU_ID) & ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_M) >>
+			ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_S);
+	struct fs1_binning_info info;
+
+	if (die_id <= FS1_COMPUTE_DIE_3)
+		masks = (void *)k_calloc(1, sizeof(struct fs1_redundancy_ctx_compute));
+	else if (die_id <= FS1_IO_DIE_1_HALF_1)
+		masks = (void *)k_calloc(1, sizeof(struct fs1_redundancy_ctx_io));
+	else {
+		LOG_ERR("%s: invalid die id = %u", __func__, die_id);
+		return -1;
+	}
+
+	if (masks == NULL) {
+		LOG_ERR("%s Memory not allocated.\n", __func__);
+		return -1;
+	}
+
+	info.redundancy_ctx = masks;
+	fs1_binning_drv_get_binning_info(eng_binning_dev, &info);
+
+	fs1_clock_gating_init(masks, die_id);
+	return true;
+}
+
 int hl_device_hw_init(struct hl_dev_config *dev_config)
 {
+	if (!fs1_engine_init(dev_config)) {
+		LOG_ERR("Failed to init fs1 engines");
+		return -1;
+	}
+
 	return 0;
 }
 
