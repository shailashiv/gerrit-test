 static struct intr_config intr;
 /*
  * Function to get the interrupt handler for a specific group and component
  */
-static int jsw_get_intr_type(struct intr_config *config, enum intr_agg_component_type *grp,
+static int jgs_get_intr_type(struct intr_config *config, enum intr_agg_component_type *grp,
