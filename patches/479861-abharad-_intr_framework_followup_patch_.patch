index 42968c0..794c2e6 100644
--- a/arch/common/intr/intr.c
+++ b/arch/common/intr/intr.c
@@ -17,27 +17,8 @@
 
 int process_interrupt(struct intr_config *config, enum intr_action action)
 {
-	switch (action) {
-	case INTR_ACTION_ENABLE:
-		/* Enable the interrupt */
-		break;
-	case INTR_ACTION_DISABLE:
-		/* Disable the interrupt */
-		break;
-	case INTR_ACTION_MASK:
-		/* Mask the interrupt */
-		break;
-	case INTR_ACTION_UNMASK:
-		/* Unmask the interrupt */
-		break;
-	case INTR_ACTION_PROCESS:
-		/* Process the interrupt */
-		dispatch_intr_handler(config);
-		break;
-	default:
-		LOG_ERR("Invalid action for interrupt processing\n");
-		return -EINVAL;
-	}
+
+	config->arch_process_intr();
 
 	return 0;
 }
