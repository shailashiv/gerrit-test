 }
 
+static int jgs_process_sei_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: SEI-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_spi_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: SPI-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_serr_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/*  TODO: SERR-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_derr_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: DERR-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_eco_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: ECO-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_interrupt(struct intr_config *config)
+{
+	enum intr_agg_grp_type grp;
+	enum intr_agg_component_type comp_type;
+
+	if (config->intr_type(config, &grp, &comp_type)) {
+		LOG_ERR("Failed to get interrupt group and component type");
+		return -1;
+	}
+
+	switch (grp) {
+	case INT_GRP_TYPE_SEI:
+		return jgs_process_sei_interrupt(config);
+	case INT_GRP_TYPE_SPI:
+		return jgs_process_spi_interrupt(config);
+	case INT_GRP_TYPE_SERR:
+		return jgs_process_serr_interrupt(config);
+	case INT_GRP_TYPE_DERR:
+		return jgs_process_derr_interrupt(config);
+	case INT_GRP_TYPE_ECO:
+		return jgs_process_eco_interrupt(config);
+	default:
+		LOG_ERR("Unknown group type: %d", grp);
+		return -1;
+	}
+}
+
 int dev_intr_prepare(struct intr_config *config)
 {
 	config = &intr;
-	config->intr_type = jsw_get_intr_type;
+	config->intr_type = jgs_get_intr_type;
+	config->arch_process_interrupt = jgs_process_interrupt;
 
 	return 0;
 }
