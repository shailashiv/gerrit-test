diff --git a/python_packages/habana_frameworks/torch/dynamo/compile_backend/decomposition.py b/python_packages/habana_frameworks/torch/dynamo/compile_backend/decomposition.py
index b3d848b..5d248e1 100644
--- a/python_packages/habana_frameworks/torch/dynamo/compile_backend/decomposition.py
+++ b/python_packages/habana_frameworks/torch/dynamo/compile_backend/decomposition.py
@@ -695,3 +695,17 @@
         return {**core_aten_decompositions()}
     else:
         return None
+
+
+# Some ops are decomposed at the CompositeImplicitAutograd and PyTorch doesn't
+# allow for easy removal of this decomposition https://github.com/pytorch/pytorch/issues/112744.
+# Below code allows to override it.
+
+old_fn = torch.ops.aten.matmul.default.py_kernels.pop(DispatchKey.CompositeImplicitAutograd)
+
+
+@torch.ops.aten.matmul.default.py_impl(DispatchKey.CompositeImplicitAutograd)
+def impl_matmul(tensor1, tensor2):
+    if tensor1.device.type == "hpu":
+        return torch.ops.hpu.matmul(tensor1, tensor2)
+    return old_fn(tensor1, tensor2)
