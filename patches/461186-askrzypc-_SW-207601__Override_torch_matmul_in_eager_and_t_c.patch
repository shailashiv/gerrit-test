+#include "hpu_ops/matmul.h"
+#include "hpu_ops/common/batched_matmul_output_shape.h"
+
+namespace sh = synapse_helpers;
+
+namespace habana {
+
+OutputMetaDataVector MatmulMeta(const at::Stack& stack) {
+  const auto& self = stack_tensor(stack, 0);
+  const auto& other = stack_tensor(stack, 1);
+
+  OutputMetaDataVector meta(1);
+  meta.at(0).shape =
+      getBatchMatmulOutShape(self.sizes(), other.sizes(), false, false);
+  meta.at(0).dtype = self.scalar_type();
+  return meta;
+}
+
+Matmul::Matmul(int device_id, c10::ScalarType scalar_type)
+    : OpBackend(device_id, "batch_gemm", scalar_type, {0}, {}, {}, false) {
+  SetOutputMetaFn(MatmulMeta);
+}
+
+void Matmul::AddNode(synapse_helpers::graph& graph, const at::Stack& stack) {
+  const auto& self = stack_tensor(stack, 0);
+  const auto self_dim = self.dim();
+  const auto self_dtype = self.scalar_type();
+  const auto& other = stack_tensor(stack, 1);
+  const auto other_dim = other.dim();
+
+  synGEMMParams params{false, false};
+  const auto meta = MatmulMeta(stack)[0];
+
+  if (self_dim == other_dim or (self_dim == 2 and other_dim == 1)) {
+    if (self_dim == other_dim) {
+      if (self_dim == 1) {
+        SetGuid(get_guid_with_precision("dot_fwd", self_dtype));
+      } else if (self_dim == 2) {
+        SetGuid("gemm");
+      }
+    } else {
+      SetGuid(get_guid_with_precision("mv_fwd", self_dtype));
+    }
+    auto output = OpBackend::BuildNode(
+        this,
+        graph,
+        {guid_, {syn_in(0), syn_in(1)}, {{meta.shape, meta.dtype, 0}}});
+
+    syn_out(0) = std::move(output[0]);
+    return;
+  }
+
+  auto gemm_output_shape = meta.shape;
+  auto max_dim = std::max(self_dim, other_dim);
+  std::optional<int64_t> dim_to_squeeze;
+
+  if (self_dim == 1) {
+    dim_to_squeeze = max_dim - 2;
+    gemm_output_shape.insert(gemm_output_shape.end() - 1, 1);
+  } else if (other_dim == 1) {
+    dim_to_squeeze = max_dim - 1;
+    gemm_output_shape.insert(gemm_output_shape.end(), 1);
+  }
+
+  std::vector<synTensor> expanded_syn_tensors;
+  std::vector<sh::tensor> expanded_tensors;
+  std::vector<synTensor> gemm_syn_tensors;
+
+  if (max_dim > self_dim) {
+    expanded_syn_tensors.push_back(syn_in(0));
+    auto diff = max_dim - self_dim;
+    auto expanded_sizes = self.sizes().vec();
+
+    while (diff > 0) {
+      expanded_sizes.insert(expanded_sizes.begin(), 1);
+      auto dim_tpc = get_dim_in_tpc_order(0, expanded_sizes.size());
+      expanded_tensors.emplace_back(OpBackend::BuildExpandDims(
+          this,
+          graph,
+          expanded_syn_tensors.back(),
+          expanded_sizes,
+          self_dtype,
+          dim_tpc));
+      expanded_syn_tensors.push_back(expanded_tensors.back().get());
+      diff--;
+    }
+
+    gemm_syn_tensors = {expanded_syn_tensors.back(), syn_in(1)};
+  } else {
+    expanded_syn_tensors.push_back(syn_in(1));
+    auto diff = max_dim - other_dim;
+    auto expanded_sizes = other.sizes().vec();
+
+    if (other_dim == 1) {
+      expanded_sizes.insert(expanded_sizes.end(), 1);
+      auto dim_tpc = get_dim_in_tpc_order(1, expanded_sizes.size());
+      expanded_tensors.emplace_back(OpBackend::BuildExpandDims(
+          this,
+          graph,
+          expanded_syn_tensors.back(),
+          expanded_sizes,
+          self_dtype,
+          dim_tpc));
+      expanded_syn_tensors.push_back(expanded_tensors.back().get());
+      diff--;
+    }
+
+    while (diff > 0) {
+      expanded_sizes.insert(expanded_sizes.begin(), 1);
+      auto dim_tpc = get_dim_in_tpc_order(0, expanded_sizes.size());
+      expanded_tensors.emplace_back(OpBackend::BuildExpandDims(
+          this,
+          graph,
+          expanded_syn_tensors.back(),
+          expanded_sizes,
+          self_dtype,
+          dim_tpc));
+      expanded_syn_tensors.push_back(expanded_tensors.back().get());
+      diff--;
+    }
+    gemm_syn_tensors = {syn_in(0), expanded_syn_tensors.back()};
+  }
+
+  c10::optional<int> gemm_idx =
+      dim_to_squeeze ? c10::nullopt : c10::optional(0);
+
+  auto output = OpBackend::BuildNode(
+      this,
+      graph,
+      {max_dim == 2 ? "gemm" : "batch_gemm",
+       std::move(gemm_syn_tensors),
+       {{gemm_output_shape, meta.dtype, gemm_idx}}});
+
+  if (dim_to_squeeze) {
+    auto dim_tpc = get_dim_in_tpc_order(*dim_to_squeeze, max_dim);
+    syn_out(0) = SqueezeHelper(
+        graph, output[0].get(), meta.shape, meta.dtype, dim_tpc, 0);
+  } else {
+    syn_out(0) = std::move(output[0]);
+  }
+}
+
+OutputMetaDataVector MatmulBwdMeta(const at::Stack& stack) {
+  const auto& self = stack_tensor(stack, 1);
+  const auto& other = stack_tensor(stack, 2);
+
+  OutputMetaDataVector meta(2);
+  meta.at(0).shape = self.sizes().vec();
+  meta.at(0).dtype = self.scalar_type();
+  meta.at(1).shape = other.sizes().vec();
+  meta.at(1).dtype = other.scalar_type();
+  return meta;
+}
+
+MatmulBwd::MatmulBwd(int device_id, c10::ScalarType scalar_type)
+    : OpBackend(device_id, "matmul_bwd", scalar_type, {1, 2}, {}, {}, false) {
+  SetOutputMetaFn(MatmulBwdMeta);
+}
+
+} // namespace habana
