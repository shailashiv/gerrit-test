+	ARCPID_API_PARAM_EDP_SEGMENTS = 0x1,
+	/* EDP Multiplier */
+	ARCPID_API_PARAM_EDP_MULTIPLIER = 0x2,
+	/* EDP duration */
+	ARCPID_API_PARAM_EDP_DURATION = 0x3,
+};
+
+/*
+ * @brief ARCPID API Trace Block Parameters
+ */
+enum arcpid_api_param_trace {
