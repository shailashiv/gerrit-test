+import ctypes
+import errno
+from typing import Optional, Tuple, Dict, Any
+from pathlib import Path
+from prompt_toolkit import PromptSession
+from prompt_toolkit.completion import NestedCompleter
+from prompt_toolkit.history import FileHistory
+
+class HlthunkControl:
+    """Python wrapper class for the hlthunk library with focus on control functions"""
+
+    def __init__(self, device_id: int = 0, busid: Optional[str] = None, lib_path: str = "libhl-thunk.so"):
+        """
+        Initialize hlthunk control interface
+
+        Args:
+            device_id: The device ID number of the control device as appears in /dev/
+            busid: PCI address of the device on the host PCI bus (optional)
+            lib_path: Path to the hlthunk library
+
+        Returns:
+            0 for success, negative value for error
+        """
+        self.fd = -1  # Initialize file descriptor to invalid
+
+        # Load the library
+        try:
+            self.lib = ctypes.CDLL(lib_path)
+        except OSError as e:
+            print(f"Error: Failed to load libhl-thunk library: {e}")
+            return
+
+        # Set function argument and return types
+        self._setup_function_signatures()
+
+        # Convert busid to bytes if provided
+        busid_bytes = busid.encode('utf-8') if busid else None
+        busid_ptr = ctypes.c_char_p(busid_bytes) if busid_bytes else None
+
+        # Open control device
+        self.fd = self.lib.hlthunk_open_control(device_id, busid_ptr)
+        if self.fd < 0:
+            print(f"Error: Failed to open hlthunk device (device_id={device_id}, busid={busid}), error code: {self.fd}")
+            if self.fd == -errno.ENOENT:
+                print("Check that the device driver is loaded and operational")
+            elif self.fd == -errno.EACCES:
+                print("Check that you have permission to access the device")
+
+    def _setup_function_signatures(self):
+        """Set up C function signatures for the library functions we'll use"""
+
+        # hlthunk_close
+        self.lib.hlthunk_close.argtypes = [ctypes.c_int]
+        self.lib.hlthunk_close.restype = ctypes.c_int
+
+        # hlthunk_fw_send_generic_request
+        self.lib.hlthunk_fw_send_generic_request.argtypes = [
+            ctypes.c_int,       # fd
+            ctypes.c_void_p,    # buff
+            ctypes.c_uint32,    # buff_size
+            ctypes.c_uint32     # sub_opcode
+        ]
+        self.lib.hlthunk_fw_send_generic_request.restype = ctypes.c_int
+
+        # hlthunk_open_control (already used in __init__)
+        self.lib.hlthunk_open_control.argtypes = [ctypes.c_int, ctypes.c_char_p]
+        self.lib.hlthunk_open_control.restype = ctypes.c_int
+
+        # Add signature for hlthunk_get_pci_bus_id_from_fd
+        self.lib.hlthunk_get_pci_bus_id_from_fd.argtypes = [
+            ctypes.c_int,       # fd
+            ctypes.c_char_p,    # pci_bus_id
+            ctypes.c_int        # len
+        ]
+        self.lib.hlthunk_get_pci_bus_id_from_fd.restype = ctypes.c_int
+
+    def close(self) -> int:
+        """
+        Close the device
+
+        Returns:
+            int: Return value of the close() syscall
+                 0 for success, negative value for error
+        """
+        if hasattr(self, 'fd') and self.fd >= 0:
+            result = self.lib.hlthunk_close(self.fd)
+            self.fd = -1
+            return result
+        return 0
+
+    def fw_send_generic_request(self, buffer: int, sub_opcode: int) -> Tuple[int, int]:
+        """
+        Send a generic request to the firmware using a 64-bit integer buffer
+
+        Args:
+            buffer: 64-bit integer value to be sent to the FW, may also serve as output value
+            sub_opcode: Generic request sub-opcode
+
+        Returns:
+            Tuple[int, int]: (return code, output buffer)
+                             return code 0 for success, negative value for error
+        """
+        if not hasattr(self, 'fd') or self.fd < 0:
+            print("Error: Device is not open")
+            return -1, 0
+
+        # Create a 64-bit integer buffer
+        c_buffer = ctypes.c_uint64(buffer)
+        buff_size = ctypes.sizeof(c_buffer)
+
+        # Call the function
+        result = self.lib.hlthunk_fw_send_generic_request(
+            self.fd,
+            ctypes.byref(c_buffer),
+            buff_size,
+            sub_opcode
+        )
+
+        # Return result and possibly modified buffer value
+        if result != 0:
+            print(f"Error: fw_send_generic_request failed with error code: {result}")
+
+        return result, c_buffer.value
+
+    def get_pci_bus_id(self) -> Tuple[int, str]:
+        """
+        Get the PCI bus ID of the device
+
+        Returns:
+            Tuple[int, str]: (return code, PCI bus ID string)
+                             return code 0 for success, negative value for error
+                             PCI bus ID in format [domain]:[bus]:[device].[function]
+        """
+        if not hasattr(self, 'fd') or self.fd < 0:
+            print("Error: Device is not open")
+            return -1, ""
+
+        # PCI bus ID is typically up to 13 characters (including null terminator)
+        # Format: [domain]:[bus]:[device].[function]
+        # Example: 0000:3b:00.0
+        buf_size = 32  # Using a bigger buffer to be safe
+        pci_bus_id = ctypes.create_string_buffer(buf_size)
+
+        result = self.lib.hlthunk_get_pci_bus_id_from_fd(self.fd, pci_bus_id, buf_size)
+
+        if result != 0:
+            print(f"Error: Failed to get PCI bus ID, error code: {result}")
+            return result, ""
+
+        # Convert bytes to string and remove null characters
+        return 0, pci_bus_id.value.decode('utf-8')
+
+    def __del__(self):
+        """Destructor to ensure device is closed"""
+        self.close()
+
+
+class ApiCommandProcessor:
+    """
+    Class for processing API commands, creating nested dictionaries for completion,
+    and handling command execution.
+    """
+
+    def __init__(self, json_file_path: str):
+        """
+        Initialize the API command processor with a JSON file path.
+
+        Args:
+            json_file_path: Path to the api_commands.json file
+        """
+        self.json_data = self._load_json_file(json_file_path)
+        self.nested_dict = self._build_nested_dictionary()
+
+    def _load_json_file(self, file_path: str) -> Dict[str, Any]:
+        """Load and parse the JSON file."""
+        try:
+            with open(file_path, 'r') as file:
+                return json.load(file)
+        except Exception as e:
+            print(f"Error loading JSON file: {e}")
+            sys.exit(1)
+
+    def _process_commands_and_options(self, block_name: str, param_name: str) -> Tuple[Dict, Dict]:
+        """Process commands and options for a parameter."""
+        result = {}
+
+        # Process commands
+        commands_dict = {}
+        for cmd in self.json_data["blocks"][block_name]["params"][param_name]["commands"]:
+            # First check in command-specific section if available
+            if param_name in self.json_data["commands"]:
+                if cmd in self.json_data["commands"][param_name]:
+                    commands_dict[cmd] = {
+                        "id": self.json_data["commands"][param_name][cmd]["id"],
+                        "description": self.json_data["commands"][param_name][cmd]["description"]
+                    }
+                    continue
+
+            # Then check in global commands
+            if cmd in self.json_data["commands"]["global"]:
+                commands_dict[cmd] = {
+                    "id": self.json_data["commands"]["global"][cmd]["id"],
+                    "description": self.json_data["commands"]["global"][cmd]["description"]
+                }
+
+        # Process options
+        options_dict = {}
+        options_list = self.json_data["blocks"][block_name]["params"][param_name]["options"]
+
+        # Find the right section for options
+        for opt_section, opt_values in self.json_data["options"].items():
+            for opt in options_list:
+                if opt in opt_values:
+                    options_dict[opt] = {
+                        "id": opt_values[opt]["id"],
+                        "description": opt_values[opt]["description"]
+                    }
+
+        return commands_dict, options_dict
+
+    def _build_nested_dictionary(self) -> Dict[str, Any]:
+        """Build the nested dictionary structure from the JSON data."""
+        result = {}
+
+        # First level: blocks
+        for block_name, block_data in self.json_data["blocks"].items():
+            result[block_name] = {
+                "id": block_data["id"],
+                "description": block_data["description"],
+                "params": {}
+            }
+
+            # Second level: params
+            for param_name, param_data in block_data["params"].items():
+                commands_dict, options_dict = self._process_commands_and_options(block_name, param_name)
+
+                result[block_name]["params"][param_name] = {
+                    "id": param_data["id"],
+                    "description": param_data["description"],
+                    "commands": commands_dict,
+                    "options": options_dict
+                }
+
+        return result
+
+    def dump_nested_dict(self):
+        """
+        Dump the nested dictionary.
+        """
+        print(json.dumps(self.nested_dict, indent=2))
+
+    def create_nested_completer(self) -> NestedCompleter:
+        """
+        Create a nested completer structure for prompt_toolkit based on the parsed dictionary.
+
+        Returns:
+            NestedCompleter: A completer for use with prompt_toolkit
+        """
+        completer_dict = {}
+
+        # First level: blocks
+        for block_name, block_data in self.nested_dict.items():
+            completer_dict[block_name] = {}
+
+            # Second level: params
+            for param_name, param_data in block_data["params"].items():
+                completer_dict[block_name][param_name] = {}
+
+                # If options exist, add them as the third level
+                if param_data["options"]:
+                    for option_name in param_data["options"]:
+                        completer_dict[block_name][param_name][option_name] = {}
+
+                        # Add commands as the fourth level (for params with options)
+                        for cmd_name in param_data["commands"]:
+                            completer_dict[block_name][param_name][option_name][cmd_name] = None
+                else:
+                    # Add commands directly as the third level (for params without options)
+                    for cmd_name in param_data["commands"]:
+                        completer_dict[block_name][param_name][cmd_name] = None
+
+        return NestedCompleter.from_nested_dict(completer_dict)
+
+    def process_list_command(self) -> bool:
+        """
+        Process the 'list' command which displays information about available blocks.
+        Prints the output directly.
+
+        Returns:
+            bool: True if the command was successful
+        """
+        block_info = "Available blocks:\n"
+        for block_name, block_data in self.nested_dict.items():
+            block_info += f"  {block_name}: {block_data['description']}\n"
+        print(block_info)
+        return True
+
+    def process_info_command(self, command: str) -> bool:
+        """
+        Process the 'info' command which displays information about blocks and parameters.
+        Prints the output directly.
+
+        Args:
+            command (str): The info command to process (e.g., "info block" or "info block param")
+
+        Returns:
+            bool: True if the command was successful, False if there was an error
+        """
+        parts = command.split()
+        if len(parts) < 2:
+            print("Error: Block name required for 'info' command")
+            return False
+
+        block = parts[1]
+        if block not in self.nested_dict:
+            print(f"Error: Unknown block '{block}'")
+            return False
+
+        if len(parts) >= 3:
+            param = parts[2]
+            if param not in self.nested_dict[block]["params"]:
+                print(f"Error: Unknown parameter '{param}' for block '{block}'")
+                return False
+
+            param_data = self.nested_dict[block]["params"][param]
+
+            print(f"Parameter '{param}' of block '{block}':")
+            print(f"  ID: {param_data['id']}")
+            print(f"  Description: {param_data['description']}")
+
+            print("  Commands:")
+            for cmd_name, cmd_data in param_data["commands"].items():
+                print(f"    {cmd_name}: {cmd_data['description']}")
+
+            if param_data["options"]:
+                print("  Options:")
+                for opt_name, opt_data in param_data["options"].items():
+                    print(f"    {opt_name}: {opt_data['description']}")
+        else:
+            block_data = self.nested_dict[block]
+
+            print(f"Block '{block}':")
+            print(f"  ID: {block_data['id']}")
+            print(f"  Description: {block_data['description']}")
+            print("  Parameters:")
+
+            for param_name, param_data in block_data["params"].items():
+                print(f"    {param_name}: {param_data['description']}")
+
+        return True
+
+    def process_command(self, command: str, verbose: bool = False) -> Tuple[int, int]:
+        """
+        Process the user's command and provide feedback.
+        Prints the output only in verbose mode, but always prints error messages.
+
+        Args:
+            command (str): The command to process
+            verbose (bool): Whether to print detailed output
+
+        Returns:
+            tuple: (status, encoded_value)
+                status (int): 0 for error, 1 for success without output, 2 for success with output
+                encoded_value (int): The encoded value representing the command
+        """
+        parts = command.split()
+        if not parts:
+            print("Empty command. Type 'help' for usage information.")
+            return 0, 0
+
+        # Check if command is valid
+        if len(parts) < 2:
+            print("Incomplete command. Type 'help' for usage information.")
+            return 0, 0
+
+        block = parts[0]
+        param = parts[1]
+
+        if block not in self.nested_dict:
+            print(f"Error: Unknown block '{block}'")
+            return 0, 0
+
+        if param not in self.nested_dict[block]["params"]:
+            print(f"Error: Unknown parameter '{param}' for block '{block}'")
+            return 0, 0
+
+        param_data = self.nested_dict[block]["params"][param]
+        has_options = bool(param_data["options"])
+
+        # Initialize variables
+        option = None
+        option_info = None
+        cmd_info = None
+        command_str = None
+        data = 0  # Default data value is 0
+
+        # Initialize struct fields
+        block_id = self.nested_dict[block]["id"]
+        param_id = param_data["id"]
+        opt_id = 0  # Default option ID is 0
+        cmd_id = 0  # Will be set later
+
+        # Current position in the parts list where we expect the command
+        cmd_pos = 2
+
+        # Check for option if parameter requires it
+        if has_options:
+            if len(parts) < 3:
+                print(f"Error: Parameter '{param}' requires an option")
+                return 0, 0
+
+            option = parts[2]
+            if option not in param_data["options"]:
+                print(f"Error: Unknown option '{option}' for parameter '{param}'")
+                return 0, 0
+
+            option_info = param_data["options"][option]
+            opt_id = option_info["id"]  # Set option ID
+            cmd_pos = 3
+
+        # Check for command at the appropriate position
+        if len(parts) <= cmd_pos:
+            print("Error: Command required")
+            return 0, 0
+
+        command_str = parts[cmd_pos]
+        if command_str not in param_data["commands"]:
+            print(f"Error: Unknown command '{command_str}' for parameter '{param}'")
+            return 0, 0
+
+        cmd_info = param_data["commands"][command_str]
+        cmd_id = cmd_info["id"]  # Set command ID
+
+        # Determine the status based on the command type
+        status = 2 if command_str == "get" else 1  # get commands return data (2), others just succeed (1)
+
+        # Check if additional data is needed for 'set' command
+        if command_str == "set":
+            data_pos = cmd_pos + 1
+            if len(parts) <= data_pos:
+                print("Error: 'set' command requires a 32-bit unsigned integer data value")
+                return 0, 0
+
+            try:
+                data_val = int(parts[data_pos])
+                if data_val < 0 or data_val > 0xFFFFFFFF:  # Check 32-bit unsigned range
+                    print("Error: Data must be a 32-bit unsigned integer (0 to 4294967295)")
+                    return 0, 0
+                data = data_val
+            except ValueError:
+                print("Error: Data must be a valid integer")
+                return 0, 0
+
+        # Create the 64-bit encoded value representing arcpid_api_t struct using struct.pack
+        # struct arcpid_api_t {
+        #     uint32_t data;
+        #     uint8_t cmd;
+        #     uint8_t opt;
+        #     uint8_t param;
+        #     uint8_t block;
+        # };
+        packed_bytes = struct.pack('IBBBB', data, cmd_id, opt_id, param_id, block_id)
+
+        # Convert packed bytes to a 64-bit integer
+        encoded_value = int.from_bytes(packed_bytes, byteorder='little')
+
+        # Print command execution information only in verbose mode
+        if verbose:
+            print(f"Executing: {block} {param}", end="")
+            if option:
+                print(f" {option}", end="")
+            print(f" {command_str}", end="")
+            if data:
+                print(f" {data}", end="")
+            print()
+
+            print(f"Block ID: {block_id}, Description: {self.nested_dict[block]['description']}")
+            print(f"Param ID: {param_id}, Description: {param_data['description']}")
+
+            if option_info:
+                print(f"Option ID: {opt_id}, Description: {option_info['description']}")
+
+            print(f"Command ID: {cmd_id}, Description: {cmd_info['description']}")
+
+            if data:
+                print(f"Data: {data} (0x{data:08X})")
+
+            print(f"Encoded Command Value: 0x{encoded_value:016X}")
+
+        return status, encoded_value
+
+    def get_api_json_version(self) -> tuple:
+        """
+        Get the API version from the api_commands.json file
+
+        Returns:
+            tuple: Version as (major, minor, patch)
+        """
+        if 'api_version' not in self.json_data:
+            print("Warning: API version not found in JSON file")
+            return (0, 0, 0)
+
+        api_version = self.json_data['api_version']
+        major = api_version.get('major', 0)
+        minor = api_version.get('minor', 0)
+        patch = api_version.get('patch', 0)
+
+        return (major, minor, patch)
+
+    def get_output_info(self, command: str) -> Tuple[str, str]:
+        """
+        Get the output type and unit for a given command string.
+
+        Args:
+            command (str): Command string in the format "<block> <param> [<option>] <command> [<data>]"
+
+        Returns:
+            Tuple[str, str]: The output type (state, decimal, hexadecimal, tuple) and unit (mW, mC, %, etc.)
+                             Default values are "decimal" for type and "" for unit
+        """
+        parts = command.split()
+        if len(parts) < 2:
+            return "decimal", ""  # Not enough parts to identify block and param
+
+        block = parts[0]
+        param = parts[1]
+
+        if block not in self.json_data["blocks"]:
+            return "decimal", ""  # Default if block not found
+
+        if param not in self.json_data["blocks"][block]["params"]:
+            return "decimal", ""  # Default if param not found
+
+        # Get the param data
+        param_data = self.json_data["blocks"][block]["params"][param]
+
+        # Get output type with default
+        output_type = param_data.get("output_type", "decimal")
+
+        # Get output unit with default
+        output_unit = param_data.get("output_unit", "")
+
+        return output_type, output_unit
+
+
+class ApiApp:
+    """
+    Main application class for ARCPID API that manages command processing and firmware communication
+    """
+
+    HELP_MESSAGE = """
+    Usage: <block> <param> [<option>] <command> [<data>]
+      - <block>: The block name (e.g., power, thermal)
+      - <param>: The parameter name (e.g., regulation, coeff)
+      - <option>: Optional parameter if the param has options
+      - <command>: The command to execute (e.g., get, set)
+      - <data>: 32-bit unsigned integer data (required for 'set' commands)
+
+    Special commands:
+      - help: Show this help message
+      - list: List all available blocks
+      - info <block> [<param>]: Show detailed information about a block or parameter
+      - device <device_id>: Change to a different device ID
+      - busid: Print the PCI bus ID of the current device
+      - history: Display command history
+      - exit/quit: Exit the shell
+
+    Command history is saved to ~/.arcpid_api_history
+    """
+
+    def __init__(self, json_path: str, device_id: int = 0, verbose: bool = False):
+        """
+        Initialize the API application with command processor and hardware control
+
+        Args:
+            json_path (str): Path to the api_commands.json file
+            device_id (int): The device ID to open
+            verbose (bool): Whether to enable verbose output
+        """
+        self.verbose = verbose
+        self.device_id = device_id
+        self.json_path = json_path
+
+        # Initialize command processor
+        self.cmd_processor = ApiCommandProcessor(json_path)
+
+        # Pre-encode the API enable and disable commands
+        _, self.api_enable_cmd = self.cmd_processor.process_command("api state enable", False)
+        _, self.api_disable_cmd = self.cmd_processor.process_command("api state disable", False)
+
+        # Initialize hlthunk control
+        self.hlthunk = HlthunkControl(device_id)
+
+        # Create history file path in user's home directory
+        self.history_file = os.path.expanduser("~/.arcpid_api_history")
+
+    def change_device(self, new_device_id: int) -> bool:
+        """
+        Change the device ID by closing the current connection and reopening with a new ID
+
+        Args:
+            new_device_id (int): The new device ID to use
+
+        Returns:
+            bool: True if successful, False otherwise
+        """
+        # Close current connection
+        self.hlthunk.close()
+
+        # Reinitialize hlthunk control with new device ID
+        self.hlthunk = HlthunkControl(new_device_id)
+
+        if self.hlthunk.fd < 0:
+            # If failed, try to reopen the previous device ID
+            print(f"Reopening previous device ID {self.device_id} instead")
+            self.hlthunk = HlthunkControl(self.device_id)
+            if self.hlthunk.fd < 0:
+                print(f"Check if device driver is loaded and operational")
+                return False
+            return True
+
+        # Update device ID
+        self.device_id = new_device_id
+
+        print(f"Successfully changed to device ID {new_device_id}")
+        return True
+
+    def close(self) -> int:
+        """
+        Close the connection to the device and clean up resources
+
+        Returns:
+            int: Return code from closing the device (0 for success)
+        """
+        return self.hlthunk.close()
+
+    def send_firmware_request(self, encoded_value: int) -> Tuple[int, int]:
+        """
+        Send an encoded command to the firmware and handle the result.
+
+        Args:
+            encoded_value (int): The encoded command value
+
+        Returns:
+            int: Exit code (0 for success, non-zero for failure)
+            output: The output from the firmware request or error code in case of failure
+        """
+        # Enable API before sending command
+        res, _ = self.hlthunk.fw_send_generic_request(self.api_enable_cmd, 2)
+        if res != 0:
+            print(f"Error: Failed to enable API, error code: {res}")
+            return res, 0
+
+        # Send the command to the firmware
+        res, output = self.hlthunk.fw_send_generic_request(encoded_value, 2)
+
+        # Disable API after sending command
+        disable_res, _ = self.hlthunk.fw_send_generic_request(self.api_disable_cmd, 2)
+        if disable_res != 0:
+            print(f"Warning: Failed to disable API, error code: {disable_res}")
+
+        # Check if the original command failed at the driver level
+        if res != 0:
+            return res, 0
+
+        # Extract FW error code if present (byte 4 == 0xFF indicates error condition)
+        # In error case, bytes 0-3 contain the error code
+        # In success case, bytes 0-3 contain the output value
+        output_cmd = (output >> 32) & 0xFF
+        output_value = (output & 0xFFFFFFFF)
+        if output_cmd == 0xFF:
+            res = -1
+
+        return res, output_value
+
+    def send_command(self, command: str) -> int:
+        """
+        Send a command to the firmware and handle the result.
+
+        Args:
+            command (str): The command to send
+
+        Returns:
+            int: Exit code (0 for success, non-zero for failure)
+        """
+        res, encoded_value = self.cmd_processor.process_command(command, self.verbose)
+        if res == 0 or encoded_value == 0:
+            return res
+
+        output_flag = True if res == 2 else False
+
+        res, output = self.send_firmware_request(encoded_value)
+        if res != 0:
+            print(f"Error: Failed to send command '{command}', error code: {output}")
+            return res
+
+        if output_flag:
+            output_type, output_unit = self.cmd_processor.get_output_info(command)
+
+            if output_type == "state":
+                if output == 1:
+                    print("enabled")
+                elif output == 0:
+                    print("disabled")
+                else:
+                    print(f"{output} (Unknown state)")
+            elif output_type == "hexadecimal":
+                print(f"0x{output:X}")
+            elif output_type == "tuple":
+                # For tuple output, we need to parse it
+                # Assuming the tuple format is encoded in the 32-bit value
+                # Example: 0x01020304 -> (1, 2, 3, 4)
+                tuple_output = struct.unpack('BBBB', struct.pack('I', output))
+                print(f"({tuple_output[0]}, {tuple_output[1]}, {tuple_output[2]}, {tuple_output[3]})")
+            elif output_type == "decimal":
+                # Display with unit if available
+                if output_unit:
+                    print(f"{output} {output_unit}")
+                else:
+                    print(f"{output}")
+            else:
+                print(f"{output} (Unknown output type)")
+
+    def get_api_version(self) -> tuple:
+        """
+        Get the API version from the firmware and parse it into [MAJOR, MINOR, PATCH]
+
+        Returns:
+            tuple: (success, version)
+                success (bool): True if successful, False otherwise
+                version (list): Version as [MAJOR, MINOR, PATCH] or [] if failed
+        """
+        # Process the api version get command to get the encoded value
+        res, encoded_value = self.cmd_processor.process_command("api version get", self.verbose)
+        if res == 0 or encoded_value == 0:
+            print("Error: Failed to process API version command")
+            return False, []
+
+        # Send the command to the firmware
+        result, output = self.hlthunk.fw_send_generic_request(encoded_value, 2)
+
+        # Check if the command was successful
+        if result != 0:
+            print(f"Error: Failed to get API version, error code: {result}")
+            return False, []
+
+        # Extract the version components from the 32-bit output
+        # The output contains the version as [MAJOR, MINOR, PATCH]
+        major = (output >> 16) & 0xFF
+        minor = (output >> 8) & 0xFF
+        patch = output & 0xFF
+
+        return True, [major, minor, patch]
+
+    def run_interactive_shell(self) -> int:
+        """
+        Start and run the interactive shell with command completion
+
+        Returns:
+            int: Exit code (0 for success)
+        """
+        # Create completer for prompt_toolkit
+        completer = self.cmd_processor.create_nested_completer()
+
+        # Create FileHistory object for command history persistence
+        history = FileHistory(self.history_file)
+
+        # Create prompt session with history
+        session = PromptSession(completer=completer, history=history)
+
+        # Get and display API version
+        success, version = self.get_api_version()
+        version_str = f"{version[0]}.{version[1]}.{version[2]}" if success else "N/A"
+
+        # Get JSON file version
+        json_version = self.cmd_processor.get_api_json_version()
+        json_version_str = f"{json_version[0]}.{json_version[1]}.{json_version[2]}"
+
+        print(f"ARCPID API Interactive Shell (FW API Version {version_str}, JSON Version {json_version_str})")
+
+        print("Type 'help' for usage information, 'list' to see available blocks, or 'exit' to quit")
+        print("Press Ctrl+C to interrupt or Ctrl+D to exit")
+
+        while True:
+            try:
+                text = session.prompt(f'hl{self.device_id}> ')
+
+                # Convert and strip command for consistent comparison
+                cmd_lowercase = text.strip().lower()
+
+                # Handle exit commands
+                if cmd_lowercase in ('exit', 'quit'):
+                    break
+
+                if cmd_lowercase == 'help':
+                    print(self.HELP_MESSAGE)
+                    continue
+
+                # Handle list command
+                if cmd_lowercase == 'list':
+                    self.cmd_processor.process_list_command()
+                    continue
+
+                # Handle info command
+                if cmd_lowercase.startswith('info '):
+                    self.cmd_processor.process_info_command(text)
+                    continue
+
+                # Handle device change command
+                if cmd_lowercase.startswith('device'):
+                    parts = text.split()
+                    if len(parts) == 2 and parts[1].isdigit():
+                        new_device_id = int(parts[1])
+                        self.change_device(new_device_id)
+                    else:
+                        print("Error: Invalid device command. Usage: device <device_id>")
+                    continue
+
+                # Handle busid command
+                if cmd_lowercase == 'busid':
+                    res, bus_id = self.hlthunk.get_pci_bus_id()
+                    if res == 0:
+                        print(f"PCIe Bus ID: {bus_id}")
+                    continue
+
+                # Handle history command
+                if cmd_lowercase == 'history':
+                    for i, entry in enumerate(history.get_strings(), 1):
+                        print(f"{i}: {entry}")
+                    continue
+
+                # Process the command
+                self.send_command(text)
+
+            except KeyboardInterrupt:
+                continue
+            except EOFError:
+                break
+            except Exception as e:
+                print(f"Error: {e}")
+
+        print("Exiting shell. Goodbye!")
+        self.close()
+        return 0
+
+
+def main():
+    """Main function to run the ARCPID API interactive shell."""
+    # Parse command-line arguments
+    import argparse
+    parser = argparse.ArgumentParser(description='ARCPID API Interactive Shell')
+    parser.add_argument('--json-path', '-j', type=str,
+                        default="~/trees/npu-stack/embedded/zephyr-apps/arcpid/api/api_commands.json",
+                        help='Path to the api_commands.json file')
+    parser.add_argument('--device-id', '-d', type=int, choices=range(0, 8), default=0,
+                        help='Device ID to use (0-7)')
+    parser.add_argument('--json-dump', '-l', action='store_true',
+                        help='Dump the parsed JSON structure and exit')
+    parser.add_argument('--command', '-c', type=str,
+                        help='Execute a single command and exit')
+    parser.add_argument('--verbose', '-v', action='store_true',
+                        help='Enable verbose mode')
+    args = parser.parse_args()
+
+    # Create the API application
+    app = ApiApp(args.json_path, device_id=args.device_id, verbose=args.verbose)
+
+    # If dump flag is set, print the structure and exit
+    if args.json_dump:
+        app.cmd_processor.dump_nested_dict()
+        return 0
+
+    # Check if hlthunk initialized successfully
+    if app.hlthunk.fd < 0:
+        return 1
+
+    # If command was provided via command line, execute it and exit
+    if args.command:
+        res = app.send_command(args.command)
+        app.hlthunk.close()
+        return res
+
+    # Run the interactive shell
+    return app.run_interactive_shell()
+
+
+if __name__ == "__main__":
+    sys.exit(main())
