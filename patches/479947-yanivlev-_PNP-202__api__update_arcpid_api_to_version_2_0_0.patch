+
+/*
+ * @brief ARCPID API Ewma_weight Options
+ */
+enum arcpid_api_opt_ewma_weight {
+	/* EWMA weight power */
+	ARCPID_API_OPT_EWMA_WEIGHT_POWER = 0x1,
+	/* EWMA weight current */
+	ARCPID_API_OPT_EWMA_WEIGHT_CURRENT = 0x2,
+	/* EWMA weight rate limit */
+	ARCPID_API_OPT_EWMA_WEIGHT_RL = 0x3,
+};
+
+/*
+ * @brief ARCPID API Thermal Options
+ */
+enum arcpid_api_opt_thermal {
+	/* Thermal Device SoC */
+	ARCPID_API_OPT_THERMAL_SOC = 0x1,
+	/* Thermal Device HBM */
+	ARCPID_API_OPT_THERMAL_HBM = 0x2,
+};
+
+/*
+ * @brief ARCPID API Edp Options
+ */
+enum arcpid_api_opt_edp {
