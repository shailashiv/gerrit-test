+            f.write(f" */\n")
+            f.write(f"enum arcpid_api_cmd_{cmd_group} {{\n")
+            for cmd_name, cmd_data in cmds.items():
+                cmd_id = cmd_data.get("id", 0)
+                description = cmd_data.get("description", "")
+                enum_name = f"ARCPID_API_CMD_{cmd_group_upper}_{snake_to_upper_case(cmd_name)}"
+                f.write(f"\t/* {description} */\n")
+                f.write(f"\t{enum_name} = 0x{cmd_id:x},\n")
+            f.write(f"}};\n\n")
+
+        # Generate option enums
+        options = json_data.get("options", {})
+        for opt_group, opts in options.items():
+            opt_group_upper = snake_to_upper_case(opt_group)
+            f.write(f"/*\n")
+            f.write(f" * @brief ARCPID API {opt_group.capitalize()} Options\n")
+            f.write(f" */\n")
+            f.write(f"enum arcpid_api_opt_{opt_group} {{\n")
+            for opt_name, opt_data in opts.items():
+                opt_id = opt_data.get("id", 0)
+                description = opt_data.get("description", "")
+                # Handle numeric option names by prepending "NUM_" to avoid invalid C identifiers
+                if opt_name.isdigit():
+                    opt_enum_name = f"NUM_{opt_name}"
+                else:
+                    opt_enum_name = opt_name
+                enum_name = f"ARCPID_API_OPT_{opt_group_upper}_{snake_to_upper_case(opt_enum_name)}"
+                f.write(f"\t/* {description} */\n")
+                f.write(f"\t{enum_name} = 0x{opt_id:x},\n")
+            f.write(f"}};\n\n")
+
+        # Close header guards
+        f.write(f"#endif /* {header_guard} */\n")
+
+def main():
+    if len(sys.argv) < 2:
+        # Use default json input file if none specified
+        json_file = "api_commands.json"
+        print(f"No input file specified, using default: {json_file}")
+    else:
+        json_file = sys.argv[1]
+
+    if len(sys.argv) >= 3:
+        output_file = sys.argv[2]
+    else:
+        # Default output to the include/lib directory
+        output_file = "../include/lib/api_commands.h"
+        print(f"No output file specified, using default: {output_file}")
+
+    try:
+        with open(json_file, 'r') as f:
+            # Use regex to remove JavaScript-style comments from JSON
+            content = f.read()
+            content = re.sub(r'//.*?\n', '\n', content)
+            content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
+            json_data = json.loads(content)
+
+        generate_header_file(json_data, output_file)
+        print(f"Successfully generated {output_file}")
+
+    except FileNotFoundError:
+        print(f"Error: Could not find file {json_file}")
+        sys.exit(1)
+    except json.JSONDecodeError as e:
+        print(f"Error: Invalid JSON in {json_file}: {e}")
+        sys.exit(1)
+    except Exception as e:
+        print(f"Error: {str(e)}")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
