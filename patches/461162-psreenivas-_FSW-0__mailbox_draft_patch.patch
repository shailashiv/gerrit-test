+static void ipm_fs_regs_init(const struct device *dev)
+{
+	const struct ipm_fs_config *config = DEV_CFG(dev);
+	struct ipm_fs_data *const data = DEV_DATA(dev);
+
+	data->regs.base_addr_msb = config->cfg_base;
+	data->regs.base_addr_lsb = config->cfg_base + mmSW_MAILBOX_QUEUE_BASE_ADDR_L_0;
+	data->regs.q_size = config->cfg_base + mmSW_MAILBOX_QUEUE_SIZE_0;
+	data->regs.pi = config->cfg_base + mmSW_MAILBOX_PI_0;
+	data->regs.ci = config->cfg_base + mmSW_MAILBOX_CI_0;
+	data->regs.en = config->cfg_base + mmSW_MAILBOX_EN_0;
+	data->regs.en_sts = (config->cfg_base & 0xFFFFFF00) +
+				mmSW_MAILBOX_INTR_SPI_CAUSE_WRITE_TO_EN;
+	data->regs.pi_sts = (config->cfg_base & 0xFFFFFF00) +
+				mmSW_MAILBOX_INTR_SPI_CAUSE_WRITE_TO_PI;
+}
