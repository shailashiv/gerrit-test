 void ipm_fs_isr(const struct device *dev)
 {
 	const struct ipm_fs_config *config = DEV_CFG(dev);
+	struct ipm_fs_data *const data = DEV_DATA(dev);
+	struct ipm_fs_mbx_regs *reg_base = &data->regs;
+	uint32_t status = sys_read32(reg_base->en_sts);
+
+	if (config->mbx_type == MBX_TX_ONLY || (!status && !sys_read32(reg_base->pi_sts))) {
+		LOG_DBG("Interrupt does not belong to dev %p", dev);
+		return;
+	}
+
 	/*
 	 * RX will get 2 interrupts
 	 * 1. mbx enable
 	 * 2. pi write
-	 * TODO: add interrupt registers and check for particular en or write interrupt
-	 * is associated with mailbox.
 	 */
 
-	/* Enable routine*/
