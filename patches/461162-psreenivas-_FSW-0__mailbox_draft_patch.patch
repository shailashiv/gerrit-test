+		sys_write32(config->data_size, (mem_addr_t) reg_base->q_size);
+		sys_write32(0x0, (mem_addr_t) reg_base->pi);
+		sys_write32(0x0, (mem_addr_t) reg_base->ci);
 
 		/* Clear mailbox buffer */
 		memset((void *)config->data_base, 0x0, config->data_size);
