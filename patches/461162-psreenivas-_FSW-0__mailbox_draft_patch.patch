+	if (status & BIT(config->mbx_idx)) {
+		ipm_fs_mbx_process_data(dev);
+		sys_write32(BIT(config->mbx_idx), reg_base->pi_sts);
+	} else {
+		LOG_INF("Invalid mailbox interrupt received: pi sts %u", status);
+	}
 }
 
 
