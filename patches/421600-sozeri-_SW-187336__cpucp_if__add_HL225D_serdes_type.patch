From 5d53b887204a570528564bab360ad09805424e89 Mon Sep 17 00:00:00 2001
From: Sagiv Ozeri <sozeri@habana.ai>
Date: Thu, 06 Jun 2024 14:16:49 +0300
Subject: [PATCH] [SW-187336] cpucp_if: add HL225D serdes type

Add new serdes type to support HL225D connectivity.

Change-Id: Id3733b1963760115b9835f3e11c3d5fa6c426ebe
Signed-off-by: Sagiv Ozeri <sozeri@habana.ai>
---

diff --git a/cpucp_if.h b/cpucp_if.h
index 2086281..b1aa4b4 100644
--- a/cpucp_if.h
+++ b/cpucp_if.h
@@ -2960,6 +2960,7 @@
 	HLS3_SERDES_TYPE_DEPRECATED,
 	HLB325_FULL_OAM_3PORTS_SCALE_OUT_SERDES_TYPE,
 	HL338_SERDES_TYPE,
+	HL225D_SERDES_TYPE,
 	MAX_NUM_SERDES_TYPE,		/* number of types */
 	UNKNOWN_SERDES_TYPE = 0xFFFF	/* serdes_type is u16 */
 };
