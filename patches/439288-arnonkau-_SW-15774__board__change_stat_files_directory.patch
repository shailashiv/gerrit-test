From 39d197f85d8e1b59f194f3e979cc03e18de2d5c0 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Tue, 23 Jul 2024 13:12:48 +0300
Subject: [PATCH] [SW-15774] board: change stat files directory

Seperate the stat files fromthe bin and ELF files.

Change-Id: I822b42ecd566ff6e5189397b0f41c6b07805bf8c
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/board/habanalabs/common/dirs.sh b/board/habanalabs/common/dirs.sh
index 9485deb..fbd9594 100644
--- a/board/habanalabs/common/dirs.sh
+++ b/board/habanalabs/common/dirs.sh
@@ -9,7 +9,7 @@
 export HEXS_DIR=${IMGS_PROD_DIR}/hexs/
 export ITBS_DIR=${IMGS_PROD_DIR}/itbs/
 export BINS_DIR=${IMGS_DIR}
-export STATS_DIR=${IMGS_DIR}
+export STATS_DIR=${IMGS_DIR}/stats/
 export ELFS_DIR=${IMGS_PROD_DIR}/elfs/
 export BINS_PROD_DIR=${IMGS_PROD_DIR}
 
diff --git a/scripts/make/common/hl_dirs.mk b/scripts/make/common/hl_dirs.mk
index 928ee69..ca6085e 100644
--- a/scripts/make/common/hl_dirs.mk
+++ b/scripts/make/common/hl_dirs.mk
@@ -10,7 +10,7 @@
 export BINS_DIR=$(IMGS_DIR)
 export ITBS_DIR=$(IMGS_PROD_DIR)/itbs/
 export ELFS_DIR=$(IMGS_PROD_DIR)/elfs/
-export STATS_DIR=$(IMGS_DIR)
+export STATS_DIR=$(IMGS_DIR)/stats/
 export BINS_PROD_DIR=$(IMGS_PROD_DIR)
 
 export DIRS_LIST = \
@@ -18,4 +18,5 @@
 	$(ELFS_DIR) \
 	$(ITBS_DIR) \
 	$(HEXS_DIR) \
+	$(STATS_DIR) \
 	$(BINS_PROD_DIR)
