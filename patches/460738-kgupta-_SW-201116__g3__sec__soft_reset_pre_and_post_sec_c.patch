 }
 
+void hl_reset_dev_pre_sec_cfg(const struct device *dev, enum hl_reset_type reset_type)
+{
+
+	struct hl_reset_driver_data *data = DEV_DATA_LOCAL(dev);
+
+	if (data->security == NULL)
+		return;
+
+	switch (reset_type) {
+	case HL_RESET_TYPE_SOFT_RST:
+		hl_security_misc_cfg(data->security, HL_SECURITY_MISC_CFG_PRE_SOFT_RESET);
+		break;
+	default:
+		LOG_ERR("Security cfg not supported for rst type %s\n",
+			reset_type_to_str(reset_type));
+	}
+
+}
+
