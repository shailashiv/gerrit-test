+#define mmD0_NIC_ROM_TABLE_BASE	0x9000000ull
+
+static void hl_dev_soft_reset_sec_rr_cfg(const struct device *dev, bool restore)
+{
+	uint64_t min, max;
+	struct hl_security_rr_engine_select rr_sel;
+
+	memset(&rr_sel, 0, sizeof(struct hl_security_rr_engine_select));
+
+	rr_sel.noc = 1;
+	rr_sel.pcie = HL_SECURITY_PCIE_ELBI_RR | HL_SECURITY_PCIE_MSTR_RR | HL_SECURITY_PCIE_LBW_RR;
+
+	if (!restore) {
+		/* TODO: Short RR usage can be optimized to 3 RRs using mask and range */
+		/* LBW SPACE: 0x0300007FE0000000 - 0x0300007FFFFFFFFF */
+		/* Block access to whole LBW space except NIC CFG, NIC DBG and VUART Regs */
+
+		/*
+		 * Start - 0x0300007FE0000000
+		 * End - 0x300007FF80BFFFF
+		 */
+		min = LBW_BASE;
+		max = HL_CFG_BASE_FULL + mmD0_NCH_ATB_FUNNEL2_BASE - 1;
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_0, min, max,
+				 rr_sel, true, HL_SEC_RD_WR_PROT);
+
+		/*
+		 * Start - 0x0300007FE80D3000
+		 * End - 0x0300007FF88BFFFF
+		 */
+		min = HL_CFG_BASE_FULL + mmD0_NCHL_ATB_FUNNEL2_BASE +
+					D0_NCHL_ATB_FUNNEL2_MAX_OFFSET;
+		max = HL_CFG_BASE_FULL + mmD1_NCH_ATB_FUNNEL2_BASE - 1;
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_1, min, max,
+				 rr_sel, true, HL_SEC_RD_WR_PROT);
+
+		/*
+		 * Start - 0x0300007FF88D3000
+		 * End - 0x0300007FF8FFFFFF
+		 */
+		min = HL_CFG_BASE_FULL + mmD1_NCHL_ATB_FUNNEL2_BASE +
+					 D1_NCHL_ATB_FUNNEL2_MAX_OFFSET;
+		max = HL_CFG_BASE_FULL + mmD0_NIC_ROM_TABLE_BASE - 1;
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_2, min, max,
+				 rr_sel, true, HL_SEC_RD_WR_PROT);
+
+		/*
+		 * Start - 0x300007FF96A0400
+		 * End - 0x0300007FFC0BFFFF
+		 */
+		min = HL_CFG_BASE_FULL + mmD1_NIC5_ARC_RTT_BASE +
+					 D1_NIC5_ARC_RTT_MAX_OFFSET;
+		max = HL_CFG_BASE_FULL + mmD0_NIC01_GECOE_BASE - 1;
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_8, min, max,
+				 rr_sel, true, HL_SEC_RD_WR_PROT);
+
+	} else {
+		min = 0;
+		max = 0;
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_0, min, max,
+				 rr_sel, false, HL_SEC_RD_WR_PROT);
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_1, min, max,
+				 rr_sel, false, HL_SEC_RD_WR_PROT);
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_2, min, max,
+				 rr_sel, false, HL_SEC_RD_WR_PROT);
+		hl_secure_lbw_rr(dev, HL_SEC_LBW_RR_SHORT_8, min, max,
+				 rr_sel, false, HL_SEC_RD_WR_PROT);
+	}
+}
+
+static const uint32_t bit_map_nic_lo[ISEC_NIC_RANGE_TYPE_ARR_SIZE] = { 0xffffffff, 0x000602ff };
+static const uint32_t bit_map_nic_hi[ISEC_NIC_RANGE_TYPE_ARR_SIZE] = { 0xdfffffff, 0x00000000 };
+
+static const uint32_t bit_map_gen_lo_pcie[ISEC_GEN_RANGE_TYPE_ARR_SIZE] = {
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000006, 0x00000000, 0x00000000,
+			0x00000000, 0x00000080, 0x00000000, 0x00000000,
+			0x00000000 };
+static const uint32_t bit_map_gen_lo_elbi[ISEC_GEN_RANGE_TYPE_ARR_SIZE] = {
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000006, 0x00000000, 0x00000000,
+			0x00000000, 0x00000090, 0x00000000, 0x00000000,
+			0x00000000 };
+static const uint32_t bit_map_gen_hi_pcie[ISEC_GEN_RANGE_TYPE_ARR_SIZE] = {
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000008, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000 };
+static const uint32_t bit_map_gen_hi_elbi[ISEC_GEN_RANGE_TYPE_ARR_SIZE] = {
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000 };
+static const uint32_t bit_map_hd_lo[ISEC_HD_RANGE_TYPE_ARR_SIZE] = {
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000 };
+static const uint32_t bit_map_hd_hi[ISEC_HD_RANGE_TYPE_ARR_SIZE] = {
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000 };
+
+static const struct hl_isec_data isec_nic_range_data = {
+	.isec_bitmap_lo = bit_map_nic_lo,
+	.isec_bitmap_hi = bit_map_nic_hi,
+};
+
+static const struct hl_isec_data isec_hd_range_data = {
+	.isec_bitmap_lo = bit_map_hd_lo,
+	.isec_bitmap_hi = bit_map_hd_hi,
+};
+
+static const struct hl_isec_data isec_gen_range_data_pcie = {
+	.isec_bitmap_lo = bit_map_gen_lo_pcie,
+	.isec_bitmap_hi = bit_map_gen_hi_pcie,
+};
+
+static const struct hl_isec_data isec_gen_range_data_elbi = {
+	.isec_bitmap_lo = bit_map_gen_lo_elbi,
+	.isec_bitmap_hi = bit_map_gen_hi_elbi,
+};
+
+static const struct hl_isec_cfg pre_soft_reset_isec_config[] = {
+	{{ HL_BLOCK_TYPE_PCIE, 0xfc414000, 1, 0, 0x000000, 0x0 },
+	  .gen_range_data = &isec_gen_range_data_elbi,
+	  .hd_range_data = &isec_hd_range_data,
+	  .nic_range_data = &isec_nic_range_data,
+	},
+	{{ HL_BLOCK_TYPE_PCIE, 0xfc415000, 1, 0, 0x000000, 0x0 },
+	  .gen_range_data = &isec_gen_range_data_pcie,
+	  .hd_range_data = &isec_hd_range_data,
+	  .nic_range_data = &isec_nic_range_data,
+	},
+};
+
+static const uint32_t gaudi3_soft_reset_protbitis_data1[] = {0x800};
+
+static const struct hl_prot_bits_cfg gaudi3_soft_reset_prot_bits[] = {
+
+	{{ HL_BLOCK_TYPE_PSOC, 0xfc4e3000, 1, 0, 0, 0x000000, 0x0000, 0x0 }, \
+	  .prot_map = 0x00000000, \
+	  .data_map = 0x10, \
+	  .data = gaudi3_soft_reset_protbitis_data1, \
+	  .data_size = ARRAY_SIZE(gaudi3_soft_reset_protbitis_data1), \
+	}
+};
+
+static int soft_reset_pre_sec_cfg(const struct device *dev)
+{
+	bool is_sec_enabled;
+
+	is_sec_enabled = hl_dev_security_get_status(dev);
+	if (is_sec_enabled) {
+
+		/*
+		 * As in soft reset engines are halted, so only
+		 * Blocking all cfg range except pcie_aux(vuart), nic in pcie isec
+		 * Blocking all cfg range except pcie_core(telem),
+		 * pcie_aux(vuart), nic in elbi isec
+		 */
+		hl_dev_security_configure_isec(dev, HL_RESET_SRC_SOFT_RST,
+					       pre_soft_reset_isec_config,
+					       ARRAY_SIZE(pre_soft_reset_isec_config));
+		/* pre sec prot bits to open only EQ_RD_OFFS in D0_PARC_ARC1_CFG */
+		hl_dev_prot_bits_init(dev, gaudi3_soft_reset_prot_bits, HL_RESET_SRC_SOFT_RST,
+						ARRAY_SIZE(gaudi3_soft_reset_prot_bits));
+		hl_dev_soft_reset_sec_rr_cfg(dev, false);
+	}
+	return 0;
+}
+
 static int soft_reset_post_sec_cfg(const struct device *dev)
 {
 	hl_set_sm_priv_level(dev);
 
 	if (hl_dev_security_get_status(dev) != HL_SEC_ST_DISABLED) {
 		hl_set_engine_priv_level(dev);
-		hl_dev_security_configure_isec(dev, HL_RESET_SRC_SOFT_RST);
+		hl_dev_security_configure_isec(dev, HL_RESET_SRC_SOFT_RST,
+					       isec_info, ARRAY_SIZE(isec_info));
 		hl_dev_prot_bits_init(dev, gaudi3_os_prot_bits_cfg, HL_RESET_SRC_SOFT_RST,
 						ARRAY_SIZE(gaudi3_os_prot_bits_cfg));
-		LOG_INF("Protection bits and ISEC re-init done");
+		hl_dev_soft_reset_sec_rr_cfg(dev, true);
+		LOG_INF("Protection bits, RRs and ISEC re-init done");
 	}
 
 	return 0;
@@ -932,6 +1111,9 @@
 	int ret = 0;
 
 	switch (cfg_type) {
+	case HL_SECURITY_MISC_CFG_PRE_SOFT_RESET:
+		ret = soft_reset_pre_sec_cfg(dev);
+		break;
 	case HL_SECURITY_MISC_CFG_POST_SOFT_RESET:
 		ret = soft_reset_post_sec_cfg(dev);
 		break;
