+ConstantInformation::scaleInput_t ConstantInformation::get_scale_input_key(
+    float value,
+    size_t index) {
+  float scaleinput_v = value + index;
+  PT_BRIDGE_DEBUG("Scale input value:", scaleinput_v);
+  return ConstantInformation::scaleInput_t(scaleinput_v);
+}
+
+void ConstantInformation::InsertRecipeScaleConst(
+    key_t recipe_key,
+    float const_value,
+    size_t input_idx,
+    id_t const_id) {
+  std::unique_lock lock(checksum_map_mtx_);
+  auto recipe_iterator = recipe_scale_constant_map_.find(recipe_key);
+  scaleInput_t scale_input = get_scale_input_key(const_value, input_idx);
+  if (recipe_iterator == recipe_scale_constant_map_.end()) {
+    auto recipe_value =
+        std::unordered_map<scaleInput_t, std::unordered_set<id_t>>{
+            {scale_input, std::unordered_set<id_t>{const_id}}};
+    recipe_scale_constant_map_.emplace(recipe_key, recipe_value);
+  } else {
+    auto recipe_input_iter = recipe_iterator->second.find(scale_input);
+    if (recipe_input_iter == recipe_iterator->second.end()) {
+      recipe_iterator->second.emplace(
+          scale_input, std::unordered_set<id_t>{const_id});
+    } else {
+      auto& const_id_set = recipe_input_iter->second;
+      if (const_id_set.find(const_id) == const_id_set.end()) {
+        const_id_set.insert(const_id);
+      } else {
+        PT_BRIDGE_DEBUG(
+            "Recipe ",
+            recipe_key,
+            " already contain input value:",
+            const_value,
+            " with index ",
+            input_idx,
+            " and constant id:",
+            const_id);
+      }
+    }
+  }
+}
+
+void ConstantInformation::CheckAndAddScaleConstIdForRecipe(
+    key_t recipe_key,
+    at::Tensor pt_tensor,
+    size_t input_idx,
+    id_t const_id) {
+  float const_value = pt_tensor.item<float>();
+  scaleInput_t scale_input = get_scale_input_key(const_value, input_idx);
+  std::unique_lock lock(checksum_map_mtx_);
+  auto recipe_iterator = recipe_scale_constant_map_.find(recipe_key);
+  auto recipe_input_iter = recipe_iterator->second.find(scale_input);
+  auto const_id_set = recipe_input_iter->second;
+  HABANA_ASSERT(
+      const_id_set.size(),
+      "Const id list in empty for recipe ",
+      recipe_key,
+      " recipe_key ",
+      recipe_key,
+      " input_idx ",
+      input_idx);
+  if (const_id_set.find(const_id) == const_id_set.end()) {
+    auto first_const_id = *(const_id_set.begin());
+    auto const_checksum_iterator = const_checksum_map_.find(first_const_id);
+    HABANA_ASSERT(
+        const_checksum_iterator != const_checksum_map_.end(),
+        "Const id  {} not presented in const_checksum_map_",
+        first_const_id)
+
+    // auto checksum_if_exists = GetDeviceChecksum(first_const_id);
+    auto tmeta = get_tensor_extra_meta(pt_tensor);
+    // TODO what is the constant id for the specific recipe
+    for (auto& info : const_checksum_iterator->second.infos_) {
+      for (auto& key : info.recipe_key_) {
+        if (key == recipe_key) {
+          checksum_t checksum{info.checksum_};
+          uint64_t section_size = info.section_size_;
+          Insert(const_id, checksum);
+          PushInfo(const_id, checksum, recipe_key, section_size);
+          at::DataPtr data =
+              pt_tensor.storage().allocator()->allocate(section_size);
+          auto old_data_ptr = pt_tensor.storage().set_data_ptr(std::move(data));
+          pt_tensor.storage().set_nbytes(section_size);
+          HABANA_ASSERT(
+              tmeta->get_host_size() == section_size,
+              "Section size ",
+              section_size,
+              " and host ptr size ",
+              tmeta->get_host_size(),
+              " differ");
+          std::atomic<bool> copyDone{false};
+          HPUDeviceContext::copy_data_to_device(
+              tmeta->get_host_ptr(),
+              reinterpret_cast<synapse_helpers::device_ptr>(
+                  pt_tensor.data_ptr()),
+              reinterpret_cast<synapse_helpers::device_ptr>(
+                  pt_tensor.storage().data_ptr().get()),
+              section_size,
+              [&copyDone]() { copyDone = true; },
+              false,
+              true);
+          // wait for copy completion
+          while (!copyDone) {
+            std::this_thread::yield();
+          }
+          // if (checksum_if_exists.has_value() and
+          //     checksum_if_exists.value() != checksum) {
+          //   PT_BRIDGE_DEBUG(
+          //       "For const_id: ",
+          //       const_id,
+          //       " Checksum has valid value for another recipe");
+          //   StorePrevDataPtrImpl(
+          //       const_id, std::move(old_data_ptr),
+          //       checksum_if_exists.value());
+          // }
+          return;
+        }
+      }
+    }
+    HABANA_ASSERT(
+        false,
+        "Recipe ",
+        recipe_key,
+        " not found for const id ",
+        first_const_id,
+        " current const id:",
+        const_id);
+  }
+}
