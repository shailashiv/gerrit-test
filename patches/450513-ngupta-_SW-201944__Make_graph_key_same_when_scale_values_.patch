+struct RecipeConstHash {
+  template <typename T1, typename T2>
+  std::size_t operator()(const std::tuple<T1, T2>& x) const {
+    auto const_value_hash = std::hash<T1>()(std::get<0>(x));
+    auto const_index_hash = std::hash<T2>()(std::get<1>(x));
+    return const_value_hash ^ const_index_hash;
+  }
+};
