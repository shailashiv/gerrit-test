+
+# Create a new DataFrame with transformed values
+def transform_cell(cell, p50, std):
+     # Convert std to a float (if it's a string)
+    try:
+        std = float(std)
+    except ValueError:
+        raise ValueError(f"Invalid std value: {std}")
+    # Check if std is 0
+    if std == 0:
+        return 0  # Replace with 0 if std is 0
+    else:
+        print("cell", cell)
+        print("p50", p50)
+        print("std", std)
+        return ((cell - p50) / std)
+
+def transform_cell1(cell, p50, std):
+     # Convert std to a float (if it's a string)
+    try:
+        std = float(std)
+    except ValueError:
+        raise ValueError(f"Invalid std value: {std}")
+    # Check if std is 0
+    data = ((cell - p50) / std) if (cell > p50) else 0
+    print("cell max", cell)
+    print("p50 max", p50)
+    print("std max", std)
+    if cell < -7:
+        if cell < -8:
+            return 0  # Replace with 0 if std is 0
+        else:
+            return 0.1 * data
+    else:
+    	
+        return data
+        
+# Function to find outliers based on IQR
+def find_outliers(data):
+    Q1 = np.percentile(data, 25)
+    Q3 = np.percentile(data, 75)
+    IQR = Q3 - Q1
+    lower_fence = Q1 - 1.5 * IQR
+    upper_fence = Q3 + 1.5 * IQR
+    outliers = data[(data < lower_fence) | (data > upper_fence)]
+    return outliers
+
+# Get the output_path from the command line arguments
+if len(sys.argv) < 2:
+    print("Usage: python DB_analyze.py <test_path> <output_path>")
+    sys.exit(1)
+
+output_path = sys.argv[1]
+
+# Construct the full path to the CSV file in the output folder
+csv_file_path = os.path.join(output_path, 'ALL_G3_pre_FEC_SER_int_data.csv')
+csv_file_path_max = os.path.join(output_path, 'ALL_G3_max_pre_FEC_SER_int_data.csv')
+
+# Load data
+df = pd.read_csv(csv_file_path)
+df_max = pd.read_csv(csv_file_path_max)
+#df = pd.read_csv('ALL_G3_pre_FEC_SER_int_data.csv')
+#df_max = pd.read_csv('ALL_G3_max_pre_FEC_SER_int_data.csv')
+# Ensure numeric conversion for required columns
+numeric_columns = ["ave", "P95", "P75", "P50"]
+df[numeric_columns] = df[numeric_columns].apply(pd.to_numeric, errors='coerce').fillna(0)
+df_max[numeric_columns] = df_max[numeric_columns].apply(pd.to_numeric, errors='coerce').fillna(0)
+
+
+# =======================================
+# Arranging different data-frames
+#	1. sort by ave (performance )
+#	2. sort by card and port (logical)
+#	3. Change the data frame for box and whiskler
+# =======================================
+# Sort the DataFrame
+df_sorted = df.sort_values(
+    by=[df.columns[0], "ave"],
+    key=lambda col: col.str.lower() if col.dtypes == "object" else col
+)
+df_max_sorted = df_max.sort_values(
+    by=[df_max.columns[0], "ave"],
+    key=lambda col: col.str.lower() if col.dtypes == "object" else col
+)
+
+df_logical = df.sort_values(by=["card", "port"], ascending=False)
+df_max_logical = df_max.sort_values(by=["card", "port"], ascending=False)
+
+
+# Create the x-axis labels
+df_sorted["x_labels"] = df_sorted[df.columns[0]].astype(str) + "_" + \
+                        df_sorted[df.columns[1]].astype(str) + "-" + \
+                        df_sorted[df.columns[2]].astype(str)
+
+# Create the x-axis labels
+df_max_sorted["x_labels"] = df_max_sorted[df.columns[0]].astype(str) + "_" + \
+                            df_max_sorted[df.columns[1]].astype(str) + "-" + \
+                            df_max_sorted[df.columns[2]].astype(str)
+
+# Melt the DataFrame: Keep "card" and "port" as identifiers, convert server columns into one column
+# Identify server columns (starting with "g3-")
+server_columns = [col for col in df.columns if col.startswith("g3-")]
+
+# Melt the DataFrame correctly, keeping 'Type' for classification
+melted_df = df.melt(id_vars=["Type"], value_vars=server_columns, var_name="server", value_name="SER")
+
+# Remove rows where SER == 0
+melted_df = melted_df[melted_df["SER"] != 0]
+# =============================================================================
+
+
+# =======================================
+# 1st Plot average SER in ascending maner split per Port Type (Ext,Int,Xbar) 
+# Create a 2x2 grid of subplots
+# =======================================
+fig, axs = plt.subplots(2, 1)  # 2 rows and 2 columns
+fig.set_size_inches(12, 6)
+
+axs[0].plot(df_sorted["x_labels"], df_sorted["ave"], label="ave", marker="o")
+axs[0].plot(df_sorted["x_labels"], df_sorted["P50"], label="P50", marker="s")
+axs[0].plot(df_sorted["x_labels"], df_sorted["P75"], label="P75", marker="^")
+axs[0].plot(df_sorted["x_labels"], df_sorted["P95"], label="P95", marker="x")
+# Adjust x-axis to range -1 to 192
+axs[0].set_xlim(-1, 192)
+# Formatting
+axs[0].set_xticks(range(len(df_sorted["x_labels"])))  # Set positions
+axs[0].set_xticklabels(df_sorted["x_labels"], rotation=90, ha='right', fontsize=8)
+axs[0].set_xlabel("Concatenated Columns (Type Card-Port)")
+axs[0].set_ylabel("Pre_FEC SER")
+axs[0].set_title("Comparison of ave, P50, P75, and P95")
+axs[0].legend()
+axs[0].set_yticks(np.arange(min(df_sorted["ave"].min(), df_max_sorted["ave"].min()), 
+                             max(df_sorted["P95"].max(), df_max_sorted["P95"].max()) + 1, 1))
+
+axs[0].grid(True)
+# Second subplot (df_max_sorted)
+axs[1].plot(df_max_sorted["x_labels"], df_max_sorted["ave"], label="ave", marker="o")
+axs[1].plot(df_max_sorted["x_labels"], df_max_sorted["P50"], label="P50", marker="s")
+axs[1].plot(df_max_sorted["x_labels"], df_max_sorted["P75"], label="P75", marker="^")
+axs[1].plot(df_max_sorted["x_labels"], df_max_sorted["P95"], label="P95", marker="x")
+# Formatting
+axs[1].set_xlim(-1, 192)
+axs[1].set_xticks(range(len(df_max_sorted["x_labels"])))  # Set positions
+axs[1].set_xticklabels(df_max_sorted["x_labels"], rotation=90, ha='right', fontsize=8)
+axs[1].set_xlabel("Concatenated Columns (Type Card-Port)")
+axs[1].set_ylabel("Max Pre FEC SER")
+axs[1].set_title("Comparison of ave, P50, P75, and P95")
+axs[1].legend()
