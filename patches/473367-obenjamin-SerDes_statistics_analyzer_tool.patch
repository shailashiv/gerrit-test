+
+# Table data extracted from the image (assuming it's in the same order as shown)
+table_data=("Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Internal" "Internal" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Xbar" "Xbar" "Xbar" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Internal" "Xbar" "Xbar" "External" "External" "Xbar" "Xbar" "Xbar" "External" "Xbar" "Xbar" "Internal" "Internal")
+
+# Function to calculate log10 using awk
+log10() {
+    awk -v val="$1" 'BEGIN {if (val > 0) print log(val)/log(10); else print "0"}'
+}
+
+# Function to calculate median using awk
+median() {
+    sort -n | awk '
+    {
+        count[NR] = $1
+    }
+    END {
+        if (NR % 2) {
+            print count[(NR + 1) / 2]
+        } else {
+            print (count[(NR / 2)] + count[(NR / 2) + 1]) / 2
+        }
+    }'
+}
+
+percentile() {
+    sort -n | awk -v p="$1" '
+    BEGIN {ORS=" "}
+    {
+        a[NR] = $1
+    }
+    END {
+        if (NR == 0) print "0"
+        else {
+            idx = int(NR * p / 100 + 0.5);
+            if (idx < 1) idx = 1;  # Ensure index is at least 1
+            print a[idx];
+        }
+    }'
+}
+
+# Function to process a single card-port combination
+process_card_port() {
+    local card=$1
+    local port=$2
+    local row_num=$3
+    local start_time=$(date +%s)
+    index=$((card * 24 + port))
+    # Start building the line with card and port
+    #local line="$card,$port,"
+    # Initialize line with table data, card, and port
+    local line="${table_data[$index]},$card,$port,"
+
+
+    # Initialize sum and count for average calculation
+    local sum_log_pre_fec_ser_int=0
+    local count_log_pre_fec_ser_int=0
+    local sum_log_pre_fec_ser_int_sq=0
+    local log_pre_fec_ser_int_values=()
+    local max_log_pre_fec_ser_int=-99999
+
+    for file in "$directory"/*; do
+        # Skip directories
+        [ -d "$file" ] && continue
+
+        # Extract pre_FEC_SER_int data
+        #pre_fec_ser_int=$(grep -ai "^$card,$port" "$file" | awk -F, 'NR==1 {print $27}')
+        pre_fec_ser_int=$(grep -ai "^$card,$port" "$file" | awk -F, -v col="$row_num" 'NR==1 {print $col}')
+
+        
+        # Replace 0e-0 with 1e-12 if found
+        if [ "$pre_fec_ser_int" == "0e-0" ]; then
+            pre_fec_ser_int="1e-12"
+        fi
+        
+       # ***
+        if [ -z "$pre_fec_ser_int" ]; then
+            pre_fec_ser_int="1"
+            #count_log_pre_fec_ser_int=$((count_log_pre_fec_ser_int - 1))
+            # Calculate log10 of pre_fec_ser_int
+            log_pre_fec_ser_int=$(log10 $pre_fec_ser_int)
+        else
+            # Calculate log10 of pre_fec_ser_int
+            log_pre_fec_ser_int=$(log10 $pre_fec_ser_int)
+            # Update max_log_pre_fec_ser_int
+            if (( $(echo "$log_pre_fec_ser_int > $max_log_pre_fec_ser_int" | bc -l) )); then
+                max_log_pre_fec_ser_int=$log_pre_fec_ser_int
+            fi
+            # Accumulate sum and count for average calculation
+            sum_log_pre_fec_ser_int=$(awk "BEGIN {print $sum_log_pre_fec_ser_int + $log_pre_fec_ser_int}")
+            sum_log_pre_fec_ser_int_sq=$(awk "BEGIN {print $sum_log_pre_fec_ser_int_sq + ($log_pre_fec_ser_int * $log_pre_fec_ser_int)}")
+
+            count_log_pre_fec_ser_int=$((count_log_pre_fec_ser_int + 1))
+            # Collect log_pre_fec_ser_int for median calculation
+            log_pre_fec_ser_int_values+=("$log_pre_fec_ser_int")
+        fi
+        
+        
+        # Append log_pre_fec_ser_int to the line
+        line="$line$log_pre_fec_ser_int,"
+    done
+
+    # Calculate average log_pre_fec_ser_int if count is not zero
+    if [ $count_log_pre_fec_ser_int -ne 0 ]; then
+        average_log_pre_fec_ser_int=$(awk "BEGIN {print $sum_log_pre_fec_ser_int / $count_log_pre_fec_ser_int}")
+        variance_log_pre_fec_ser_int=$(awk "BEGIN {print ($sum_log_pre_fec_ser_int_sq / $count_log_pre_fec_ser_int) - ($average_log_pre_fec_ser_int * $average_log_pre_fec_ser_int)}")
+        stdev_log_pre_fec_ser_int=$(awk "BEGIN {print sqrt($variance_log_pre_fec_ser_int)}")
+        
+        # Calculate median log_pre_fec_ser_int
+        median_log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | median)
+        
+        # Calculate percentiles log_pre_fec_ser_int
+        P5log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 5)
+        P15log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 15)
+        P25log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 25)
+        P35log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 35)
+        P65log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 65)
+        P75log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 75)
+        P85log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 85)
+        P95log_pre_fec_ser_int=$(echo "${log_pre_fec_ser_int_values[@]}" | tr ' ' '\n' | percentile 95)
+    else
+        average_log_pre_fec_ser_int=0
+        stdev_log_pre_fec_ser_int=0
+        median_log_pre_fec_ser_int=0
+        max_log_pre_fec_ser_int=0
+        P5log_pre_fec_ser_int=0
+        P15log_pre_fec_ser_int=0
+        P25log_pre_fec_ser_int=0
+        P35log_pre_fec_ser_int=0
+        P55log_pre_fec_ser_int=0
+        P65log_pre_fec_ser_int=0
+        P75log_pre_fec_ser_int=0
+        P85log_pre_fec_ser_int=0
+        P95log_pre_fec_ser_int=0
+    fi
+
+    # Remove the trailing comma and append the line and average to the output file
+    # Set output file name based on row_num
+    local output_file_name
+#    if [[ $row_num -eq 27 ]]; then
+#        output_file_name="$output_file"
+#    else
+#        output_file_name="$output_maxfile"
+#    fi
+    case $row_num in
+        27) output_file_name="$output_file" ;;
+        28) output_file_name="$output_maxfile" ;;
+        29) output_file_name="$output_postfile" ;;
+    esac
+
+    
+    echo "${line%,},,$count_log_pre_fec_ser_int,, $average_log_pre_fec_ser_int,$stdev_log_pre_fec_ser_int, $P5log_pre_fec_ser_int, $P15log_pre_fec_ser_int, $P25log_pre_fec_ser_int,$P35log_pre_fec_ser_int,$median_log_pre_fec_ser_int,$P65log_pre_fec_ser_int,$P75log_pre_fec_ser_int,$P85log_pre_fec_ser_int,$P95log_pre_fec_ser_int, $max_log_pre_fec_ser_int" >> "$output_file_name"
+
+    local end_time=$(date +%s)
+    local elapsed_time=$((end_time - start_time))
+
+    # Print elapsed time
+    #echo -ne "\nProcessing completed for card $card, port $port. time: $elapsed_time."
+}
+
+# Generate the title row with all filenames from the directory
+title_row="Type,card,port,"
+for file in "$directory"/*; do
+    # Skip directories
+    [ -d "$file" ] && continue
+    title_row="$title_row$(basename "$file"),"
+done
+
+echo "${title_row%,},,Number_of_files,stats:,ave,std,P5,P15,P25,P35,P50,P65,P75,P85,P95,max" > "$output_file"
+echo "${title_row%,},,Number_of_files,stats:,ave,std,P5,P15,P25,P35,P50,P65,P75,P85,P95,max" > "$output_maxfile"
+
+# Check if card and port are provided as arguments
+if [ "$#" -eq 4 ]; then
+    # User-specified card and port
+    card=$3
+    port=$4
+
+    # Validate card and port
+    if ! [[ "$card" =~ ^[0-7]$ ]]; then
+        echo "Error: Card must be a number between 0 and 7."
+        exit 1
+    fi
+
+    if ! [[ "$port" =~ ^[0-9]{2}$ ]] || [ "$port" -lt 0 ] || [ "$port" -gt 23 ]; then
+        echo "Error: Port must be a number between 00 and 23."
+        exit 1
+    fi
+
+    # Process specific card and port
+    process_card_port $card $port 27
+    exit 0
+fi
+
+# Processing all cards and ports in parallel
+i=0
+total=192
+
+for card in {0..7}; do
+    for port in {0..23}; do
+        process_card_port $card $port 27 &
+    done
+done
+
+for card in {0..7}; do
+    for port in {0..23}; do
+        process_card_port $card $port 28 &
+    done
+done
+
+for card in {0..7}; do
+    for port in {0..23}; do
+        process_card_port $card $port 29 &
+    done
+done
+
+# Wait for all background processes to finish
+wait
+
+echo -ne "\nAll processing completed. Results saved to $output_file & $output_maxfile.\n"
+exit 0
