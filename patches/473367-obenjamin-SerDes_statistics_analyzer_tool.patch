+    local total="$2"
+
+    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
+        echo "$((iteration * 100 / total))"
+    elif [[ "$OSTYPE" == "darwin"* ]]; then
+        osascript -e "display notification \"Running iteration $iteration - $total...\" with title \"Loop Status\""
+    else
