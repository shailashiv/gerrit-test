+coefficients = np.polyfit(x, y, 1)
+trend_line = np.poly1d(coefficients)
+# Plot the trendline
+axs1.plot(x, trend_line(x), label='Trend Line', color='green', linestyle='-', linewidth=2)
+# Display the equation of the trend line
+slope, intercept = coefficients
+equation = f"y = {slope:.2f}x + {intercept:.2f}"
+# Add the equation as text on the plot
+axs1.text(0.05, 0.95, equation, transform=axs1.transAxes, fontsize=12, verticalalignment='top', color='green')
+plt.savefig("Average2Max_SER_fit.png")  # Save as PNG
+
+# Show the plot
+#plt.show(block=False)
+subprocess.run(["xdg-open", "Average2Max_SER_fit.png"])
+# =============================================================================
+
+
