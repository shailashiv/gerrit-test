+                             max(df_sorted["P95"].max(), df_max_sorted["P95"].max()) + 1, 1))
+
+axs[1].grid(True)
+
+plt.tight_layout(pad=2.0)
+plt.savefig("SER_statistics_FOM.png")  # Save as PNG
+
+# Show plot
+# plt.show(block=False)
+subprocess.run(["xdg-open", "SER_statistics_FOM.png"])
+# =============================================================================
+
+
+# =======================================
+# 2nd plot linear fit between pre and max
+# ======================================= 
+# Create figure and axis
+
+# Create a 2x2 grid of subplots
+fig1, axs1 = plt.subplots(1, 1)  # 2 rows and 2 columns
+# Add grid
+axs1.plot(df_sorted["ave"], df_max_sorted["ave"], label="pre_fec", marker='+', color='blue', linestyle='none')
+axs1.grid(visible=True, linestyle='--', alpha=0.7)
+axs1.set_title('Pre FEC SER ave & Max')
+axs1.legend(loc='upper right', bbox_to_anchor=(1.15, 1))
+axs1.grid(visible=True, linestyle='--', alpha=0.7)
+# Fit a linear regression line for axs1[1]
+x = df_sorted["ave"]
+y = df_max_sorted["ave"]
