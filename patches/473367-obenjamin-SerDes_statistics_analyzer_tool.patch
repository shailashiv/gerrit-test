+            #print(f"\nDEBUG: Outliers detected for {ax.get_xlabel()} {x_label}:")
+            for outlier in outliers:
+                # Find the row(s) corresponding to the outlier value
+                matching_rows = df[(df[ax.get_xlabel()] == x_label) & (df['ave'] == outlier)]
+                #for _, row in matching_rows.iterrows():
+                    #print(f"DEBUG: Outlier - Port: {row['port']}, Card: {row['card']}, ave: {outlier}")
+# ===================================
